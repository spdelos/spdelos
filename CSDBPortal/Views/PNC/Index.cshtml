@{
    ViewData["Title"] = "PNC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pnc-wrapper { padding: 1.5rem; max-width: 1200px; }

    .pnc-preview-box {
        background: var(--primary-light, #f0f4ff);
        border: 2px solid var(--border, #dee2e6);
        border-radius: 8px;
        padding: 1rem 1.5rem;
        font-family: 'Courier New', monospace;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--text, #212529);
        text-align: center;
        min-height: 3.5rem;
    }

    .pnc-segment-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--text-muted, #6c757d);
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .pnc-segment-card {
        border: 1px solid var(--border, #dee2e6);
        border-radius: 6px;
        padding: 0.65rem 0.8rem;
        background: #fff;
    }

    .pnc-segment-card.seg-valid   { border-color: #198754; box-shadow: 0 0 0 2px rgba(25,135,84,.15); }
    .pnc-segment-card.seg-invalid { border-color: #dc3545; box-shadow: 0 0 0 2px rgba(220,53,69,.15); }

    .sep-dash {
        font-size: 1.3rem; font-weight: 700;
        color: var(--text-muted, #6c757d);
        display: flex; align-items: center; justify-content: center;
        padding-top: 1.5rem;
    }

    .ref-table th { background: var(--primary-light, #f0f4ff); font-size: 0.8rem; }
    .ref-table td, .ref-table th { font-size: 0.82rem; padding: 0.28rem 0.55rem; }

    #pncListTable thead th { font-size: 0.8rem; white-space: nowrap; }
    #pncListTable tbody td { font-size: 0.82rem; }

    .pnc-code { font-family: 'Courier New', monospace; font-weight: 600; letter-spacing: 1px; }

    tr.row-obsolete td { text-decoration: line-through; color: #999; }
    tr.row-obsolete .pnc-code { color: #999; }
    tr.row-obsolete .badge-obsolete { font-size: 0.68rem; }

    .upload-zone {
        border: 2px dashed var(--border, #dee2e6);
        border-radius: 8px; padding: 1rem 1.5rem;
        text-align: center; cursor: pointer;
        transition: border-color .2s, background .2s;
    }
    .upload-zone:hover { border-color: #0d6efd; background: rgba(13,110,253,.04); }

    .filter-active-badge { font-size: 0.68rem; vertical-align: middle; margin-left: 4px; }

    /* Compact segments */
    .seg-locked-display {
        background: #e9ecef; border-radius: 4px;
        padding: 0.2rem 0.5rem; font-family: 'Courier New', monospace;
        font-weight: 700; font-size: .92rem; letter-spacing: 1px;
        min-height: 31px; display: flex; align-items: center;
    }
    select.pnc-seg { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
    .pnc-segment-card { padding: 0.5rem 0.6rem; }
    .pnc-segment-label { font-size: 0.68rem; margin-bottom: 0.15rem; white-space: nowrap; }
    .sep-dash { font-size: 1.1rem; padding-top: 1.35rem; }
</style>

<div class="pnc-wrapper">
    <div class="d-flex align-items-center mb-3 gap-2">
        <i class="fa-solid fa-barcode fa-lg text-primary"></i>
        <h4 class="mb-0 fw-semibold">Part Numbering Code (PNC)</h4>
    </div>

    <div class="alert alert-info py-2 mb-3" style="font-size:.87rem;">
        <strong>Format:</strong>
        <span class="font-monospace fw-semibold">&lt;ModelId&gt;-&lt;EqCode&gt;-&lt;ModCode&gt;-&lt;SubAsmCode&gt;-&lt;SeqDigits&gt;-&lt;MaintLevel&gt;-&lt;RevSuffix&gt;</span>
        &nbsp; Example: <span class="font-monospace fw-semibold">KAV-72-FAN-FCA-00001-D-A</span>
    </div>

    <!-- ── Live Preview ──────────────────────────────────────────────── -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold">Generated PNC</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="btnCopyPNC" disabled title="Copy to clipboard">
                        <i class="fa-regular fa-copy"></i> Copy
                    </button>
                    <button class="btn btn-sm btn-success" id="btnSavePNC" disabled>
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save PNC
                    </button>
                </div>
            </div>
            <div class="pnc-preview-box" id="pncPreview">—</div>
            <div id="pncValidMsg" class="mt-2 text-center" style="font-size:.85rem;"></div>
        </div>
    </div>

    <!-- ── Segment Inputs ───────────────────────────────────────────── -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
            <span>Build PNC Segments</span>
            <button class="btn btn-sm btn-outline-secondary" id="btnResetPNC">
                <i class="fa-solid fa-rotate-left me-1"></i> Reset
            </button>
        </div>
        <div class="card-body">
            <!-- hidden seg1 value written by the model-select modal -->
            <input type="hidden" id="seg1">

            <div class="d-flex flex-wrap gap-1 align-items-start pb-1">

                <!-- Model ID — locked after modal selection -->
                <div style="min-width:82px; max-width:110px;">
                    <div class="pnc-segment-card" id="card_seg1">
                        <div class="pnc-segment-label">Model ID</div>
                        <div class="seg-locked-display" id="seg1Display">—</div>
                        <a href="#" id="btnChangeModel" class="small text-primary d-block mt-1" style="font-size:.68rem;">Change</a>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Eq. Code -->
                <div style="min-width:90px; max-width:110px;">
                    <div class="pnc-segment-card" id="card_seg2">
                        <div class="pnc-segment-label">Eq. Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg2" style="max-width:98px;">
                            <option value="">— —</option>
                            <option value="70">70 · Std Practice</option>
                            <option value="71">71 · Power Plant</option>
                            <option value="72">72 · Engine</option>
                            <option value="73">73 · Fuel &amp; Ctrl</option>
                            <option value="74">74 · Ignition</option>
                            <option value="75">75 · Air</option>
                            <option value="76">76 · Eng Controls</option>
                            <option value="77">77 · Indicating</option>
                            <option value="78">78 · Exhaust</option>
                            <option value="79">79 · Oil</option>
                            <option value="80">80 · Starting</option>
                        </select>
                        <small class="text-muted" style="font-size:.65rem;">ATA</small>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Module Code -->
                <div style="min-width:96px; max-width:116px;">
                    <div class="pnc-segment-card" id="card_seg3">
                        <div class="pnc-segment-label">Module Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg3" style="max-width:104px;">
                            <option value="">— —</option>
                            <option value="EGN">EGN · General</option>
                            <option value="EEX">EEX · Exhaust</option>
                            <option value="LPC">LPC · LP Comp</option>
                            <option value="COU">COU · Coupler</option>
                            <option value="FAN">FAN · Fan</option>
                            <option value="ICA">ICA · Int. Casing</option>
                            <option value="HPC">HPC · HP Comp</option>
                            <option value="DCO">DCO · Combustor</option>
                            <option value="TNZ">TNZ · Trans. Zone</option>
                            <option value="HPT">HPT · HP Turbine</option>
                            <option value="LPT">LPT · LP Turbine</option>
                            <option value="TEC">TEC · Exh. Case</option>
                            <option value="MGB">MGB · Main GBox</option>
                            <option value="AGB">AGB · Acc. GBox</option>
                        </select>
                        <small class="text-muted" style="font-size:.65rem;">3-letter</small>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Sub-Asm -->
                <div style="min-width:68px; max-width:80px;">
                    <div class="pnc-segment-card" id="card_seg4">
                        <div class="pnc-segment-label">Sub-Asm</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg4" maxlength="3" placeholder="FCA" data-pattern="^[A-Z]{3}$" style="max-width:68px;">
                        <small class="text-muted" style="font-size:.65rem;">3 letters</small>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Seq. Digits + refresh -->
                <div style="min-width:104px; max-width:120px;">
                    <div class="pnc-segment-card" id="card_seg5">
                        <div class="pnc-segment-label">Seq. Digits</div>
                        <div class="input-group input-group-sm" style="max-width:112px;">
                            <input type="text" class="form-control font-monospace pnc-seg"
                                   id="seg5" maxlength="5" placeholder="00001" data-pattern="^[0-9]{5}$">
                            <button class="btn btn-outline-secondary" type="button" id="btnRefreshSeq"
                                    title="Get next available number" style="padding:0 5px;">
                                <i class="fa-solid fa-arrows-rotate" style="font-size:.65rem;"></i>
                            </button>
                        </div>
                        <small class="text-muted" style="font-size:.65rem;">5 digits</small>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Maint. Level -->
                <div style="min-width:82px; max-width:96px;">
                    <div class="pnc-segment-card" id="card_seg6">
                        <div class="pnc-segment-label">Maint. Level</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg6" style="max-width:90px;">
                            <option value="">— —</option>
                            <option value="O">O – Operator</option>
                            <option value="I">I – Interm.</option>
                            <option value="D">D – Depot</option>
                        </select>
                        <small class="text-muted" style="font-size:.65rem;">O / I / D</small>
                    </div>
                </div>

                <div class="sep-dash px-0">-</div>

                <!-- Rev. Suffix -->
                <div style="min-width:58px; max-width:70px;">
                    <div class="pnc-segment-card" id="card_seg7">
                        <div class="pnc-segment-label">Rev. Suffix</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg7" maxlength="1" placeholder="A" data-pattern="^[A-Z]$" style="max-width:58px;">
                        <small class="text-muted" style="font-size:.65rem;">A – Z</small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ── Action toolbar ───────────────────────────────────────────── -->
    <div class="d-flex flex-wrap gap-2 mb-2">
        <button class="btn btn-outline-primary btn-sm" id="btnShowPNCs">
            <i class="fa-solid fa-table-list me-1"></i> Show Part Numbers
            <span id="filterBadge" class="badge bg-primary filter-active-badge d-none">Filtered</span>
        </button>
        <a class="btn btn-outline-success btn-sm" href="/PNC/DownloadTemplate">
            <i class="fa-solid fa-file-excel me-1"></i> Download Template
        </a>
        <label class="btn btn-outline-secondary btn-sm mb-0" for="excelFileInput">
            <i class="fa-solid fa-upload me-1"></i> Upload Excel
        </label>
        <input type="file" id="excelFileInput" accept=".xlsx" class="d-none">
    </div>
    <p class="text-muted mb-3" style="font-size:.78rem;">
        <i class="fa-solid fa-circle-info me-1"></i>
        Excel upload must follow the <strong>Download Template</strong> format (columns: ModelId, EqCode, ModCode, SubAsmCode, SeqDigits, MaintLevel, RevSuffix).
        Files with missing or extra columns will be rejected as incompatible.
    </p>

    <!-- ── Upload result ────────────────────────────────────────────── -->
    <div id="uploadResult" class="alert d-none mb-3" role="alert"></div>

    <!-- ── PNC List ─────────────────────────────────────────────────── -->
    <div id="pncListWrap" class="d-none">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="fw-semibold">
                        Part Numbers
                        <span id="pncCount" class="badge bg-secondary ms-1">0</span>
                    </span>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Show obsolete toggle -->
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkShowObsolete" checked>
                            <label class="form-check-label small" for="chkShowObsolete">Show obsolete</label>
                        </div>
                        <!-- Download filtered -->
                        <button class="btn btn-sm btn-outline-success" id="btnDownloadFiltered">
                            <i class="fa-solid fa-file-arrow-down me-1"></i> Download
                        </button>
                    </div>
                </div>
                <div id="pncFilterDesc" class="text-muted small mt-1"></div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover mb-0" id="pncListTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>ModelId</th>
                                <th>EqCode</th>
                                <th>ModCode</th>
                                <th>SubAsmCode</th>
                                <th>SeqDigits</th>
                                <th>Level</th>
                                <th>Rev</th>
                                <th>Full PNC</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created On</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="pncTbody">
                            <tr><td colspan="13" class="text-center text-muted py-3">No data loaded.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Reference Tables ─────────────────────────────────────────── -->
    <div class="row g-3 mt-1">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Equipment Codes (ATA)</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead><tr><th>Code</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">70</td><td>Standard Practices</td></tr>
                            <tr><td class="font-monospace fw-semibold">71</td><td>Power Plant</td></tr>
                            <tr><td class="font-monospace fw-semibold">72</td><td>Engine</td></tr>
                            <tr><td class="font-monospace fw-semibold">73</td><td>Engine Fuel and Control</td></tr>
                            <tr><td class="font-monospace fw-semibold">74</td><td>Ignition</td></tr>
                            <tr><td class="font-monospace fw-semibold">75</td><td>Air General</td></tr>
                            <tr><td class="font-monospace fw-semibold">76</td><td>Engine Controls</td></tr>
                            <tr><td class="font-monospace fw-semibold">77</td><td>Engine Indicating</td></tr>
                            <tr><td class="font-monospace fw-semibold">78</td><td>Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">79</td><td>Oil</td></tr>
                            <tr><td class="font-monospace fw-semibold">80</td><td>Starting</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Module Codes</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead><tr><th>Code</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">EGN</td><td>Engine General</td></tr>
                            <tr><td class="font-monospace fw-semibold">EEX</td><td>Engine Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPC</td><td>Low Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">COU</td><td>Coupler</td></tr>
                            <tr><td class="font-monospace fw-semibold">FAN</td><td>Fan</td></tr>
                            <tr><td class="font-monospace fw-semibold">ICA</td><td>Intermediate Casing</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPC</td><td>High Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">DCO</td><td>Diffuser &amp; Combustor</td></tr>
                            <tr><td class="font-monospace fw-semibold">TNZ</td><td>Transition Zone</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPT</td><td>High Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPT</td><td>Low Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">TEC</td><td>Turbine Exhaust Case</td></tr>
                            <tr><td class="font-monospace fw-semibold">MGB</td><td>Main Gearbox</td></tr>
                            <tr><td class="font-monospace fw-semibold">AGB</td><td>Accessory Gearbox</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Model ID selection modal (shown on page load, cannot be dismissed) ── -->
<div class="modal fade" id="modelSelectModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="fa-solid fa-barcode me-1 text-primary"></i> Select Model ID</h6>
            </div>
            <div class="modal-body py-3">
                <!-- Option A: existing -->
                <div class="mb-3">
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="radio" name="modelIdChoice" id="rdExisting" value="existing" checked>
                        <label class="form-check-label fw-semibold" for="rdExisting">Select existing Model ID</label>
                    </div>
                    <select id="ddlExistingModel" class="form-select form-select-sm font-monospace ms-3" style="max-width:220px;">
                        <option value="">— loading… —</option>
                    </select>
                </div>
                <!-- Option B: new -->
                <div>
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="radio" name="modelIdChoice" id="rdNew" value="new">
                        <label class="form-check-label fw-semibold" for="rdNew">Create new Model ID</label>
                    </div>
                    <input type="text" id="txtNewModel"
                           class="form-control form-control-sm font-monospace text-uppercase ms-3"
                           style="max-width:220px;"
                           placeholder="e.g. KAV or KAV1" maxlength="5" disabled>
                    <small class="text-muted ms-3 d-block mt-1" style="font-size:.72rem;">
                        2–4 uppercase letters, optional trailing digit
                    </small>
                </div>
                <div id="modelSelectError" class="text-danger small mt-2 d-none"></div>
            </div>
            <div class="modal-footer py-2">
                <button class="btn btn-primary btn-sm" id="btnConfirmModel">
                    <i class="fa-solid fa-check me-1"></i> Proceed
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Obsolete confirm modal -->
<div class="modal fade" id="obsoleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Mark as Obsolete?</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <p class="mb-1 small">This action cannot be undone. The part number will be permanently marked obsolete:</p>
                <p class="font-monospace fw-bold" id="obsoletePncCode"></p>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-warning" id="btnConfirmObsolete">
                    <i class="fa-solid fa-ban me-1"></i>Mark Obsolete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // seg1 is now a hidden input; seg1Display is the locked div
    var nonSeg1Ids  = ['seg2','seg3','seg4','seg5','seg6','seg7'];
    var allSegIds   = ['seg1','seg2','seg3','seg4','seg5','seg6','seg7'];
    var listVisible = false;
    var obsoleteId  = null;
    var selectedModelId = '';
    var modelModal  = null;

    // ── helpers ───────────────────────────────────────────────────────
    function escHtml(s) {
        return String(s)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function getSegVal(id) {
        var $el = $('#' + id);
        if ($el.is('input[type=hidden]') || $el.is('input[type=text]'))
            return ($el.val() || '').trim().toUpperCase();
        return ($el.val() || '').trim();
    }
    function isValidSeg(id) {
        if (id === 'seg1') return selectedModelId ? true : null;
        var $el = $('#' + id);
        var val = getSegVal(id);
        if (!val) return null;
        var pat = $el.data('pattern');
        return pat ? new RegExp(pat).test(val) : val.length > 0;
    }

    // ── MODEL ID MODAL ────────────────────────────────────────────────
    function initModelModal() {
        modelModal = new bootstrap.Modal(document.getElementById('modelSelectModal'), {
            backdrop: 'static', keyboard: false
        });

        // Load existing model IDs
        $.get('/PNC/GetModelIds').done(function(r) {
            var $ddl = $('#ddlExistingModel');
            $ddl.empty();
            if (r.success && r.data && r.data.length) {
                $ddl.append('<option value="">— select —</option>');
                $.each(r.data, function(_, m) {
                    $ddl.append('<option value="' + escHtml(m) + '">' + escHtml(m) + '</option>');
                });
            } else {
                // No existing IDs (empty DB or table not yet created) — force New mode
                $ddl.append('<option value="">(none yet)</option>');
                $('#rdExisting').prop('disabled', true);
                $('#rdNew').prop('checked', true).trigger('change');
            }
        }).fail(function() {
            // Network/server error — fall through to Create New
            $('#ddlExistingModel').html('<option value="">(unavailable)</option>');
            $('#rdExisting').prop('disabled', true);
            $('#rdNew').prop('checked', true).trigger('change');
        });

        // Radio toggle
        $('input[name="modelIdChoice"]').on('change', function() {
            var isNew = $('#rdNew').is(':checked');
            $('#ddlExistingModel').prop('disabled', isNew);
            $('#txtNewModel').prop('disabled', !isNew);
            if (!isNew) $('#txtNewModel').val('');
            $('#modelSelectError').addClass('d-none').text('');
        });

        // Auto-uppercase new model input
        $('#txtNewModel').on('input', function() {
            var pos = this.selectionStart;
            $(this).val($(this).val().toUpperCase());
            try { this.setSelectionRange(pos, pos); } catch(e) {}
        });

        // Proceed button
        $('#btnConfirmModel').on('click', function() {
            var mid = '';
            if ($('#rdNew').is(':checked')) {
                mid = ($('#txtNewModel').val() || '').trim().toUpperCase();
                if (!/^[A-Z]{2,4}[0-9]?$/.test(mid)) {
                    $('#modelSelectError').removeClass('d-none')
                        .text('Invalid Model ID. Use 2–4 uppercase letters with optional trailing digit (e.g. KAV, KAV1).');
                    return;
                }
            } else {
                mid = $('#ddlExistingModel').val() || '';
                if (!mid) {
                    $('#modelSelectError').removeClass('d-none').text('Please select a Model ID.');
                    return;
                }
            }
            modelModal.hide();
            activateModel(mid);
        });

        // Show on load
        modelModal.show();
    }

    // ── Change Model link ─────────────────────────────────────────────
    $('#btnChangeModel').on('click', function(e) {
        e.preventDefault();
        $('#modelSelectError').addClass('d-none').text('');
        $('#rdExisting').prop('checked', true).trigger('change');
        // Reload model list in case new ones were added
        $.get('/PNC/GetModelIds').done(function(r) {
            var $ddl = $('#ddlExistingModel');
            $ddl.empty();
            if (r.success && r.data && r.data.length) {
                $ddl.append('<option value="">— select —</option>');
                $.each(r.data, function(_, m) {
                    $ddl.append('<option value="' + escHtml(m) + '">' + escHtml(m) + '</option>');
                });
                $('#rdExisting').prop('disabled', false).prop('checked', true).trigger('change');
            } else {
                $ddl.append('<option value="">(none yet)</option>');
                $('#rdExisting').prop('disabled', true);
                $('#rdNew').prop('checked', true).trigger('change');
            }
        }).fail(function() {
            $('#ddlExistingModel').html('<option value="">(unavailable)</option>');
            $('#rdExisting').prop('disabled', true);
            $('#rdNew').prop('checked', true).trigger('change');
        });
        modelModal.show();
    });

    // ── Activate model ────────────────────────────────────────────────
    function activateModel(mid) {
        selectedModelId = mid;
        $('#seg1').val(mid);
        $('#seg1Display').text(mid);
        $('#card_seg1').addClass('seg-valid');
        fetchNextSeq();
        updatePreview();
        if (listVisible) loadPNCs();
    }

    // ── Fetch next SeqDigits ──────────────────────────────────────────
    function fetchNextSeq() {
        if (!selectedModelId) return;
        $.get('/PNC/GetNextSeqDigits', { modelId: selectedModelId }).done(function(r) {
            if (r.success) {
                $('#seg5').val(r.nextSeq);
                $('#card_seg5').removeClass('seg-invalid').addClass('seg-valid');
                updatePreview();
            }
        });
    }

    $('#btnRefreshSeq').on('click', function() {
        $(this).find('i').addClass('fa-spin');
        var self = this;
        $.get('/PNC/GetNextSeqDigits', { modelId: selectedModelId }).done(function(r) {
            if (r.success) {
                $('#seg5').val(r.nextSeq);
                updatePreview();
            }
        }).always(function() {
            setTimeout(function() { $(self).find('i').removeClass('fa-spin'); }, 400);
        });
    });

    // ── Live preview ──────────────────────────────────────────────────
    function updatePreview() {
        var parts = allSegIds.map(function(id) { return getSegVal(id); });

        // Card colouring (skip seg1 — handled by activateModel)
        nonSeg1Ids.forEach(function(id) {
            var $card = $('#card_' + id);
            $card.removeClass('seg-valid seg-invalid');
            var v = isValidSeg(id);
            if (v === true)  $card.addClass('seg-valid');
            if (v === false) $card.addClass('seg-invalid');
        });

        var filled = parts.filter(function(v) { return v !== ''; });
        if (!filled.length) {
            $('#pncPreview').text('—');
            $('#pncValidMsg').text('');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
            updateFilterBadge();
            return;
        }

        var pnc = parts.map(function(v) { return v || '?'; }).join('-');
        $('#pncPreview').text(pnc);

        var allFilled = parts.every(function(v) { return v !== ''; });
        var allValid  = allSegIds.every(function(id) { return isValidSeg(id) === true; });

        if (allFilled && allValid) {
            $('#pncValidMsg').html('<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Valid PNC.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', false);
        } else if (allFilled) {
            $('#pncValidMsg').html('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>One or more segments are invalid.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        } else {
            var rem = parts.filter(function(v) { return v === ''; }).length;
            $('#pncValidMsg').html('<span class="text-muted">' + rem + ' segment(s) remaining.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        }

        updateFilterBadge();
        if (listVisible) loadPNCs();
    }

    function updateFilterBadge() {
        var any = nonSeg1Ids.some(function(id) { return (getSegVal(id) || '') !== ''; });
        $('#filterBadge').toggleClass('d-none', !any);
    }

    // ── Segment change events (non-seg1 only) ─────────────────────────
    nonSeg1Ids.forEach(function(id) {
        $('#' + id).on('input change', function() {
            if ($(this).is('input[type=text]')) {
                var pos = this.selectionStart;
                $(this).val($(this).val().toUpperCase());
                try { this.setSelectionRange(pos, pos); } catch(e) {}
            }
            updatePreview();
        });
    });

    // ── Save PNC ──────────────────────────────────────────────────────
    $('#btnSavePNC').on('click', function() {
        var payload = {
            modelId:    selectedModelId,
            eqCode:     $('#seg2').val() || '',
            modCode:    $('#seg3').val() || '',
            subAsmCode: getSegVal('seg4'),
            seqDigits:  $('#seg5').val() || '',
            maintLevel: $('#seg6').val() || '',
            revSuffix:  getSegVal('seg7')
        };
        $('#btnSavePNC').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving…');
        $.ajax({ url: '/PNC/SavePNC', method: 'POST', contentType: 'application/json', data: JSON.stringify(payload) })
            .done(function(r) {
                if (r.success) {
                    $('#pncValidMsg').html('<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>' + escHtml(r.message) + '</span>');
                    fetchNextSeq();   // advance seq for next entry
                    if (listVisible) loadPNCs();
                } else {
                    $('#pncValidMsg').html('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>' + escHtml(r.message) + '</span>');
                }
            })
            .fail(function() { $('#pncValidMsg').html('<span class="text-danger">Server error.</span>'); })
            .always(function() { $('#btnSavePNC').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save PNC'); });
    });

    // ── Copy ──────────────────────────────────────────────────────────
    $('#btnCopyPNC').on('click', function() {
        var pnc = $('#pncPreview').text();
        if (!pnc || pnc === '—') return;
        navigator.clipboard.writeText(pnc).then(function() {
            var $b = $('#btnCopyPNC'), orig = $b.html();
            $b.html('<i class="fa-solid fa-check me-1"></i>Copied!');
            setTimeout(function() { $b.html(orig); }, 1500);
        }).catch(function() {
            var ta = document.createElement('textarea');
            ta.value = pnc; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta);
        });
    });

    // ── Reset (keeps Model ID) ────────────────────────────────────────
    $('#btnResetPNC').on('click', function() {
        nonSeg1Ids.forEach(function(id) {
            $('#' + id).val('');
            $('#card_' + id).removeClass('seg-valid seg-invalid');
        });
        $('#pncPreview').text('—');
        $('#pncValidMsg').text('');
        $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        $('#filterBadge').addClass('d-none');
        fetchNextSeq();
        if (listVisible) loadPNCs();
    });

    // ── Show Part Numbers ─────────────────────────────────────────────
    $('#btnShowPNCs').on('click', function() {
        listVisible = true;
        var $wrap = $('#pncListWrap');
        $wrap.removeClass('d-none');
        loadPNCs();
        // Scroll only after the element is definitely laid out
        setTimeout(function() {
            var off = $wrap.offset();
            if (off) $('html,body').animate({ scrollTop: off.top - 80 }, 300);
        }, 50);
    });

    $('#chkShowObsolete').on('change', function() { if (listVisible) loadPNCs(); });

    function buildFilterParams() {
        return {
            seg1: selectedModelId || undefined,
            seg2: $('#seg2').val()  || undefined,
            seg3: $('#seg3').val()  || undefined,
            seg4: getSegVal('seg4') || undefined,
            seg5: $('#seg5').val()  || undefined,
            seg6: $('#seg6').val()  || undefined,
            seg7: getSegVal('seg7') || undefined,
            includeObsolete: $('#chkShowObsolete').is(':checked')
        };
    }

    function buildFilterDesc(p) {
        var parts = [];
        if (p.seg1) parts.push('Model: ' + p.seg1);
        if (p.seg2) parts.push('Eq: '    + p.seg2);
        if (p.seg3) parts.push('Mod: '   + p.seg3);
        if (p.seg4) parts.push('Sub: '   + p.seg4);
        if (p.seg5) parts.push('Seq: '   + p.seg5);
        if (p.seg6) parts.push('Lvl: '   + p.seg6);
        if (p.seg7) parts.push('Rev: '   + p.seg7);
        var obs = p.includeObsolete ? '' : ' · Obsolete hidden';
        return parts.length ? 'Filters: ' + parts.join(', ') + obs : 'Showing all' + obs;
    }

    function loadPNCs() {
        var params = buildFilterParams();
        $('#pncFilterDesc').text(buildFilterDesc(params));
        $('#pncTbody').html('<tr><td colspan="13" class="text-center py-3">' +
            '<span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr>');

        $.get('/PNC/GetPNCs', params)
            .done(function(r) {
                var count = (r.data && r.success) ? r.data.length : 0;
                $('#pncCount').text(count);
                if (!r.success) {
                    $('#pncTbody').html(
                        '<tr><td colspan="13" class="text-center py-4 text-danger">' +
                        '<i class="fa-solid fa-triangle-exclamation me-2"></i>' +
                        '<strong>Database error</strong> — ' + escHtml(r.error || 'Unknown error') +
                        '<br><small class="text-muted">The PNC table may not exist yet. Run pending database migrations.</small>' +
                        '</td></tr>');
                    return;
                }
                if (!count) {
                    $('#pncTbody').html(
                        '<tr><td colspan="13" class="text-center py-4">' +
                        '<i class="fa-solid fa-circle-info me-2 text-muted"></i>' +
                        '<span class="text-muted fw-semibold">No Part Numbers Available</span>' +
                        '</td></tr>');
                    return;
                }
                var html = '';
                $.each(r.data, function(i, row) {
                    var obs = row.isObsolete;
                    var badge = obs
                        ? '<span class="badge bg-secondary badge-obsolete">Obsolete</span>'
                        : '<span class="badge bg-success" style="font-size:.68rem;">Active</span>';
                    var action = obs
                        ? '<span class="text-muted" title="Obsoleted by ' + escHtml(row.obsoletedBy||'') +
                          ' on ' + escHtml(row.obsoletedOn||'') + '"><i class="fa-solid fa-ban"></i></span>'
                        : '<button class="btn btn-warning btn-sm py-0 px-1 btn-mark-obsolete"' +
                          ' data-id="' + row.id + '" data-pnc="' + escHtml(row.fullPNC) + '"' +
                          ' title="Mark as Obsolete">' +
                          '<i class="fa-solid fa-ban" style="font-size:.75rem;"></i></button>';

                    html += '<tr class="' + (obs ? 'row-obsolete' : '') + '">' +
                        '<td>' + (i+1) + '</td>' +
                        '<td class="font-monospace">' + escHtml(row.modelId)    + '</td>' +
                        '<td class="font-monospace">' + escHtml(row.eqCode)     + '</td>' +
                        '<td class="font-monospace">' + escHtml(row.modCode)    + '</td>' +
                        '<td class="font-monospace">' + escHtml(row.subAsmCode) + '</td>' +
                        '<td class="font-monospace">' + escHtml(row.seqDigits)  + '</td>' +
                        '<td class="font-monospace text-center">' + escHtml(row.maintLevel) + '</td>' +
                        '<td class="font-monospace text-center">' + escHtml(row.revSuffix)  + '</td>' +
                        '<td class="pnc-code">'         + escHtml(row.fullPNC)    + '</td>' +
                        '<td class="text-center">'      + badge  + '</td>' +
                        '<td class="text-muted small">' + escHtml(row.createdBy||'') + '</td>' +
                        '<td class="text-muted small">' + escHtml(row.createdOn)     + '</td>' +
                        '<td class="text-center">'      + action + '</td>' +
                        '</tr>';
                });
                $('#pncTbody').html(html);
            })
            .fail(function(xhr) {
                $('#pncTbody').html(
                    '<tr><td colspan="13" class="text-danger text-center py-2">' +
                    'Request failed (HTTP ' + xhr.status + '). Check that you are logged in and the server is running.' +
                    '</td></tr>');
            });
    }

    // ── Mark Obsolete ─────────────────────────────────────────────────
    $(document).on('click', '.btn-mark-obsolete', function() {
        obsoleteId = $(this).data('id');
        $('#obsoletePncCode').text($(this).data('pnc'));
        new bootstrap.Modal(document.getElementById('obsoleteModal')).show();
    });

    $('#btnConfirmObsolete').on('click', function() {
        if (!obsoleteId) return;
        $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Processing…');
        $.post('/PNC/MarkObsolete?id=' + obsoleteId)
            .done(function(r) {
                bootstrap.Modal.getInstance(document.getElementById('obsoleteModal')).hide();
                if (r.success) loadPNCs();
            })
            .always(function() {
                $('#btnConfirmObsolete').prop('disabled', false)
                    .html('<i class="fa-solid fa-ban me-1"></i>Mark Obsolete');
                obsoleteId = null;
            });
    });

    // ── Download filtered ─────────────────────────────────────────────
    $('#btnDownloadFiltered').on('click', function() {
        var params = buildFilterParams();
        var qs = Object.keys(params)
            .filter(function(k) { return params[k] !== undefined && params[k] !== null; })
            .map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
            .join('&');
        window.location.href = '/PNC/DownloadFiltered?' + qs;
    });

    // ── Upload Excel ──────────────────────────────────────────────────
    // Using <label for="excelFileInput"> in HTML — no JS click trigger needed.
    $('#excelFileInput').on('change', function() {
        var file = this.files[0];
        if (!file) return;

        // Basic format check: must be .xlsx
        if (!file.name.toLowerCase().endsWith('.xlsx')) {
            $('#uploadResult').removeClass('d-none alert-success alert-warning alert-info')
                .addClass('alert-danger')
                .html('<i class="fa-solid fa-triangle-exclamation me-1"></i>' +
                      '<strong>Incompatible format.</strong> Only .xlsx files from the PNC template are accepted.');
            this.value = '';
            return;
        }

        var fd = new FormData();
        fd.append('file', file);
        this.value = '';

        $('#uploadResult').removeClass('d-none alert-success alert-danger alert-warning')
            .addClass('alert-info')
            .html('<span class="spinner-border spinner-border-sm me-2"></span>Processing…');

        $.ajax({ url: '/PNC/UploadExcel', method: 'POST', data: fd, processData: false, contentType: false })
            .done(function(r) {
                if (!r.success) {
                    // Server detected incompatible format or other fatal error
                    $('#uploadResult').removeClass('alert-info')
                        .addClass('alert-danger')
                        .html('<i class="fa-solid fa-triangle-exclamation me-1"></i>' +
                              '<strong>Incompatible format.</strong> ' + escHtml(r.message));
                    return;
                }
                var cls = r.errors > 0 ? 'alert-warning' : 'alert-success';
                var details = '';
                if (r.dupList && r.dupList.length)
                    details += '<br><small><strong>Duplicates skipped:</strong> ' +
                               r.dupList.map(escHtml).join(', ') + '</small>';
                if (r.errorList && r.errorList.length)
                    details += '<br><small><strong>Row errors:</strong><br>' +
                               r.errorList.map(escHtml).join('<br>') + '</small>';
                $('#uploadResult').removeClass('alert-info').addClass(cls)
                    .html('<i class="fa-solid fa-circle-info me-1"></i>' +
                          '<strong>' + escHtml(r.message) + '</strong>' + details);
                if (r.imported > 0 && listVisible) loadPNCs();
                if (r.imported > 0) fetchNextSeq();
            })
            .fail(function() {
                $('#uploadResult').removeClass('alert-info')
                    .addClass('alert-danger').html('Upload request failed.');
            });
    });

    // ── Sidebar active ────────────────────────────────────────────────
    $('#pnclink').addClass('active');

    // ── Boot ─────────────────────────────────────────────────────────
    try { initModelModal(); } catch(e) {
        // Bootstrap may not be ready in rare edge cases; retry once on next tick
        setTimeout(function() {
            try { initModelModal(); } catch(e2) {
                $('#pncListWrap').removeClass('d-none');
                $('#pncTbody').html('<tr><td colspan="13" class="text-danger text-center py-2">Modal init failed — please refresh.</td></tr>');
            }
        }, 200);
    }
})();
</script>
}
