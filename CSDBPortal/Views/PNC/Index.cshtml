@{
    ViewData["Title"] = "PNC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pnc-wrapper { padding: 1.5rem; max-width: 1200px; }

    .pnc-preview-box {
        background: var(--primary-light, #f0f4ff);
        border: 2px solid var(--border, #dee2e6);
        border-radius: 8px;
        padding: 1rem 1.5rem;
        font-family: 'Courier New', monospace;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--text, #212529);
        text-align: center;
        min-height: 3.5rem;
    }

    .pnc-segment-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--text-muted, #6c757d);
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .pnc-segment-card {
        border: 1px solid var(--border, #dee2e6);
        border-radius: 6px;
        padding: 0.65rem 0.8rem;
        background: #fff;
    }

    .pnc-segment-card.seg-valid   { border-color: #198754; box-shadow: 0 0 0 2px rgba(25,135,84,.15); }
    .pnc-segment-card.seg-invalid { border-color: #dc3545; box-shadow: 0 0 0 2px rgba(220,53,69,.15); }

    .sep-dash {
        font-size: 1.3rem; font-weight: 700;
        color: var(--text-muted, #6c757d);
        display: flex; align-items: center; justify-content: center;
        padding-top: 1.5rem;
    }

    .ref-table th { background: var(--primary-light, #f0f4ff); font-size: 0.8rem; }
    .ref-table td, .ref-table th { font-size: 0.82rem; padding: 0.28rem 0.55rem; }

    #pncListTable thead th { font-size: 0.8rem; white-space: nowrap; }
    #pncListTable tbody td { font-size: 0.82rem; }

    .pnc-code { font-family: 'Courier New', monospace; font-weight: 600; letter-spacing: 1px; }

    tr.row-obsolete td { text-decoration: line-through; color: #999; }
    tr.row-obsolete .pnc-code { color: #999; }
    tr.row-obsolete .badge-obsolete { font-size: 0.68rem; }

    .upload-zone {
        border: 2px dashed var(--border, #dee2e6);
        border-radius: 8px; padding: 1rem 1.5rem;
        text-align: center; cursor: pointer;
        transition: border-color .2s, background .2s;
    }
    .upload-zone:hover { border-color: #0d6efd; background: rgba(13,110,253,.04); }

    .filter-active-badge { font-size: 0.68rem; vertical-align: middle; margin-left: 4px; }
</style>

<div class="pnc-wrapper">
    <div class="d-flex align-items-center mb-3 gap-2">
        <i class="fa-solid fa-barcode fa-lg text-primary"></i>
        <h4 class="mb-0 fw-semibold">Part Numbering Code (PNC)</h4>
    </div>

    <div class="alert alert-info py-2 mb-3" style="font-size:.87rem;">
        <strong>Format:</strong>
        <span class="font-monospace fw-semibold">&lt;ModelId&gt;-&lt;EqCode&gt;-&lt;ModCode&gt;-&lt;SubAsmCode&gt;-&lt;SeqDigits&gt;-&lt;MaintLevel&gt;-&lt;RevSuffix&gt;</span>
        &nbsp; Example: <span class="font-monospace fw-semibold">KAV-72-FAN-FCA-00001-D-A</span>
    </div>

    <!-- ── Live Preview ──────────────────────────────────────────────── -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold">Generated PNC</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="btnCopyPNC" disabled title="Copy to clipboard">
                        <i class="fa-regular fa-copy"></i> Copy
                    </button>
                    <button class="btn btn-sm btn-success" id="btnSavePNC" disabled>
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save PNC
                    </button>
                </div>
            </div>
            <div class="pnc-preview-box" id="pncPreview">—</div>
            <div id="pncValidMsg" class="mt-2 text-center" style="font-size:.85rem;"></div>
        </div>
    </div>

    <!-- ── Segment Inputs ───────────────────────────────────────────── -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
            <span>Build PNC Segments</span>
            <button class="btn btn-sm btn-outline-secondary" id="btnResetPNC">
                <i class="fa-solid fa-rotate-left me-1"></i> Reset
            </button>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-start flex-nowrap overflow-auto pb-1">

                <div class="col-auto" style="min-width:110px;">
                    <div class="pnc-segment-card" id="card_seg1">
                        <div class="pnc-segment-label">Seg 1 — Model ID</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg1" maxlength="5" placeholder="KAV" data-pattern="^[A-Z]{2,4}[0-9]?$">
                        <small class="text-muted" style="font-size:.7rem;">e.g. KAV, KAV1</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:155px;">
                    <div class="pnc-segment-card" id="card_seg2">
                        <div class="pnc-segment-label">Seg 2 — Eq. Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg2">
                            <option value="">— select —</option>
                            <option value="70">70 – Std Practices</option>
                            <option value="71">71 – Power Plant</option>
                            <option value="72">72 – Engine</option>
                            <option value="73">73 – Engine Fuel &amp; Control</option>
                            <option value="74">74 – Ignition</option>
                            <option value="75">75 – Air General</option>
                            <option value="76">76 – Engine Controls</option>
                            <option value="77">77 – Engine Indicating</option>
                            <option value="78">78 – Exhaust</option>
                            <option value="79">79 – Oil</option>
                            <option value="80">80 – Starting</option>
                        </select>
                        <small class="text-muted" style="font-size:.7rem;">ATA 2-digit</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:155px;">
                    <div class="pnc-segment-card" id="card_seg3">
                        <div class="pnc-segment-label">Seg 3 — Module Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg3">
                            <option value="">— select —</option>
                            <option value="EGN">EGN – Engine General</option>
                            <option value="EEX">EEX – Engine Exhaust</option>
                            <option value="LPC">LPC – Low Pres. Compressor</option>
                            <option value="COU">COU – Coupler</option>
                            <option value="FAN">FAN – Fan</option>
                            <option value="ICA">ICA – Intermediate Casing</option>
                            <option value="HPC">HPC – High Pres. Compressor</option>
                            <option value="DCO">DCO – Diffuser &amp; Combustor</option>
                            <option value="TNZ">TNZ – Transition Zone</option>
                            <option value="HPT">HPT – High Pres. Turbine</option>
                            <option value="LPT">LPT – Low Pres. Turbine</option>
                            <option value="TEC">TEC – Turbine Exhaust Case</option>
                            <option value="MGB">MGB – Main Gearbox</option>
                            <option value="AGB">AGB – Accessory Gearbox</option>
                        </select>
                        <small class="text-muted" style="font-size:.7rem;">3-letter code</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:120px;">
                    <div class="pnc-segment-card" id="card_seg4">
                        <div class="pnc-segment-label">Seg 4 — Sub-Asm</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg4" maxlength="3" placeholder="FCA" data-pattern="^[A-Z]{3}$">
                        <small class="text-muted" style="font-size:.7rem;">3 letters</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:115px;">
                    <div class="pnc-segment-card" id="card_seg5">
                        <div class="pnc-segment-label">Seg 5 — Seq. Digits</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace"
                               id="seg5" maxlength="5" placeholder="00001" data-pattern="^[0-9]{5}$">
                        <small class="text-muted" style="font-size:.7rem;">5 digits</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:120px;">
                    <div class="pnc-segment-card" id="card_seg6">
                        <div class="pnc-segment-label">Seg 6 — Maint. Level</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace" id="seg6">
                            <option value="">— select —</option>
                            <option value="O">O – Operator</option>
                            <option value="I">I – Intermediate</option>
                            <option value="D">D – Depot</option>
                        </select>
                        <small class="text-muted" style="font-size:.7rem;">O / I / D</small>
                    </div>
                </div>

                <div class="col-auto sep-dash px-0">-</div>

                <div class="col-auto" style="min-width:105px;">
                    <div class="pnc-segment-card" id="card_seg7">
                        <div class="pnc-segment-label">Seg 7 — Rev. Suffix</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg7" maxlength="1" placeholder="A" data-pattern="^[A-Z]$">
                        <small class="text-muted" style="font-size:.7rem;">A – Z</small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ── Action toolbar ───────────────────────────────────────────── -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-outline-primary btn-sm" id="btnShowPNCs">
            <i class="fa-solid fa-table-list me-1"></i> Show Part Numbers
            <span id="filterBadge" class="badge bg-primary filter-active-badge d-none">Filtered</span>
        </button>
        <a class="btn btn-outline-success btn-sm" href="/PNC/DownloadTemplate">
            <i class="fa-solid fa-file-excel me-1"></i> Download Template
        </a>
        <button class="btn btn-outline-secondary btn-sm" id="btnUploadTrigger">
            <i class="fa-solid fa-upload me-1"></i> Upload Excel
        </button>
        <input type="file" id="excelFileInput" accept=".xlsx" class="d-none">
    </div>

    <!-- ── Upload result ────────────────────────────────────────────── -->
    <div id="uploadResult" class="alert d-none mb-3" role="alert"></div>

    <!-- ── PNC List ─────────────────────────────────────────────────── -->
    <div id="pncListWrap" class="d-none">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="fw-semibold">
                        Part Numbers
                        <span id="pncCount" class="badge bg-secondary ms-1">0</span>
                    </span>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Show obsolete toggle -->
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkShowObsolete" checked>
                            <label class="form-check-label small" for="chkShowObsolete">Show obsolete</label>
                        </div>
                        <!-- Download filtered -->
                        <button class="btn btn-sm btn-outline-success" id="btnDownloadFiltered">
                            <i class="fa-solid fa-file-arrow-down me-1"></i> Download
                        </button>
                    </div>
                </div>
                <div id="pncFilterDesc" class="text-muted small mt-1"></div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover mb-0" id="pncListTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>ModelId</th>
                                <th>EqCode</th>
                                <th>ModCode</th>
                                <th>SubAsmCode</th>
                                <th>SeqDigits</th>
                                <th>Level</th>
                                <th>Rev</th>
                                <th>Full PNC</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created On</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="pncTbody">
                            <tr><td colspan="13" class="text-center text-muted py-3">No data loaded.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Reference Tables ─────────────────────────────────────────── -->
    <div class="row g-3 mt-1">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Equipment Codes (ATA)</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead><tr><th>Code</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">70</td><td>Standard Practices</td></tr>
                            <tr><td class="font-monospace fw-semibold">71</td><td>Power Plant</td></tr>
                            <tr><td class="font-monospace fw-semibold">72</td><td>Engine</td></tr>
                            <tr><td class="font-monospace fw-semibold">73</td><td>Engine Fuel and Control</td></tr>
                            <tr><td class="font-monospace fw-semibold">74</td><td>Ignition</td></tr>
                            <tr><td class="font-monospace fw-semibold">75</td><td>Air General</td></tr>
                            <tr><td class="font-monospace fw-semibold">76</td><td>Engine Controls</td></tr>
                            <tr><td class="font-monospace fw-semibold">77</td><td>Engine Indicating</td></tr>
                            <tr><td class="font-monospace fw-semibold">78</td><td>Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">79</td><td>Oil</td></tr>
                            <tr><td class="font-monospace fw-semibold">80</td><td>Starting</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Module Codes</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead><tr><th>Code</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">EGN</td><td>Engine General</td></tr>
                            <tr><td class="font-monospace fw-semibold">EEX</td><td>Engine Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPC</td><td>Low Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">COU</td><td>Coupler</td></tr>
                            <tr><td class="font-monospace fw-semibold">FAN</td><td>Fan</td></tr>
                            <tr><td class="font-monospace fw-semibold">ICA</td><td>Intermediate Casing</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPC</td><td>High Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">DCO</td><td>Diffuser &amp; Combustor</td></tr>
                            <tr><td class="font-monospace fw-semibold">TNZ</td><td>Transition Zone</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPT</td><td>High Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPT</td><td>Low Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">TEC</td><td>Turbine Exhaust Case</td></tr>
                            <tr><td class="font-monospace fw-semibold">MGB</td><td>Main Gearbox</td></tr>
                            <tr><td class="font-monospace fw-semibold">AGB</td><td>Accessory Gearbox</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Obsolete confirm modal -->
<div class="modal fade" id="obsoleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Mark as Obsolete?</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <p class="mb-1 small">This action cannot be undone. The part number will be permanently marked obsolete:</p>
                <p class="font-monospace fw-bold" id="obsoletePncCode"></p>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-warning" id="btnConfirmObsolete">
                    <i class="fa-solid fa-ban me-1"></i>Mark Obsolete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    var segIds = ['seg1','seg2','seg3','seg4','seg5','seg6','seg7'];
    var listVisible = false;
    var obsoleteId  = null;

    function escHtml(s) {
        return String(s)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function getVal(id) { return ($('#' + id).val() || '').trim().toUpperCase(); }

    function isValidSeg(id) {
        var $el = $('#' + id);
        var val = ($el.val() || '').trim().toUpperCase();
        if (!val) return null;
        var pat = $el.data('pattern');
        return pat ? new RegExp(pat).test(val) : val.length > 0;
    }

    // ── live preview ──────────────────────────────────────────────────
    function updatePreview() {
        var parts = segIds.map(function(id){
            return ($('#' + id).val() || '').trim().toUpperCase();
        });

        segIds.forEach(function(id){
            var $card = $('#card_' + id);
            $card.removeClass('seg-valid seg-invalid');
            var v = isValidSeg(id);
            if (v === true)  $card.addClass('seg-valid');
            if (v === false) $card.addClass('seg-invalid');
        });

        var filled = parts.filter(function(v){ return v !== ''; });
        if (!filled.length) {
            $('#pncPreview').text('—');
            $('#pncValidMsg').text('');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
            updateFilterBadge();
            return;
        }

        var pnc = parts.map(function(v){ return v || '?'; }).join('-');
        $('#pncPreview').text(pnc);

        var allFilled = parts.every(function(v){ return v !== ''; });
        var allValid  = segIds.every(function(id){ return isValidSeg(id) === true; });

        if (allFilled && allValid) {
            $('#pncValidMsg').html('<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Valid PNC.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', false);
        } else if (allFilled) {
            $('#pncValidMsg').html('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>One or more segments are invalid.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        } else {
            $('#pncValidMsg').html('<span class="text-muted">' + (7 - filled.length) + ' segment(s) remaining.</span>');
            $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        }

        updateFilterBadge();
        if (listVisible) loadPNCs();
    }

    function updateFilterBadge() {
        var any = segIds.some(function(id){ return ($('#' + id).val() || '').trim() !== ''; });
        $('#filterBadge').toggleClass('d-none', !any);
    }

    // ── segment events ────────────────────────────────────────────────
    $('.pnc-seg').on('input change', function(){
        if ($(this).is('input')) {
            var pos = this.selectionStart;
            $(this).val($(this).val().toUpperCase());
            try { this.setSelectionRange(pos, pos); } catch(e){}
        }
        updatePreview();
    });

    // ── Save ──────────────────────────────────────────────────────────
    $('#btnSavePNC').on('click', function(){
        var pnc = {
            modelId:    getVal('seg1'),
            eqCode:     $('#seg2').val() || '',
            modCode:    $('#seg3').val() || '',
            subAsmCode: getVal('seg4'),
            seqDigits:  $('#seg5').val() || '',
            maintLevel: $('#seg6').val() || '',
            revSuffix:  getVal('seg7')
        };
        $('#btnSavePNC').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving…');
        $.ajax({ url: '/PNC/SavePNC', method: 'POST', contentType: 'application/json', data: JSON.stringify(pnc) })
            .done(function(r){
                if (r.success) {
                    $('#pncValidMsg').html('<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>' + escHtml(r.message) + '</span>');
                    if (listVisible) loadPNCs();
                } else {
                    $('#pncValidMsg').html('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>' + escHtml(r.message) + '</span>');
                }
            })
            .fail(function(){ $('#pncValidMsg').html('<span class="text-danger">Server error.</span>'); })
            .always(function(){ $('#btnSavePNC').prop('disabled', false).html('<i class="fa-solid fa-floppy-disk me-1"></i> Save PNC'); });
    });

    // ── Copy ──────────────────────────────────────────────────────────
    $('#btnCopyPNC').on('click', function(){
        var pnc = $('#pncPreview').text();
        if (pnc && pnc !== '—') {
            navigator.clipboard.writeText(pnc).then(function(){
                var $b = $('#btnCopyPNC'), orig = $b.html();
                $b.html('<i class="fa-solid fa-check me-1"></i>Copied!');
                setTimeout(function(){ $b.html(orig); }, 1500);
            }).catch(function(){
                var ta = document.createElement('textarea');
                ta.value = pnc; document.body.appendChild(ta); ta.select();
                document.execCommand('copy'); document.body.removeChild(ta);
            });
        }
    });

    // ── Reset ─────────────────────────────────────────────────────────
    $('#btnResetPNC').on('click', function(){
        segIds.forEach(function(id){
            $('#' + id).val('');
            $('#card_' + id).removeClass('seg-valid seg-invalid');
        });
        $('#pncPreview').text('—');
        $('#pncValidMsg').text('');
        $('#btnCopyPNC, #btnSavePNC').prop('disabled', true);
        $('#filterBadge').addClass('d-none');
        if (listVisible) loadPNCs();
    });

    // ── Show PNCs / reload ────────────────────────────────────────────
    $('#btnShowPNCs').on('click', function(){
        listVisible = true;
        $('#pncListWrap').removeClass('d-none');
        loadPNCs();
        $('html,body').animate({ scrollTop: $('#pncListWrap').offset().top - 80 }, 300);
    });

    $('#chkShowObsolete').on('change', function(){ if (listVisible) loadPNCs(); });

    function buildFilterParams() {
        return {
            seg1: getVal('seg1') || undefined,
            seg2: $('#seg2').val() || undefined,
            seg3: $('#seg3').val() || undefined,
            seg4: getVal('seg4') || undefined,
            seg5: $('#seg5').val() || undefined,
            seg6: $('#seg6').val() || undefined,
            seg7: getVal('seg7') || undefined,
            includeObsolete: $('#chkShowObsolete').is(':checked')
        };
    }

    function buildFilterDesc(p) {
        var parts = [];
        if (p.seg1) parts.push('Model: ' + p.seg1);
        if (p.seg2) parts.push('Eq: '    + p.seg2);
        if (p.seg3) parts.push('Mod: '   + p.seg3);
        if (p.seg4) parts.push('Sub: '   + p.seg4);
        if (p.seg5) parts.push('Seq: '   + p.seg5);
        if (p.seg6) parts.push('Level: ' + p.seg6);
        if (p.seg7) parts.push('Rev: '   + p.seg7);
        var obsoleteNote = p.includeObsolete ? '' : ' · Obsolete hidden';
        return parts.length ? 'Filters: ' + parts.join(', ') + obsoleteNote : 'Showing all' + obsoleteNote;
    }

    function loadPNCs() {
        var params = buildFilterParams();
        $('#pncFilterDesc').text(buildFilterDesc(params));
        $('#pncTbody').html('<tr><td colspan="13" class="text-center py-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr>');

        $.get('/PNC/GetPNCs', params).done(function(r){
            $('#pncCount').text(r.data ? r.data.length : 0);
            if (!r.success || !r.data.length) {
                $('#pncTbody').html('<tr><td colspan="13" class="text-center text-muted py-3">No part numbers found.</td></tr>');
                return;
            }
            var html = '';
            $.each(r.data, function(i, row){
                var obs = row.isObsolete;
                var statusBadge = obs
                    ? '<span class="badge bg-secondary badge-obsolete">Obsolete</span>'
                    : '<span class="badge bg-success" style="font-size:.68rem;">Active</span>';
                var actionBtn = obs
                    ? '<span class="text-muted small" title="Obsoleted by ' + escHtml(row.obsoletedBy||'') + ' on ' + escHtml(row.obsoletedOn||'') + '"><i class="fa-solid fa-ban"></i></span>'
                    : '<button class="btn btn-warning btn-sm py-0 px-1 btn-mark-obsolete" data-id="' + row.id + '" data-pnc="' + escHtml(row.fullPNC) + '" title="Mark as Obsolete"><i class="fa-solid fa-ban" style="font-size:.75rem;"></i></button>';

                html += '<tr class="' + (obs ? 'row-obsolete' : '') + '">' +
                    '<td>' + (i+1) + '</td>' +
                    '<td class="font-monospace">' + escHtml(row.modelId)    + '</td>' +
                    '<td class="font-monospace">' + escHtml(row.eqCode)     + '</td>' +
                    '<td class="font-monospace">' + escHtml(row.modCode)    + '</td>' +
                    '<td class="font-monospace">' + escHtml(row.subAsmCode) + '</td>' +
                    '<td class="font-monospace">' + escHtml(row.seqDigits)  + '</td>' +
                    '<td class="font-monospace text-center">' + escHtml(row.maintLevel) + '</td>' +
                    '<td class="font-monospace text-center">' + escHtml(row.revSuffix)  + '</td>' +
                    '<td class="pnc-code">'       + escHtml(row.fullPNC)    + '</td>' +
                    '<td class="text-center">'    + statusBadge + '</td>' +
                    '<td class="text-muted small">' + escHtml(row.createdBy||'')  + '</td>' +
                    '<td class="text-muted small">' + escHtml(row.createdOn)       + '</td>' +
                    '<td class="text-center">'    + actionBtn + '</td>' +
                    '</tr>';
            });
            $('#pncTbody').html(html);
        }).fail(function(){
            $('#pncTbody').html('<tr><td colspan="13" class="text-danger text-center py-2">Request failed.</td></tr>');
        });
    }

    // ── Mark Obsolete ─────────────────────────────────────────────────
    $(document).on('click', '.btn-mark-obsolete', function(){
        obsoleteId = $(this).data('id');
        $('#obsoletePncCode').text($(this).data('pnc'));
        new bootstrap.Modal(document.getElementById('obsoleteModal')).show();
    });

    $('#btnConfirmObsolete').on('click', function(){
        if (!obsoleteId) return;
        $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Processing…');
        $.post('/PNC/MarkObsolete?id=' + obsoleteId)
            .done(function(r){
                bootstrap.Modal.getInstance(document.getElementById('obsoleteModal')).hide();
                if (r.success) loadPNCs();
            })
            .always(function(){
                $('#btnConfirmObsolete').prop('disabled', false)
                    .html('<i class="fa-solid fa-ban me-1"></i>Mark Obsolete');
                obsoleteId = null;
            });
    });

    // ── Download filtered ─────────────────────────────────────────────
    $('#btnDownloadFiltered').on('click', function(){
        var params = buildFilterParams();
        // Build query string
        var qs = Object.keys(params)
            .filter(function(k){ return params[k] !== undefined && params[k] !== null; })
            .map(function(k){ return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
            .join('&');
        window.location.href = '/PNC/DownloadFiltered?' + qs;
    });

    // ── Upload Excel ──────────────────────────────────────────────────
    $('#btnUploadTrigger').on('click', function(){ $('#excelFileInput').trigger('click'); });

    $('#excelFileInput').on('change', function(){
        var file = this.files[0];
        if (!file) return;
        var fd = new FormData();
        fd.append('file', file);
        this.value = '';
        $('#uploadResult').removeClass('d-none alert-success alert-danger alert-warning')
            .addClass('alert-info').html('<span class="spinner-border spinner-border-sm me-2"></span>Processing…');
        $.ajax({ url: '/PNC/UploadExcel', method: 'POST', data: fd, processData: false, contentType: false })
            .done(function(r){
                var cls = r.success ? (r.errors > 0 ? 'alert-warning' : 'alert-success') : 'alert-danger';
                var details = '';
                if (r.dupList && r.dupList.length)
                    details += '<br><small><strong>Duplicates skipped:</strong> ' + r.dupList.map(escHtml).join(', ') + '</small>';
                if (r.errorList && r.errorList.length)
                    details += '<br><small><strong>Errors:</strong><br>' + r.errorList.map(escHtml).join('<br>') + '</small>';
                $('#uploadResult').removeClass('alert-info').addClass(cls)
                    .html('<i class="fa-solid fa-circle-info me-1"></i><strong>' + escHtml(r.message) + '</strong>' + details);
                if (r.imported > 0 && listVisible) loadPNCs();
            })
            .fail(function(){ $('#uploadResult').removeClass('alert-info').addClass('alert-danger').html('Upload failed.'); });
    });

    // ── Sidebar active ────────────────────────────────────────────────
    $('#pnclink').addClass('active');
    updatePreview();
})();
</script>
