@{
    ViewData["Title"] = "PNC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pnc-wrapper {
        padding: 1.5rem;
        max-width: 1100px;
    }

    .pnc-preview-box {
        background: var(--primary-light, #f0f4ff);
        border: 2px solid var(--border, #dee2e6);
        border-radius: 8px;
        padding: 1rem 1.5rem;
        font-family: 'Courier New', monospace;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: var(--text, #212529);
        text-align: center;
        min-height: 3.5rem;
        word-break: break-all;
    }

    .pnc-segment-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--text-muted, #6c757d);
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .pnc-segment-card {
        border: 1px solid var(--border, #dee2e6);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        background: #fff;
        height: 100%;
    }

    .pnc-segment-card.active-seg {
        border-color: #0d6efd;
        box-shadow: 0 0 0 2px rgba(13,110,253,.15);
    }

    .pnc-separator {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-muted, #6c757d);
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 1.6rem;
    }

    .ref-table th {
        background: var(--primary-light, #f0f4ff);
        font-size: 0.8rem;
    }

    .ref-table td, .ref-table th {
        font-size: 0.82rem;
        padding: 0.3rem 0.6rem;
    }

    .pnc-invalid {
        border-color: #dc3545 !important;
    }

    .pnc-valid {
        border-color: #198754 !important;
    }

    .badge-seg {
        font-size: 0.7rem;
        vertical-align: middle;
    }

    #pncResult {
        font-size: 1rem;
    }

    .copy-btn {
        cursor: pointer;
    }
</style>

<div class="pnc-wrapper">
    <div class="d-flex align-items-center mb-3 gap-2">
        <i class="fa-solid fa-barcode fa-lg text-primary"></i>
        <h4 class="mb-0 fw-semibold">Part Numbering Code (PNC) Builder</h4>
    </div>

    <!-- Format description -->
    <div class="alert alert-info py-2 mb-3" style="font-size:0.87rem;">
        <strong>PNC Format:</strong>
        <span class="font-monospace fw-semibold">
            &lt;ModelId&gt; - &lt;EqCode&gt; - &lt;ModCode&gt; - &lt;SubAsmCode&gt; - &lt;SeqDigits&gt; - &lt;MaintLevel&gt; - &lt;RevSuffix&gt;
        </span>
        &nbsp;&nbsp;
        <span class="text-muted">Example: <span class="font-monospace fw-semibold">KAV-72-FAN-FCA-00001-D-A</span></span>
    </div>

    <!-- Live preview -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-semibold">Generated PNC</span>
                <button class="btn btn-sm btn-outline-secondary copy-btn" id="btnCopyPNC" title="Copy to clipboard" disabled>
                    <i class="fa-regular fa-copy"></i> Copy
                </button>
            </div>
            <div class="pnc-preview-box" id="pncPreview">—</div>
            <div id="pncValidMsg" class="mt-2 text-center" style="font-size:0.85rem;"></div>
        </div>
    </div>

    <!-- Segment inputs -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Build PNC Segments</div>
        <div class="card-body">
            <div class="row g-2 align-items-start" id="segmentRow">

                <!-- Seg 1: Model ID -->
                <div class="col-auto" style="min-width:110px;">
                    <div class="pnc-segment-card" id="card_seg1">
                        <div class="pnc-segment-label">Seg 1 — Model ID</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg1" maxlength="4" placeholder="KAV"
                               data-seg="1" data-pattern="^[A-Z]{2,4}[0-9]?$" data-hint="2-4 letters, optional digit suffix for variant">
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">e.g. KAV, KAV1</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 2: Equipment Code -->
                <div class="col-auto" style="min-width:120px;">
                    <div class="pnc-segment-card" id="card_seg2">
                        <div class="pnc-segment-label">Seg 2 — Eq. Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace"
                                id="seg2" data-seg="2">
                            <option value="">— select —</option>
                            <option value="70">70 – Std Practices</option>
                            <option value="71">71 – Power Plant</option>
                            <option value="72">72 – Engine</option>
                            <option value="73">73 – Engine Fuel &amp; Control</option>
                            <option value="74">74 – Ignition</option>
                            <option value="75">75 – Air General</option>
                            <option value="76">76 – Engine Controls</option>
                            <option value="77">77 – Engine Indicating</option>
                            <option value="78">78 – Exhaust</option>
                            <option value="79">79 – Oil</option>
                            <option value="80">80 – Starting</option>
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">ATA 2-digit</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 3: Module Code -->
                <div class="col-auto" style="min-width:130px;">
                    <div class="pnc-segment-card" id="card_seg3">
                        <div class="pnc-segment-label">Seg 3 — Module Code</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace"
                                id="seg3" data-seg="3">
                            <option value="">— select —</option>
                            <option value="EGN">EGN – Engine General</option>
                            <option value="EEX">EEX – Engine Exhaust</option>
                            <option value="LPC">LPC – Low Pressure Compressor</option>
                            <option value="COU">COU – Coupler</option>
                            <option value="FAN">FAN – Fan</option>
                            <option value="ICA">ICA – Intermediate Casing</option>
                            <option value="HPC">HPC – High Pressure Compressor</option>
                            <option value="DCO">DCO – Diffuser &amp; Combustor</option>
                            <option value="TNZ">TNZ – Transition Zone</option>
                            <option value="HPT">HPT – High Pressure Turbine</option>
                            <option value="LPT">LPT – Low Pressure Turbine</option>
                            <option value="TEC">TEC – Turbine Exhaust Case</option>
                            <option value="MGB">MGB – Main Gearbox</option>
                            <option value="AGB">AGB – Accessory Gearbox</option>
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">3-letter code</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 4: Subassembly Code -->
                <div class="col-auto" style="min-width:130px;">
                    <div class="pnc-segment-card" id="card_seg4">
                        <div class="pnc-segment-label">Seg 4 — Sub-Asm Code</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg4" maxlength="3" placeholder="FCA"
                               data-seg="4" data-pattern="^[A-Z]{3}$" data-hint="Exactly 3 letters">
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">3 letters, e.g. FCA</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 5: Sequential Digits -->
                <div class="col-auto" style="min-width:120px;">
                    <div class="pnc-segment-card" id="card_seg5">
                        <div class="pnc-segment-label">Seg 5 — Seq. Digits</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace"
                               id="seg5" maxlength="5" placeholder="00001"
                               data-seg="5" data-pattern="^[0-9]{5}$" data-hint="Exactly 5 digits (e.g. 00001)">
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">5 digits</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 6: Maintenance Level -->
                <div class="col-auto" style="min-width:130px;">
                    <div class="pnc-segment-card" id="card_seg6">
                        <div class="pnc-segment-label">Seg 6 — Maint. Level</div>
                        <select class="form-select form-select-sm pnc-seg font-monospace"
                                id="seg6" data-seg="6">
                            <option value="">— select —</option>
                            <option value="O">O – Operator</option>
                            <option value="I">I – Intermediate</option>
                            <option value="D">D – Depot</option>
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">O / I / D</small>
                    </div>
                </div>

                <div class="pnc-separator col-auto px-0">-</div>

                <!-- Seg 7: Revision Suffix -->
                <div class="col-auto" style="min-width:110px;">
                    <div class="pnc-segment-card" id="card_seg7">
                        <div class="pnc-segment-label">Seg 7 — Rev. Suffix</div>
                        <input type="text" class="form-control form-control-sm pnc-seg font-monospace text-uppercase"
                               id="seg7" maxlength="1" placeholder="A"
                               data-seg="7" data-pattern="^[A-Z]$" data-hint="Single letter A–Z">
                        <small class="text-muted d-block mt-1" style="font-size:0.7rem;">A – Z</small>
                    </div>
                </div>

            </div><!-- /row -->

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary btn-sm" id="btnBuildPNC">
                    <i class="fa-solid fa-wrench me-1"></i> Build PNC
                </button>
                <button class="btn btn-outline-secondary btn-sm" id="btnResetPNC">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Reference tables -->
    <div class="row g-3">
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Equipment Codes (ATA)</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">70</td><td>Standard Practices</td></tr>
                            <tr><td class="font-monospace fw-semibold">71</td><td>Power Plant</td></tr>
                            <tr><td class="font-monospace fw-semibold">72</td><td>Engine</td></tr>
                            <tr><td class="font-monospace fw-semibold">73</td><td>Engine Fuel and Control</td></tr>
                            <tr><td class="font-monospace fw-semibold">74</td><td>Ignition</td></tr>
                            <tr><td class="font-monospace fw-semibold">75</td><td>Air General</td></tr>
                            <tr><td class="font-monospace fw-semibold">76</td><td>Engine Controls</td></tr>
                            <tr><td class="font-monospace fw-semibold">77</td><td>Engine Indicating</td></tr>
                            <tr><td class="font-monospace fw-semibold">78</td><td>Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">79</td><td>Oil</td></tr>
                            <tr><td class="font-monospace fw-semibold">80</td><td>Starting</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Module Codes</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-bordered ref-table mb-0">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="font-monospace fw-semibold">EGN</td><td>Engine General</td></tr>
                            <tr><td class="font-monospace fw-semibold">EEX</td><td>Engine Exhaust</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPC</td><td>Low Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">COU</td><td>Coupler</td></tr>
                            <tr><td class="font-monospace fw-semibold">FAN</td><td>Fan</td></tr>
                            <tr><td class="font-monospace fw-semibold">ICA</td><td>Intermediate Casing</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPC</td><td>High Pressure Compressor</td></tr>
                            <tr><td class="font-monospace fw-semibold">DCO</td><td>Diffuser &amp; Combustor</td></tr>
                            <tr><td class="font-monospace fw-semibold">TNZ</td><td>Transition Zone</td></tr>
                            <tr><td class="font-monospace fw-semibold">HPT</td><td>High Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">LPT</td><td>Low Pressure Turbine</td></tr>
                            <tr><td class="font-monospace fw-semibold">TEC</td><td>Turbine Exhaust Case</td></tr>
                            <tr><td class="font-monospace fw-semibold">MGB</td><td>Main Gearbox</td></tr>
                            <tr><td class="font-monospace fw-semibold">AGB</td><td>Accessory Gearbox</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        var segIds = ['seg1', 'seg2', 'seg3', 'seg4', 'seg5', 'seg6', 'seg7'];

        // Auto-uppercase text inputs on input
        $('.pnc-seg').on('input change', function () {
            var $el = $(this);
            if ($el.is('input')) {
                var pos = this.selectionStart;
                $el.val($el.val().toUpperCase());
                try { this.setSelectionRange(pos, pos); } catch (e) { }
            }
            updatePreview();
        });

        function getSegValue(id) {
            return $('#' + id).val() || '';
        }

        function validateSeg(id) {
            var $el = $('#' + id);
            var val = $el.val() || '';
            if (!val) return null; // empty = neutral
            var pattern = $el.data('pattern');
            if (pattern) {
                return new RegExp(pattern).test(val);
            }
            return val.length > 0;
        }

        function updatePreview() {
            var parts = segIds.map(function (id) { return getSegValue(id); });
            var filled = parts.filter(function (v) { return v !== ''; });

            // Update card borders
            segIds.forEach(function (id, i) {
                var valid = validateSeg(id);
                var $card = $('#card_' + id);
                $card.removeClass('pnc-invalid pnc-valid active-seg');
                var val = getSegValue(id);
                if (val) {
                    $card.addClass(valid ? 'pnc-valid active-seg' : 'pnc-invalid active-seg');
                }
            });

            if (filled.length === 0) {
                $('#pncPreview').text('—');
                $('#pncValidMsg').text('');
                $('#btnCopyPNC').prop('disabled', true);
                return;
            }

            var pnc = parts.map(function (v) { return v || '?'; }).join('-');
            $('#pncPreview').text(pnc);

            // Check all valid
            var allFilled = parts.every(function (v) { return v !== ''; });
            var allValid = segIds.every(function (id) {
                var v = getSegValue(id);
                if (!v) return false;
                var pattern = $('#' + id).data('pattern');
                return pattern ? new RegExp(pattern).test(v) : true;
            });

            if (allFilled && allValid) {
                $('#pncValidMsg').html('<span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>PNC is valid.</span>');
                $('#btnCopyPNC').prop('disabled', false);
            } else if (allFilled && !allValid) {
                $('#pncValidMsg').html('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>One or more segments are invalid. Check highlighted fields.</span>');
                $('#btnCopyPNC').prop('disabled', true);
            } else {
                var remaining = 7 - filled.length;
                $('#pncValidMsg').html('<span class="text-muted">' + remaining + ' segment(s) remaining.</span>');
                $('#btnCopyPNC').prop('disabled', true);
            }
        }

        $('#btnBuildPNC').on('click', function () {
            updatePreview();
            // Scroll to preview
            $('html, body').animate({ scrollTop: $('.pnc-preview-box').offset().top - 80 }, 300);
        });

        $('#btnResetPNC').on('click', function () {
            segIds.forEach(function (id) {
                var $el = $('#' + id);
                if ($el.is('select')) {
                    $el.val('');
                } else {
                    $el.val('');
                }
                $('#card_' + id).removeClass('pnc-invalid pnc-valid active-seg');
            });
            $('#pncPreview').text('—');
            $('#pncValidMsg').text('');
            $('#btnCopyPNC').prop('disabled', true);
        });

        $('#btnCopyPNC').on('click', function () {
            var pnc = $('#pncPreview').text();
            if (pnc && pnc !== '—') {
                navigator.clipboard.writeText(pnc).then(function () {
                    var $btn = $('#btnCopyPNC');
                    var orig = $btn.html();
                    $btn.html('<i class="fa-solid fa-check me-1"></i> Copied!');
                    setTimeout(function () { $btn.html(orig); }, 1500);
                }).catch(function () {
                    // fallback
                    var ta = document.createElement('textarea');
                    ta.value = pnc;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                });
            }
        });

        // Set pnclink active in sidebar
        $('#pnclink').addClass('active');

        // Initial state
        updatePreview();
    })();
</script>
