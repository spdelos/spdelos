@model CSDBPortal.ViewModels.PublisherViewModel
@{
    ViewData["Title"] = "Publisher";
    var firstTab = Model.CanPublishIetp ? "ietp" : Model.CanExportPdf ? "pdf" : Model.CanManageLicense ? "license" : "";
    var hasAny   = firstTab != "";

    // Pre-join package codes with their license records for the Published Packages table.
    // Avoids code statements inside @foreach bodies which confuse the Razor parser.
    var licByFilename = Model.IetpLicenses
        .Where(l => l.IETP != null)
        .ToDictionary(l => l.IETP!, l => l);
    var packageRows = Model.AllPackageCodes
        .Select(c => (
            Code:    c,
            License: (c.PackageFilename != null && licByFilename.ContainsKey(c.PackageFilename))
                         ? licByFilename[c.PackageFilename]
                         : null
        ))
        .ToList();
}

<div class="pub-shell">

    <!-- ── Page header ── -->
    <div class="pub-header">
        <div class="pub-header-title">
            <i class="fa-solid fa-rocket me-2 text-primary"></i>Publisher
        </div>
        <div class="pub-header-sub">Generate and publish IETP and PDF packages</div>
    </div>

@if (!hasAny)
{
    <div class="pub-body">
        <div class="pub-section py-5 text-center text-muted">
            <i class="fa-solid fa-lock fa-2x mb-3 d-block"></i>
            You do not have permission to access any Publisher features.<br>
            Contact your administrator to request access.
        </div>
    </div>
}
else
{
    <!-- ── Project selector (only when at least one package tab is available) ── -->
    @if (Model.CanPublishIetp || Model.CanExportPdf)
    {
    <div class="pub-project-bar">
        <label class="pub-label" for="pubProjectSelect">
            <i class="fa-solid fa-folder-open me-1"></i>Project
        </label>
        <select id="pubProjectSelect" class="form-select pub-project-select">
            <option value="">— Select a project —</option>
            @foreach (var p in Model.Projects)
            {
                <option value="@p.Id" data-mi="@(p.ModelIdentification ?? "")">@p.Name — @p.Title</option>
            }
        </select>
    </div>
    }

    <!-- ── Output-type tabs ── -->
    <div class="pub-body">

        <ul class="nav nav-tabs pub-tabs mb-0" id="pubTabs" role="tablist">
            @if (Model.CanPublishIetp)
            {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(firstTab == "ietp" ? "active" : "")" id="tab-ietp"
                        data-bs-toggle="tab" data-bs-target="#pane-ietp"
                        type="button" role="tab" aria-controls="pane-ietp"
                        aria-selected="@(firstTab == "ietp" ? "true" : "false")">
                    <i class="fa-solid fa-globe me-1"></i>IETP
                </button>
            </li>
            }
            @if (Model.CanExportPdf)
            {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(firstTab == "pdf" ? "active" : "")" id="tab-pdf"
                        data-bs-toggle="tab" data-bs-target="#pane-pdf"
                        type="button" role="tab" aria-controls="pane-pdf"
                        aria-selected="@(firstTab == "pdf" ? "true" : "false")">
                    <i class="fa-solid fa-file-pdf me-1"></i>PDF
                </button>
            </li>
            }
            @if (Model.CanManageLicense)
            {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(firstTab == "license" ? "active" : "")" id="tab-license"
                        data-bs-toggle="tab" data-bs-target="#pane-license"
                        type="button" role="tab" aria-controls="pane-license"
                        aria-selected="@(firstTab == "license" ? "true" : "false")">
                    <i class="fa-solid fa-key me-1"></i>License
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-packages"
                        data-bs-toggle="tab" data-bs-target="#pane-packages"
                        type="button" role="tab" aria-controls="pane-packages"
                        aria-selected="false">
                    <i class="fa-solid fa-boxes-stacked me-1"></i>Published Packages
                    @if (Model.AllPackageCodes.Any())
                    {
                        <span class="badge bg-secondary ms-1" style="font-size:10px;">@Model.AllPackageCodes.Count</span>
                    }
                </button>
            </li>
            }
        </ul>

        <div class="tab-content pub-tab-content" id="pubTabContent">

            <!-- ══════════════════ IETP TAB ══════════════════ -->
            @if (Model.CanPublishIetp)
            {
            <div class="tab-pane fade @(firstTab == "ietp" ? "show active" : "")" id="pane-ietp" role="tabpanel" aria-labelledby="tab-ietp">

                <div class="pub-section-grid">

                    <!-- ── Package Type ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-box me-1"></i>Package Type
                        </div>

                        <!-- Type radio cards -->
                        <div class="d-flex gap-4 mb-3">
                            <div class="form-check pub-radio-card" id="pkgPmcCard">
                                <input class="form-check-input" type="radio" name="ietpPackageType"
                                       id="pkgTypePmc" value="PMC" checked>
                                <label class="form-check-label" for="pkgTypePmc">
                                    <span class="fw-semibold">PMC</span>
                                    <div class="pub-radio-desc">Publication Module Code</div>
                                </label>
                            </div>
                            <div class="form-check pub-radio-card" id="pkgDdnCard">
                                <input class="form-check-input" type="radio" name="ietpPackageType"
                                       id="pkgTypeDdn" value="DDN">
                                <label class="form-check-label" for="pkgTypeDdn">
                                    <span class="fw-semibold">DDN</span>
                                    <div class="pub-radio-desc">Data Dispatch Note</div>
                                </label>
                            </div>
                        </div>

                        <!-- PMC code builder -->
                        <div id="pmcBuilderPanel">
                            <div class="pkg-builder-grid">
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Model Identification (MI)</label>
                                    <input type="text" id="pmcMi" class="form-control form-control-sm font-monospace"
                                           placeholder="Auto-filled from project" readonly>
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Issuing Authority <span class="text-muted fw-normal">(5 chars)</span></label>
                                    <input type="text" id="pmcIssuingAuth" class="form-control form-control-sm font-monospace"
                                           maxlength="5" placeholder="AAAAA">
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Number <span class="text-muted fw-normal">(5 chars)</span></label>
                                    <input type="text" id="pmcNumber" class="form-control form-control-sm font-monospace"
                                           maxlength="5" placeholder="NNNNN">
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Volume <span class="text-muted fw-normal">(2 chars)</span></label>
                                    <input type="text" id="pmcVolume" class="form-control form-control-sm font-monospace"
                                           maxlength="2" placeholder="VV">
                                </div>
                            </div>
                            <div class="pkg-code-preview mt-2">
                                <span class="pkg-code-label">Code preview</span>
                                <code id="pmcCodePreview" class="ms-2">PMC-MI-AAAAA-NNNNN-VV</code>
                            </div>
                        </div>

                        <!-- DDN code builder -->
                        <div id="ddnBuilderPanel" style="display:none;">
                            <div class="pkg-builder-grid">
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Model Identification (MI)</label>
                                    <input type="text" id="ddnMi" class="form-control form-control-sm font-monospace"
                                           placeholder="Auto-filled from project" readonly>
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Sender NCAGE <span class="text-muted fw-normal">(5 chars)</span></label>
                                    <input type="text" id="ddnSenderNcage" class="form-control form-control-sm font-monospace"
                                           maxlength="5" placeholder="SSSSS">
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Receiver NCAGE <span class="text-muted fw-normal">(5 chars)</span></label>
                                    <input type="text" id="ddnReceiverNcage" class="form-control form-control-sm font-monospace"
                                           maxlength="5" placeholder="RRRRR">
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Year <span class="text-muted fw-normal">(4 digits)</span></label>
                                    <input type="text" id="ddnYear" class="form-control form-control-sm font-monospace"
                                           maxlength="4" placeholder="YYYY" value="@DateTime.UtcNow.Year">
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold text-secondary">Sequential Nr <span class="text-muted fw-normal">(5 chars)</span></label>
                                    <input type="text" id="ddnSeqNr" class="form-control form-control-sm font-monospace"
                                           maxlength="5" placeholder="NNNNN">
                                </div>
                            </div>
                            <div class="pkg-code-preview mt-2">
                                <span class="pkg-code-label">Code preview</span>
                                <code id="ddnCodePreview" class="ms-2">DDN-MI-SSSSS-RRRRR-YYYY-NNNNN</code>
                            </div>
                        </div>

                        <!-- Register action -->
                        <div class="d-flex align-items-center gap-3 mt-3">
                            <button type="button" id="btnRegisterCode" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-plus me-1"></i>Register Code
                            </button>
                            <span id="regCodeStatus" style="font-size:12px;"></span>
                        </div>

                        <!-- Available codes (one must be selected before publishing) -->
                        <div class="pkg-codes-section mt-3">
                            <div class="pkg-codes-header">
                                <span class="pkg-codes-title"><i class="fa-solid fa-list-check me-1"></i>Available Codes</span>
                                <span class="text-muted" style="font-size:11px;">Select one — required for publishing</span>
                            </div>
                            <div id="pmcAvailablePanel">
                                @if (!Model.AvailablePmcCodes.Any())
                                {
                                    <div class="pkg-no-codes" id="pmcNoCodes">No available PMC codes. Build one above and click Register.</div>
                                }
                                <div id="pmcCodesList">
                                    @foreach (var c in Model.AvailablePmcCodes)
                                    {
                                        <div class="pkg-code-item" data-codeid="@c.Id">
                                            <input type="radio" name="availableCodeRadio" class="form-check-input flex-shrink-0"
                                                   value="@c.Id" style="pointer-events:none;">
                                            <span class="pkg-code-item-code font-monospace">@c.Code</span>
                                            <span class="pkg-code-item-meta">@c.CreatedBy &middot; @c.CreatedAt.ToString("yyyy-MM-dd")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div id="ddnAvailablePanel" style="display:none;">
                                @if (!Model.AvailableDdnCodes.Any())
                                {
                                    <div class="pkg-no-codes" id="ddnNoCodes">No available DDN codes. Build one above and click Register.</div>
                                }
                                <div id="ddnCodesList">
                                    @foreach (var c in Model.AvailableDdnCodes)
                                    {
                                        <div class="pkg-code-item" data-codeid="@c.Id">
                                            <input type="radio" name="availableCodeRadio" class="form-check-input flex-shrink-0"
                                                   value="@c.Id" style="pointer-events:none;">
                                            <span class="pkg-code-item-code font-monospace">@c.Code</span>
                                            <span class="pkg-code-item-meta">@c.CreatedBy &middot; @c.CreatedAt.ToString("yyyy-MM-dd")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-text mt-2">Output filename: <span id="pkgFilenameSample" class="fw-semibold text-muted">select a code above</span></div>
                    </div>

                    <!-- ── OEM Logo ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-image me-1"></i>OEM Logo
                        </div>
                        <div class="d-flex align-items-start gap-3 flex-wrap">
                            <div class="flex-grow-1" style="max-width:360px;">
                                <select id="ietpLogoSelect" class="form-select">
                                    <option value="">— No logo —</option>
                                    @foreach (var img in Model.PngLogos)
                                    {
                                        <option value="@img.Id" data-name="@img.Name">@img.Name (@img.FileName)</option>
                                    }
                                </select>
                                <div class="form-text">PNG images from Manage → Images</div>
                            </div>
                            <!-- Logo preview -->
                            <div id="ietpLogoPreview" class="pub-logo-preview" style="display:none;">
                                <img id="ietpLogoImg" src="" alt="Logo preview" />
                            </div>
                        </div>
                    </div>

                    <!-- ── Security ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-lock me-1"></i>Security
                        </div>
                        <div class="d-flex gap-4">
                            <div class="form-check pub-radio-card" id="secureCard">
                                <input class="form-check-input" type="radio" name="ietpSecurity"
                                       id="ietpSecured" value="Secured" checked>
                                <label class="form-check-label" for="ietpSecured">
                                    <i class="fa-solid fa-lock me-1 text-warning"></i>
                                    <span class="fw-semibold">Secured</span>
                                    <div class="pub-radio-desc">NAV file will be access-controlled</div>
                                </label>
                            </div>
                            <div class="form-check pub-radio-card" id="unsecureCard">
                                <input class="form-check-input" type="radio" name="ietpSecurity"
                                       id="ietpUnsecured" value="Unsecured">
                                <label class="form-check-label" for="ietpUnsecured">
                                    <i class="fa-solid fa-lock-open me-1 text-success"></i>
                                    <span class="fw-semibold">Unsecured</span>
                                    <div class="pub-radio-desc">NAV file will be openly accessible</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Publication Status ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-tag me-1"></i>Publication Status
                        </div>
                        <div class="d-flex gap-4">
                            <div class="form-check pub-radio-card" id="draftCard">
                                <input class="form-check-input" type="radio" name="ietpStatus"
                                       id="ietpDraft" value="Draft" checked>
                                <label class="form-check-label" for="ietpDraft">
                                    <i class="fa-solid fa-pencil me-1 text-secondary"></i>
                                    <span class="fw-semibold">Draft</span>
                                    <div class="pub-radio-desc">Marked as a work-in-progress issue</div>
                                </label>
                            </div>
                            <div class="form-check pub-radio-card" id="finalCard">
                                <input class="form-check-input" type="radio" name="ietpStatus"
                                       id="ietpFinal" value="Final">
                                <label class="form-check-label" for="ietpFinal">
                                    <i class="fa-solid fa-circle-check me-1 text-success"></i>
                                    <span class="fw-semibold">Final</span>
                                    <div class="pub-radio-desc">Marked as an approved final release</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Cover Page (HTML) ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-file-code me-1"></i>Cover Page
                        </div>

                        <!-- Option 1: Upload -->
                        <div class="pub-html-option @("active")" id="htmlOptUpload">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="ietpHtmlSource"
                                       id="htmlSrcUpload" value="upload" checked>
                                <label class="form-check-label fw-semibold" for="htmlSrcUpload">
                                    Upload HTML page
                                </label>
                            </div>
                            <div id="htmlUploadPanel" class="pub-html-panel ps-4">
                                <div class="mb-3">
                                    <label class="form-label small">HTML file <span class="text-danger">*</span></label>
                                    <input type="file" id="ietpHtmlFile" class="form-control form-control-sm"
                                           accept=".html,.htm">
                                    <div class="form-text">Single .html or .htm file</div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Associated images / assets</label>
                                    <input type="file" id="ietpHtmlAssets" class="form-control form-control-sm"
                                           accept="image/*,.css,.js" multiple>
                                    <div class="form-text">PNG, JPG, GIF, SVG, CSS, or JS files referenced by the HTML</div>
                                </div>
                                <!-- Asset list preview -->
                                <div id="ietpAssetList" class="pub-asset-list" style="display:none;">
                                    <div class="pub-asset-list-title">Attached files</div>
                                    <ul id="ietpAssetItems" class="list-unstyled mb-0"></ul>
                                </div>
                            </div>
                        </div>

                        <!-- Option 2: Template -->
                        <div class="pub-html-option mt-3" id="htmlOptTemplate">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="ietpHtmlSource"
                                       id="htmlSrcTemplate" value="template">
                                <label class="form-check-label fw-semibold" for="htmlSrcTemplate">
                                    Use HTML template
                                </label>
                            </div>
                            <div id="htmlTemplatePanel" class="pub-html-panel ps-4" style="display:none;">
                                <div class="pub-coming-soon">
                                    <i class="fa-solid fa-clock me-2 text-muted"></i>
                                    Template generation will be available in a future update.
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- /pub-section-grid -->

                <!-- ── Publish action ── -->
                <div class="pub-actions">
                    <div id="pubIetpAlert" class="pub-alert" style="display:none;"></div>
                    <button id="btnPublishIetp" class="btn btn-primary btn-publish" disabled>
                        <i class="fa-solid fa-rocket me-2"></i>Publish IETP
                    </button>
                    <span id="pubIetpSpinner" class="spinner-border spinner-border-sm text-primary ms-2"
                          style="display:none;" role="status"></span>
                </div>

            </div><!-- /pane-ietp -->
            } @* end CanPublishIetp *@

            <!-- ══════════════════ PDF TAB ══════════════════ -->
            @if (Model.CanExportPdf)
            {
            <div class="tab-pane fade @(firstTab == "pdf" ? "show active" : "")" id="pane-pdf" role="tabpanel" aria-labelledby="tab-pdf">
                <div class="pub-section-grid">

                    <!-- ── Publication Status ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-tag me-1"></i>Publication Status
                        </div>
                        <div class="d-flex gap-4">
                            <div class="form-check pub-radio-card" id="pdfDraftCard">
                                <input class="form-check-input" type="radio" name="pdfStatus"
                                       id="pdfDraft" value="Draft" checked>
                                <label class="form-check-label" for="pdfDraft">
                                    <i class="fa-solid fa-pencil me-1 text-secondary"></i>
                                    <span class="fw-semibold">Draft</span>
                                    <div class="pub-radio-desc">DRAFT watermark applied to each page</div>
                                </label>
                            </div>
                            <div class="form-check pub-radio-card" id="pdfFinalCard">
                                <input class="form-check-input" type="radio" name="pdfStatus"
                                       id="pdfFinal" value="Final">
                                <label class="form-check-label" for="pdfFinal">
                                    <i class="fa-solid fa-circle-check me-1 text-success"></i>
                                    <span class="fw-semibold">Final</span>
                                    <div class="pub-radio-desc">Clean output with no watermark</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Stylesheet ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-code me-1"></i>Stylesheet
                        </div>
                        <div style="max-width:480px;">
                            <select id="pdfStylesheetSelect" class="form-select">
                                <option value="">— Built-in default (print_all_pages.xslt) —</option>
                                @foreach (var s in Model.PdfStylesheets)
                                {
                                    <option value="@s.Id">@s.Name (@s.FileName)</option>
                                }
                            </select>
                            <div class="form-text">
                                Uploaded stylesheets are managed in
                                <a href="/Manage" target="_blank">Manage → Stylesheet</a>.
                                @if (!Model.PdfStylesheets.Any())
                                {
                                    <span class="text-muted"> No custom stylesheets uploaded yet.</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ── About ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-circle-info me-1"></i>About PDF Export
                        </div>
                        <p class="text-muted mb-0" style="font-size:13px;">
                            Exports all data modules for the selected project as a single PDF using
                            Apache FOP. The output is transformed by the selected stylesheet
                            and requires Java&nbsp;8+ to be installed on the server.
                        </p>
                    </div>

                </div><!-- /pub-section-grid -->

                <!-- ── Export action ── -->
                <div class="pub-actions">
                    <div id="pubPdfAlert" class="pub-alert" style="display:none;"></div>
                    <button id="btnExportPdf" class="btn btn-primary btn-publish" disabled>
                        <i class="fa-solid fa-file-pdf me-2"></i>Export PDF
                    </button>
                    <span id="pubPdfSpinner" class="spinner-border spinner-border-sm text-primary ms-2"
                          style="display:none;" role="status"></span>
                    <span id="pubPdfNote" class="text-muted ms-2" style="font-size:12px; display:none;">
                        Generating PDF — this may take a minute…
                    </span>
                </div>
            </div>
            } @* end CanExportPdf *@

            <!-- ══════════════════ LICENSE TAB ══════════════════ -->
            @if (Model.CanManageLicense)
            {
            <div class="tab-pane fade @(firstTab == "license" ? "show active" : "")" id="pane-license" role="tabpanel" aria-labelledby="tab-license">
                <div class="pub-section-grid">

                    <!-- ── Provider Key ── -->
                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-fingerprint me-1"></i>Provider Key
                        </div>
                        <p class="text-muted mb-3" style="font-size:13px;">
                            This portal's unique identity key. It is embedded in every <strong>Secured</strong>
                            .nav package so the NavIETM<sup>®</sup> Viewer can tie the package back to this installation.
                            Share it with the Viewer administrator to enable license activation.
                        </p>

                        @if (Model.ProviderKey != null)
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                                <div class="lic-key-box">
                                    <input type="password" id="providerKeyInput" class="lic-key-input form-control font-monospace"
                                           value="@Model.ProviderKey" readonly autocomplete="off" />
                                    <button class="btn btn-sm btn-outline-secondary lic-key-reveal" id="btnRevealKey"
                                            title="Show / hide key">
                                        <i class="fa-solid fa-eye" id="revealIcon"></i>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" id="btnCopyKey" title="Copy to clipboard">
                                    <i class="fa-solid fa-copy me-1"></i>Copy
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="pub-coming-soon mb-3">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                No key yet. Publish a <strong>Secured</strong> IETP package to generate one automatically.
                            </div>
                        }

                        <button class="btn btn-sm btn-outline-danger" id="btnRegenKey"
                                @(Model.ProviderKey == null ? "" : "")>
                            <i class="fa-solid fa-rotate me-1"></i>Regenerate Key
                        </button>
                        <div class="form-text mt-1 text-danger-emphasis">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            Regenerating invalidates all previously published Secured packages.
                        </div>
                    </div>

                </div><!-- /pub-section-grid -->
            </div><!-- /pane-license -->
            } @* end CanManageLicense (license) *@

            <!-- ══════════════════ PUBLISHED PACKAGES TAB ══════════════════ -->
            @if (Model.CanManageLicense)
            {
            <div class="tab-pane fade" id="pane-packages" role="tabpanel" aria-labelledby="tab-packages">
                <div class="pub-section-grid">

                    <div class="pub-section">
                        <div class="pub-section-title">
                            <i class="fa-solid fa-boxes-stacked me-1"></i>Package Code Registry
                        </div>
                        <p class="text-muted mb-3" style="font-size:13px;">
                            All registered PMC and DDN codes. Once registered a code is permanent and
                            can only be consumed by a single publish operation.
                        </p>

                        @if (!Model.AllPackageCodes.Any())
                        {
                            <div class="pub-coming-soon">
                                <i class="fa-solid fa-inbox me-1"></i>No package codes registered yet.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm reg-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Code</th>
                                            <th>Status</th>
                                            <th class="text-center">Secured</th>
                                            <th class="text-center">Issue</th>
                                            <th>Created By</th>
                                            <th>Created</th>
                                            <th>Published By</th>
                                            <th>Published</th>
                                            <th>License Key</th>
                                            <th>Package</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in packageRows)
                                        {
                                            <tr data-licid="@(row.License?.Id ?? 0)">
                                                <td>
                                                    @if (row.Code.CodeType == "PMC")
                                                    {
                                                        <span class="badge bg-primary">PMC</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info text-dark">DDN</span>
                                                    }
                                                </td>
                                                <td class="font-monospace" style="font-size:12px;">@row.Code.Code</td>
                                                <td>
                                                    @if (row.Code.IsPublished)
                                                    {
                                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Published</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary"><i class="fa-solid fa-clock me-1"></i>Available</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (row.License != null)
                                                    {
                                                        @if (row.License.IsSecured)
                                                        {
                                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-lock me-1"></i>Secured</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success"><i class="fa-solid fa-lock-open me-1"></i>Open</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (row.License != null)
                                                    {
                                                        @if (row.License.IsTrial)
                                                        {
                                                            <span class="badge bg-secondary">Draft</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-primary">Final</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td style="font-size:12px;">@row.Code.CreatedBy</td>
                                                <td style="font-size:12px; white-space:nowrap;">@row.Code.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td style="font-size:12px;">@(row.Code.PublishedBy ?? "—")</td>
                                                <td style="font-size:12px; white-space:nowrap;">
                                                    @(row.Code.PublishedAt.HasValue ? row.Code.PublishedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                                                </td>
                                                <td>
                                                    @if (row.License != null)
                                                    {
                                                        <input type="text" class="form-control form-control-sm lic-key-field font-monospace"
                                                               value="@row.License.LicenseKey"
                                                               placeholder="Not activated"
                                                               maxlength="50" style="min-width:140px;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (row.Code.IsPublished && row.Code.PackageFilename != null)
                                                    {
                                                        @if (Model.PackageFileStatus.ContainsKey(row.Code.Id) && Model.PackageFileStatus[row.Code.Id])
                                                        {
                                                            <a href="/Publisher/DownloadNavPackage?id=@row.Code.Id"
                                                               class="btn btn-sm btn-outline-secondary"
                                                               title="Download @row.Code.PackageFilename">
                                                                <i class="fa-solid fa-download me-1"></i><span style="font-size:11px;">@row.Code.PackageFilename</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted" style="font-size:12px;">
                                                                <i class="fa-solid fa-triangle-exclamation text-danger me-1"></i>@row.Code.PackageFilename
                                                                <br /><small class="text-danger">File deleted</small>
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (row.License != null)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary btn-save-lickey" title="Save license key">
                                                            <i class="fa-solid fa-floppy-disk"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                </div><!-- /pub-section-grid -->
            </div><!-- /pane-packages -->
            } @* end CanManageLicense (packages) *@

        </div><!-- /tab-content -->
    </div><!-- /pub-body -->
} @* end hasAny *@

</div><!-- /pub-shell -->

@section Scripts {
<style>
/* ── Publisher shell ── */
.pub-shell {
    max-width: 860px;
    margin: 0 auto;
    padding: 28px 24px 48px;
}

.pub-header { margin-bottom: 24px; }
.pub-header-title { font-size: 20px; font-weight: 700; color: var(--text); }
.pub-header-sub   { font-size: 13px; color: var(--text-muted); margin-top: 2px; }

/* ── Project bar ── */
.pub-project-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 20px;
}
.pub-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
}
.pub-project-select { max-width: 460px; }

/* ── Tabs ── */
.pub-tabs .nav-link { font-size: 14px; font-weight: 500; }
.pub-body {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
}
.pub-tab-content { padding: 24px; }

/* ── Section ── */
.pub-section-grid { display: flex; flex-direction: column; gap: 28px; }
.pub-section { }
.pub-section-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
}

/* ── Radio cards ── */
.pub-radio-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    min-width: 180px;
}
.pub-radio-card:has(.form-check-input:checked) {
    border-color: var(--primary-light);
    background: #eff6ff;
}
.pub-radio-card .form-check-input { margin-top: 3px; }
.pub-radio-desc { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

/* ── Logo preview ── */
.pub-logo-preview {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    background: #f9fafb;
    width: 120px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.pub-logo-preview img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

/* ── HTML options ── */
.pub-html-option { }
.pub-html-panel { margin-top: 8px; }

/* ── Asset list ── */
.pub-asset-list {
    background: #f9fafb;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 14px;
    margin-top: 8px;
    max-height: 160px;
    overflow-y: auto;
}
.pub-asset-list-title { font-size: 11px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
.pub-asset-list li { font-size: 12px; padding: 2px 0; display: flex; align-items: center; gap: 8px; }
.pub-asset-list li .fa-times { cursor: pointer; color: var(--danger); }

/* ── Coming soon ── */
.pub-coming-soon {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    padding: 20px 0;
}

/* ── Actions ── */
.pub-actions {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
}
.btn-publish { min-width: 160px; }
.pub-alert {
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 6px;
}
.pub-alert.success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
.pub-alert.error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

/* ── License tab ── */
.lic-key-box {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 480px;
    flex: 1;
}
.lic-key-input {
    padding-right: 42px;
    font-size: 12px;
    letter-spacing: 0.04em;
}
.lic-key-reveal {
    position: absolute;
    right: 6px;
    border: none;
    background: transparent;
    padding: 2px 6px;
    color: var(--text-muted);
}
.lic-key-reveal:hover { color: var(--text); }
.lic-table th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
}
.lic-table td { vertical-align: middle; }

/* ── Package code builder ── */
.pkg-builder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    padding: 14px 16px;
    background: #f9fafb;
    border: 1px solid var(--border);
    border-radius: 8px;
}
.pkg-code-preview {
    display: flex;
    align-items: center;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 6px;
    padding: 7px 14px;
}
.pkg-code-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    white-space: nowrap;
}
.pkg-code-preview code {
    font-size: 13px;
    color: #0369a1;
    letter-spacing: 0.03em;
    word-break: break-all;
}

/* ── Available code list ── */
.pkg-codes-section {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
}
.pkg-codes-header {
    background: #f9fafb;
    border-bottom: 1px solid var(--border);
    padding: 8px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}
.pkg-codes-title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
}
.pkg-code-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    cursor: pointer;
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.12s;
    user-select: none;
}
.pkg-code-item:last-child { border-bottom: none; }
.pkg-code-item:hover { background: #f0f9ff; }
.pkg-code-item.selected {
    background: #eff6ff;
    border-left: 3px solid var(--primary);
    padding-left: 11px;
}
.pkg-code-item-code { flex: 1; font-size: 13px; }
.pkg-code-item-meta { font-size: 11px; color: var(--text-muted); white-space: nowrap; }
.pkg-no-codes { padding: 16px 14px; text-align: center; font-size: 13px; color: var(--text-muted); }

/* ── Package code registry table ── */
.reg-table th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
}
.reg-table td { vertical-align: middle; }
</style>

<script type="text/javascript">

    // ── Nav link ──
    $("#adminlink, #configlink, #mainlink, #icnlink").removeClass("active");
    $("#publisherlink").addClass("active");

    // ── Enable publish/export buttons when a project is selected ──
    $("#pubProjectSelect").on("change", function () {
        var hasProject = !!$(this).val();
        $("#btnExportPdf").prop("disabled", !hasProject);
        // Auto-fill MI from the project's data-mi attribute
        var mi = $(this).find(":selected").data("mi") || "";
        $("#pmcMi").val(mi);
        $("#ddnMi").val(mi);
        _updatePmcPreview();
        _updateDdnPreview();
        _updateFilenameSample();
        _updatePublishButtonState();
    });

    // ── Package type radio cards ──
    $("input[name='ietpPackageType']").on("change", function () {
        var pkg = $(this).val();
        $("#pmcBuilderPanel").toggle(pkg === "PMC");
        $("#ddnBuilderPanel").toggle(pkg === "DDN");
        $("#pmcAvailablePanel").toggle(pkg === "PMC");
        $("#ddnAvailablePanel").toggle(pkg === "DDN");
        _updateFilenameSample();
        _updatePublishButtonState();
    });

    // ── Builder field changes → live preview + filename ──
    $("#pmcMi, #pmcIssuingAuth, #pmcNumber, #pmcVolume").on("input", function () {
        _updatePmcPreview();
        _updateFilenameSample();
    });
    $("#ddnMi, #ddnSenderNcage, #ddnReceiverNcage, #ddnYear, #ddnSeqNr").on("input", function () {
        _updateDdnPreview();
        _updateFilenameSample();
    });

    function _updatePmcPreview() {
        var parts = [
            $("#pmcMi").val()          || "MI",
            $("#pmcIssuingAuth").val() || "AAAAA",
            $("#pmcNumber").val()      || "NNNNN",
            $("#pmcVolume").val()      || "VV"
        ];
        $("#pmcCodePreview").text("PMC-" + parts.join("-"));
    }

    function _updateDdnPreview() {
        var parts = [
            $("#ddnMi").val()           || "MI",
            $("#ddnSenderNcage").val()  || "SSSSS",
            $("#ddnReceiverNcage").val()|| "RRRRR",
            $("#ddnYear").val()         || new Date().getFullYear(),
            $("#ddnSeqNr").val()        || "NNNNN"
        ];
        $("#ddnCodePreview").text("DDN-" + parts.join("-"));
    }

    function _buildPackageCode() {
        var pkg = $("input[name='ietpPackageType']:checked").val() || "PMC";
        if (pkg === "PMC") {
            return "PMC-" + [
                $("#pmcMi").val()          || "MI",
                $("#pmcIssuingAuth").val() || "AAAAA",
                $("#pmcNumber").val()      || "NNNNN",
                $("#pmcVolume").val()      || "VV"
            ].join("-");
        } else {
            return "DDN-" + [
                $("#ddnMi").val()           || "MI",
                $("#ddnSenderNcage").val()  || "SSSSS",
                $("#ddnReceiverNcage").val()|| "RRRRR",
                $("#ddnYear").val()         || new Date().getFullYear(),
                $("#ddnSeqNr").val()        || "NNNNN"
            ].join("-");
        }
    }

    function _updateFilenameSample() {
        var selected = $(".pkg-code-item.selected .pkg-code-item-code").first().text().trim();
        if (selected) {
            $("#pkgFilenameSample").text(selected + ".nav").removeClass("text-muted");
        } else {
            var code = _buildPackageCode();
            $("#pkgFilenameSample").text(code + ".nav").addClass("text-muted");
        }
    }

    function _updatePublishButtonState() {
        var hasProject = !!$("#pubProjectSelect").val();
        var hasCode    = !!$("input[name='availableCodeRadio']:checked").val();
        $("#btnPublishIetp").prop("disabled", !hasProject || !hasCode);
    }

    // ── Available code item click → select ──
    $(document).on("click", ".pkg-code-item", function () {
        var $list = $(this).closest("#pmcCodesList, #ddnCodesList");
        $list.find(".pkg-code-item").removeClass("selected")
             .find("input[type='radio']").prop("checked", false);
        $(this).addClass("selected")
               .find("input[type='radio']").prop("checked", true);
        _updateFilenameSample();
        _updatePublishButtonState();
    });

    // ── Register a new code ──
    $("#btnRegisterCode").on("click", function () {
        var pkg  = $("input[name='ietpPackageType']:checked").val() || "PMC";
        var code = _buildPackageCode();
        var $btn = $(this).prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Registering…');
        var $st  = $("#regCodeStatus").text("").removeClass("text-success text-danger");

        $.post("/Publisher/RegisterPackageCode", { code: code, codeType: pkg })
            .done(function (res) {
                if (res.success) {
                    $st.addClass("text-success").text("✓ " + res.code + " registered");
                    var listId = pkg === "PMC" ? "#pmcCodesList" : "#ddnCodesList";
                    var noId   = pkg === "PMC" ? "#pmcNoCodes"   : "#ddnNoCodes";
                    $(noId).hide();
                    $(listId).find(".pkg-code-item").removeClass("selected")
                             .find("input[type='radio']").prop("checked", false);
                    var safeCode = $("<span>").text(res.code).html();
                    var safeBy   = $("<span>").text(res.createdBy).html();
                    $(listId).prepend(
                        '<div class="pkg-code-item selected" data-codeid="' + res.id + '">' +
                        '<input type="radio" name="availableCodeRadio" class="form-check-input flex-shrink-0"' +
                        ' value="' + res.id + '" checked style="pointer-events:none;">' +
                        '<span class="pkg-code-item-code font-monospace">' + safeCode + '</span>' +
                        '<span class="pkg-code-item-meta">' + safeBy + ' &middot; ' + res.createdAt + '</span>' +
                        '</div>'
                    );
                    _updateFilenameSample();
                    _updatePublishButtonState();
                } else {
                    $st.addClass("text-danger").text(res.message || "Registration failed.");
                }
            })
            .fail(function () {
                $st.addClass("text-danger").text("An error occurred. Please try again.");
            })
            .always(function () {
                $btn.prop("disabled", false).html('<i class="fa-solid fa-plus me-1"></i>Register Code');
            });
    });

    _updatePmcPreview();
    _updateDdnPreview();
    _updateFilenameSample();
    _updatePublishButtonState();

    // ── OEM Logo preview ──
    $("#ietpLogoSelect").on("change", function () {
        var id = $(this).val();
        if (!id) {
            $("#ietpLogoPreview").hide();
            $("#ietpLogoImg").attr("src", "");
            return;
        }
        $("#ietpLogoImg").attr("src", "/Manage/ViewImageAsset?id=" + id);
        $("#ietpLogoPreview").show();
    });

    // ── HTML source toggle ──
    $("input[name='ietpHtmlSource']").on("change", function () {
        var val = $(this).val();
        $("#htmlUploadPanel").toggle(val === "upload");
        $("#htmlTemplatePanel").toggle(val === "template");
    });

    // ── Asset file list ──
    $("#ietpHtmlAssets").on("change", function () {
        var files = this.files;
        var $list = $("#ietpAssetItems").empty();
        if (!files || !files.length) {
            $("#ietpAssetList").hide();
            return;
        }
        $.each(files, function (i, f) {
            $list.append(
                '<li><i class="fa-solid fa-paperclip text-muted"></i>' +
                '<span>' + $("<span>").text(f.name).html() + '</span>' +
                '<span class="text-muted ms-auto">(' + _fmtSize(f.size) + ')</span></li>'
            );
        });
        $("#ietpAssetList").show();
    });

    function _fmtSize(bytes) {
        if (bytes < 1024)       return bytes + ' B';
        if (bytes < 1048576)    return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
    }

    // ── Publish IETP ──
    $("#btnPublishIetp").on("click", function () {
        var projectId = $("#pubProjectSelect").val();
        if (!projectId) {
            _showPubAlert("error", "Please select a project before publishing.");
            return;
        }

        var selectedCodeId = $("input[name='availableCodeRadio']:checked").val();
        if (!selectedCodeId) {
            _showPubAlert("error", "Please select a registered package code from the Available Codes list.");
            return;
        }

        var htmlSource = $("input[name='ietpHtmlSource']:checked").val();
        if (htmlSource === "upload") {
            var htmlFile = $("#ietpHtmlFile")[0].files;
            if (!htmlFile || !htmlFile.length) {
                _showPubAlert("error", "Please select an HTML file to upload.");
                return;
            }
        }

        _showPubAlert("", "");
        $("#pubIetpSpinner").show();
        $("#btnPublishIetp").prop("disabled", true);

        var formData = new FormData();
        formData.append("projectId",      projectId);
        formData.append("packageType",    $("input[name='ietpPackageType']:checked").val() || "PMC");
        formData.append("selectedCodeId", selectedCodeId);
        formData.append("logoId",         $("#ietpLogoSelect").val() || "");
        formData.append("security",    $("input[name='ietpSecurity']:checked").val());
        formData.append("status",      $("input[name='ietpStatus']:checked").val());
        formData.append("htmlSource",  htmlSource);

        if (htmlSource === "upload") {
            formData.append("htmlFile", $("#ietpHtmlFile")[0].files[0]);
            $.each($("#ietpHtmlAssets")[0].files, function (i, f) {
                formData.append("assets", f);
            });
        }

        // Use XHR directly so we can handle both file download (blob) and JSON error responses
        var xhr = new XMLHttpRequest();
        xhr.open("POST", "/Publisher/PublishIetp", true);
        xhr.responseType = "blob";
        xhr.onload = function () {
            $("#pubIetpSpinner").hide();
            _updatePublishButtonState();
            if (xhr.status === 200) {
                // Try to detect a JSON error response (content-type check)
                var ct = xhr.getResponseHeader("Content-Type") || "";
                if (ct.indexOf("application/json") !== -1) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        try {
                            var obj = JSON.parse(reader.result);
                            _showPubAlert("error", obj.message || "Publish failed.");
                        } catch (e) {
                            _showPubAlert("error", "Publish failed.");
                        }
                    };
                    reader.readAsText(xhr.response);
                } else {
                    // It's the .nav file — trigger browser download
                    var cd = xhr.getResponseHeader("Content-Disposition") || "";
                    var fnMatch = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    var filename = fnMatch ? fnMatch[1].replace(/['"]/g, "") : "package.nav";
                    var url = window.URL.createObjectURL(xhr.response);
                    var a = document.createElement("a");
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);
                    _showPubAlert("success", "Published successfully. Download starting…");
                    // Remove the consumed code from the available list
                    $(".pkg-code-item[data-codeid='" + selectedCodeId + "']").fadeOut(400, function () { $(this).remove(); });
                    _updatePublishButtonState();
                }
            } else {
                _showPubAlert("error", "Server error (" + xhr.status + "). Please try again.");
            }
        };
        xhr.onerror = function () {
            $("#pubIetpSpinner").hide();
            _updatePublishButtonState();
            _showPubAlert("error", "An error occurred. Please try again.");
        };
        xhr.send(formData);
    });

    function _showPubAlert(type, msg) {
        var $a = $("#pubIetpAlert");
        if (!type || !msg) { $a.hide().attr("class", "pub-alert"); return; }
        $a.attr("class", "pub-alert " + type).text(msg).show();
    }

    // ── PDF tab: Export PDF ──
    $("#btnExportPdf").on("click", function () {
        var projectId = $("#pubProjectSelect").val();
        if (!projectId) {
            _showPdfAlert("error", "Please select a project before exporting.");
            return;
        }

        _showPdfAlert("", "");
        $("#pubPdfSpinner").show();
        $("#pubPdfNote").show();
        $("#btnExportPdf").prop("disabled", true);

        var formData = new FormData();
        formData.append("projectId",    projectId);
        formData.append("status",       $("input[name='pdfStatus']:checked").val());
        formData.append("stylesheetId", $("#pdfStylesheetSelect").val() || "");

        var xhr = new XMLHttpRequest();
        xhr.open("POST", "/Publisher/ExportPdf", true);
        xhr.responseType = "blob";
        xhr.onload = function () {
            $("#pubPdfSpinner").hide();
            $("#pubPdfNote").hide();
            $("#btnExportPdf").prop("disabled", !$("#pubProjectSelect").val());

            if (xhr.status === 200) {
                var ct = xhr.getResponseHeader("Content-Type") || "";
                if (ct.indexOf("application/json") !== -1) {
                    var reader = new FileReader();
                    reader.onload = function () {
                        try {
                            var obj = JSON.parse(reader.result);
                            _showPdfAlert("error", obj.message || "Export failed.");
                        } catch (e) { _showPdfAlert("error", "Export failed."); }
                    };
                    reader.readAsText(xhr.response);
                } else {
                    var cd  = xhr.getResponseHeader("Content-Disposition") || "";
                    var fnM = cd.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    var fn  = fnM ? fnM[1].replace(/['"]/g, "") : "export.pdf";
                    var url = window.URL.createObjectURL(xhr.response);
                    var a   = document.createElement("a");
                    a.href = url; a.download = fn;
                    document.body.appendChild(a); a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);
                    _showPdfAlert("success", "PDF exported successfully. Download starting…");
                }
            } else {
                _showPdfAlert("error", "Server error (" + xhr.status + "). Please try again.");
            }
        };
        xhr.onerror = function () {
            $("#pubPdfSpinner").hide();
            $("#pubPdfNote").hide();
            $("#btnExportPdf").prop("disabled", !$("#pubProjectSelect").val());
            _showPdfAlert("error", "An error occurred. Please try again.");
        };
        xhr.send(formData);
    });

    function _showPdfAlert(type, msg) {
        var $a = $("#pubPdfAlert");
        if (!type || !msg) { $a.hide().attr("class", "pub-alert"); return; }
        $a.attr("class", "pub-alert " + type).text(msg).show();
    }

    // ── License tab: reveal / hide provider key ──
    $("#btnRevealKey").on("click", function () {
        var $inp = $("#providerKeyInput");
        var reveal = $inp.attr("type") === "password";
        $inp.attr("type", reveal ? "text" : "password");
        $("#revealIcon").toggleClass("fa-eye", !reveal).toggleClass("fa-eye-slash", reveal);
    });

    // ── License tab: copy provider key ──
    $("#btnCopyKey").on("click", function () {
        var key = $("#providerKeyInput").val();
        if (!key) return;
        navigator.clipboard.writeText(key).then(function () {
            var $btn = $("#btnCopyKey");
            $btn.html('<i class="fa-solid fa-check me-1"></i>Copied');
            setTimeout(function () {
                $btn.html('<i class="fa-solid fa-copy me-1"></i>Copy');
            }, 2000);
        });
    });

    // ── License tab: regenerate provider key (confirm first) ──
    $("#btnRegenKey").on("click", function () {
        if (!confirm(
            "Regenerating the provider key will invalidate ALL existing Secured .nav packages.\n\n" +
            "Viewers that have already activated a package will lose access until re-activated.\n\n" +
            "Are you sure you want to continue?")) return;

        var $btn = $(this).prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i>Regenerating…');
        $.post("/Publisher/RegenerateProviderKey", function (res) {
            if (res.success) {
                $("#providerKeyInput").val(res.key).attr("type", "password");
                $("#revealIcon").removeClass("fa-eye-slash").addClass("fa-eye");
                alert("Provider key regenerated successfully.");
            } else {
                alert("Failed to regenerate key. Please try again.");
            }
        }).always(function () {
            $btn.prop("disabled", false).html('<i class="fa-solid fa-rotate me-1"></i>Regenerate Key');
        });
    });

    // ── License tab: save license key for a package ──
    $(document).on("click", ".btn-save-lickey", function () {
        var $row  = $(this).closest("tr");
        var licId = $row.data("licid");
        var key   = $row.find(".lic-key-field").val().trim();
        var $btn  = $(this).prop("disabled", true);

        $.post("/Publisher/SaveLicenseKey", { id: licId, licenseKey: key }, function (res) {
            if (res.success) {
                $btn.html('<i class="fa-solid fa-check"></i>');
                setTimeout(function () {
                    $btn.html('<i class="fa-solid fa-floppy-disk"></i>');
                }, 2000);
            } else {
                alert(res.message || "Save failed.");
            }
        }).always(function () {
            $btn.prop("disabled", false);
        });
    });

</script>
}
