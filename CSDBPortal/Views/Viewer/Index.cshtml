@model CSDBPortal.ViewModels.ViewerViewModel
@{
    ViewData["Title"] = "Viewer";
}

@if (!Model.CanView)
{
<div class="row mt-4">
    <div class="col-12">
        <div class="card p-4 text-center text-muted">
            <i class="fa-solid fa-lock fa-2x mb-3 d-block"></i>
            You do not have permission to access the Viewer.<br>
            Contact your administrator to request access.
        </div>
    </div>
</div>
}
else
{

<!-- ── Viewer shell ── -->
<div class="vwr-shell">

    <!-- Project selector bar -->
    <div class="vwr-project-bar">
        <label class="vwr-label" for="vwrProjectSelect">
            <i class="fa-solid fa-folder-open me-1"></i>Project
        </label>
        <select id="vwrProjectSelect" class="form-select vwr-project-select">
            <option value="">— Select a project —</option>
            @foreach (var p in Model.Projects)
            {
                <option value="@p.Id">@p.Name — @p.Title</option>
            }
        </select>
        <span id="vwrLoadingSpinner" class="spinner-border spinner-border-sm text-primary ms-2" style="display:none;"></span>
    </div>

    <!-- Two-panel body -->
    <div class="vwr-body">

        <!-- Left: navigation tree -->
        <aside class="vwr-nav" id="vwrNav">
            <div class="vwr-nav-header">
                <i class="fa-solid fa-sitemap me-1"></i>Navigation
                <span id="vwrNavCount" class="badge bg-secondary ms-1" style="font-size:10px; display:none;"></span>
            </div>
            <div id="vwrNavEmpty" class="vwr-nav-empty">
                <i class="fa-solid fa-hand-pointer fa-lg d-block mb-2 text-muted"></i>
                Select a project above
            </div>
            <div id="vwrTree" class="vwr-tree-container" style="display:none;"></div>
        </aside>

        <!-- Resizer handle -->
        <div class="vwr-resizer" id="vwrResizer"></div>

        <!-- Right: content panel -->
        <main class="vwr-content" id="vwrContent">

            <!-- DMC header bar (hidden until a module is loaded) -->
            <div class="vwr-content-header" id="vwrContentHeader" style="display:none;">
                <div class="vwr-dmc-label">
                    <i class="fa-solid fa-file-code me-1 text-primary"></i>
                    <span id="vwrDmcCode" class="font-monospace" style="font-size:12px;"></span>
                </div>
                <div class="vwr-dmc-title" id="vwrDmcTitle"></div>
                <div class="vwr-content-actions ms-auto">
                    <button class="btn btn-sm btn-outline-secondary" id="btnWrapXml" title="Toggle word-wrap">
                        <i class="fa-solid fa-text-width"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary ms-1" id="btnCopyXml" title="Copy XML">
                        <i class="fa-solid fa-copy"></i>
                    </button>
                </div>
            </div>

            <!-- Placeholder -->
            <div class="vwr-content-placeholder" id="vwrPlaceholder">
                <i class="fa-solid fa-eye fa-2x text-muted mb-3 d-block"></i>
                <div class="text-muted">Select a data module from the navigation tree</div>
            </div>

            <!-- XML display -->
            <div class="vwr-xml-wrapper" id="vwrXmlWrapper" style="display:none;">
                <pre class="vwr-xml-pre" id="vwrXmlPre"></pre>
            </div>

        </main>
    </div>
</div>

} @* end CanView *@

@section Scripts {
<style>
/* ── Viewer shell ─────────────────────────────────────────────────── */
.vwr-shell {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 68px);
    background: #f4f5f7;
    overflow: hidden;
}

/* ── Project bar ──────────────────────────────────────────────────── */
.vwr-project-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: #fff;
    border-bottom: 1px solid #dee2e6;
    flex-shrink: 0;
}
.vwr-label {
    font-size: 13px;
    font-weight: 600;
    color: #495057;
    white-space: nowrap;
}
.vwr-project-select {
    max-width: 420px;
    font-size: 13px;
    height: 34px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ── Body (nav + content) ─────────────────────────────────────────── */
.vwr-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
}

/* ── Navigation panel ─────────────────────────────────────────────── */
.vwr-nav {
    width: 290px;
    min-width: 160px;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-right: 1px solid #dee2e6;
    overflow: hidden;
    flex-shrink: 0;
}
.vwr-nav-header {
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: #6c757d;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    flex-shrink: 0;
}
.vwr-nav-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    font-size: 13px;
    color: #adb5bd;
}
.vwr-tree-container {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0;
}

/* jqTree overrides for the viewer */
.vwr-tree-container ul.jqtree-tree {
    margin: 0;
    padding-left: 0;
}
.vwr-tree-container .jqtree-element {
    font-size: 12.5px;
    padding: 3px 8px;
    cursor: pointer;
    border-radius: 3px;
    margin: 1px 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
}
.vwr-tree-container .jqtree-element:hover {
    background: #e9ecef;
}
.vwr-tree-container li.jqtree_common.jqtree-selected > .jqtree-element {
    background: #0d6efd;
    color: #fff;
}
.vwr-tree-container li.jqtree_common.jqtree-selected > .jqtree-element .jqtree-toggler {
    color: #fff;
}

/* ── Resizer ──────────────────────────────────────────────────────── */
.vwr-resizer {
    width: 5px;
    cursor: col-resize;
    background: #dee2e6;
    flex-shrink: 0;
    transition: background .15s;
}
.vwr-resizer:hover, .vwr-resizer.dragging {
    background: #0d6efd;
}

/* ── Content panel ────────────────────────────────────────────────── */
.vwr-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
}
.vwr-content-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    flex-shrink: 0;
    flex-wrap: wrap;
}
.vwr-dmc-label {
    white-space: nowrap;
}
.vwr-dmc-title {
    font-size: 13px;
    font-weight: 600;
    color: #343a40;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}
.vwr-content-actions {
    display: flex;
    align-items: center;
}
.vwr-content-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #adb5bd;
    font-size: 13px;
}
.vwr-xml-wrapper {
    flex: 1;
    overflow: auto;
}
.vwr-xml-pre {
    margin: 0;
    padding: 16px 20px;
    font-size: 12px;
    font-family: 'Consolas', 'Cascadia Code', 'Monaco', monospace;
    line-height: 1.6;
    white-space: pre;
    background: #fff;
    border: none;
    color: #212529;
    min-height: 100%;
}
.vwr-xml-pre.wrap { white-space: pre-wrap; word-break: break-all; }

/* XML syntax colouring */
.xml-el    { color: #0550ae; }
.xml-attr  { color: #953800; }
.xml-val   { color: #116329; }
.xml-cmt   { color: #57606a; font-style: italic; }
.xml-pi    { color: #6639ba; }
.xml-cdata { color: #82071e; }
</style>

<script type="text/javascript">
/* ── Helpers ─────────────────────────────────────────────────── */
function escHtml(s) {
    return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

/* Pretty-print + syntax-colour XML */
function syntaxXml(raw) {
    if (!raw || !raw.trim()) return '<span class="text-muted">— no XML content —</span>';

    // 1. Parse and re-serialise with indentation
    let formatted = '';
    try {
        const parser = new DOMParser();
        const doc    = parser.parseFromString(raw, 'application/xml');
        const err    = doc.querySelector('parsererror');
        if (!err) {
            formatted = xmlToString(doc.documentElement, 0);
        } else {
            formatted = escHtml(raw);   // fall back to raw
        }
    } catch (e) {
        formatted = escHtml(raw);
    }

    // 2. Apply colour tokens
    return formatted
        // XML declaration / PI  <?...?>
        .replace(/(&lt;\?)([\s\S]*?)(\?&gt;)/g,
            '<span class="xml-pi">$1$2$3</span>')
        // Comments  <!-- ... -->
        .replace(/(&lt;!--)([\s\S]*?)(--&gt;)/g,
            '<span class="xml-cmt">$1$2$3</span>')
        // CDATA
        .replace(/(&lt;!\[CDATA\[)([\s\S]*?)(\]\]&gt;)/g,
            '<span class="xml-cdata">$1$2$3</span>')
        // Closing tags  </tag>
        .replace(/(&lt;\/)([\w:.-]+)(&gt;)/g,
            '$1<span class="xml-el">$2</span>$3')
        // Self-closing + opening tags with possible attributes
        .replace(/(&lt;)([\w:.-]+)((?:\s[^&]*)?)(\/?&gt;)/g, (m, lt, tag, attrs, gt) => {
            const colouredAttrs = attrs.replace(
                /([\w:.-]+)(=&quot;)([^&quot;]*)(&quot;)/g,
                '<span class="xml-attr">$1</span>$2<span class="xml-val">$3</span>$4'
            );
            return lt + '<span class="xml-el">' + tag + '</span>' + colouredAttrs + gt;
        });
}

/* Recursive XML → indented escaped string */
function xmlToString(node, depth) {
    const ind  = '  '.repeat(depth);
    const ind1 = '  '.repeat(depth + 1);
    let   out  = '';

    if (node.nodeType === Node.TEXT_NODE) {
        const t = node.textContent.trim();
        return t ? ind + escHtml(t) + '\n' : '';
    }
    if (node.nodeType === Node.COMMENT_NODE) {
        return ind + escHtml('<!--' + node.textContent + '-->') + '\n';
    }
    if (node.nodeType === Node.CDATA_SECTION_NODE) {
        return ind + escHtml('<![CDATA[' + node.textContent + ']]>') + '\n';
    }
    if (node.nodeType !== Node.ELEMENT_NODE) return '';

    // Build opening tag
    let attrs = '';
    for (const a of node.attributes) {
        attrs += ' ' + escHtml(a.name) + '=&quot;' + escHtml(a.value) + '&quot;';
    }

    const children = Array.from(node.childNodes)
        .filter(c => c.nodeType !== Node.TEXT_NODE || c.textContent.trim());

    if (children.length === 0) {
        // Self-closing or empty
        const txt = node.textContent.trim();
        if (txt) {
            out = ind + '&lt;' + escHtml(node.tagName) + attrs + '&gt;'
                + escHtml(txt)
                + '&lt;/' + escHtml(node.tagName) + '&gt;\n';
        } else {
            out = ind + '&lt;' + escHtml(node.tagName) + attrs + ' /&gt;\n';
        }
    } else {
        out = ind + '&lt;' + escHtml(node.tagName) + attrs + '&gt;\n';
        for (const child of node.childNodes) {
            out += xmlToString(child, depth + 1);
        }
        out += ind + '&lt;/' + escHtml(node.tagName) + '&gt;\n';
    }
    return out;
}

/* ── Navigation tree builder ─────────────────────────────────── */
function buildTreeData(nodes) {
    return nodes.map(n => ({
        name    : n.title || n.dmc || '(unnamed)',
        id      : n.id,
        dmcId   : n.dmcId,
        dmc     : n.dmc,
        title   : n.title,
        children: n.children && n.children.length ? buildTreeData(n.children) : []
    }));
}

/* ── State ───────────────────────────────────────────────────── */
var currentDmcId = null;

/* ── Project selection ───────────────────────────────────────── */
$('#vwrProjectSelect').on('change', function () {
    const pid = $(this).val();
    $('#vwrTree').empty().hide();
    $('#vwrNavEmpty').show();
    $('#vwrNavCount').hide();
    clearContent();

    if (!pid) return;

    $('#vwrLoadingSpinner').show();

    $.ajax({
        type    : 'POST',
        url     : '/Viewer/GetNavTree',
        data    : { projectId: pid },
        dataType: 'json',
        success : function (result) {
            $('#vwrLoadingSpinner').hide();

            if (!result || result.length === 0) {
                $('#vwrNavEmpty').text('No data modules in this project.').show();
                return;
            }

            const treeData = buildTreeData(result);

            $('#vwrNavEmpty').hide();
            $('#vwrTree').show().tree({
                data    : treeData,
                autoOpen: 1,       // open first level only
                selectable: true,
                onCreateLi: function (node, $li) {
                    // Add icon prefix
                    $li.find('.jqtree-element').prepend(
                        '<i class="fa-solid fa-file-code me-1" style="font-size:11px; opacity:.65;"></i>'
                    );
                }
            });

            // Flat count (all leaf nodes = modules)
            const count = result.reduce(function countAll(acc, n) {
                return acc + 1 + (n.children ? n.children.reduce(countAll, 0) : 0);
            }, 0);
            $('#vwrNavCount').text(count).show();

            // Click handler
            $('#vwrTree').on('tree.click', function (e) {
                e.preventDefault();
                const node = e.node;
                if (!node || !node.dmcId) return;
                loadModule(node.dmcId, node.dmc, node.title);
            });
        },
        error: function () {
            $('#vwrLoadingSpinner').hide();
            $('#vwrNavEmpty').text('Failed to load navigation tree.').show();
        }
    });
});

/* ── Load a data module ──────────────────────────────────────── */
function loadModule(dmcId, dmc, title) {
    currentDmcId = dmcId;
    clearContent();

    $('#vwrPlaceholder').html(
        '<div class="spinner-border text-primary" role="status"></div>' +
        '<div class="mt-2 text-muted" style="font-size:13px;">Loading…</div>'
    ).show();

    $.ajax({
        type    : 'GET',
        url     : '/Viewer/GetModule',
        data    : { id: dmcId },
        dataType: 'json',
        success : function (m) {
            // Header
            $('#vwrDmcCode').text(m.dmc || dmc || '');
            $('#vwrDmcTitle').text(m.title || title || '');
            $('#vwrContentHeader').show();

            // XML panel
            $('#vwrPlaceholder').hide();
            const html = syntaxXml(m.xml);
            $('#vwrXmlPre').html(html);
            $('#vwrXmlWrapper').show();
        },
        error: function () {
            $('#vwrPlaceholder').html(
                '<i class="fa-solid fa-triangle-exclamation fa-lg text-danger mb-2 d-block"></i>' +
                '<div class="text-danger" style="font-size:13px;">Failed to load module.</div>'
            ).show();
        }
    });
}

function clearContent() {
    $('#vwrContentHeader').hide();
    $('#vwrXmlWrapper').hide();
    $('#vwrXmlPre').html('');
    $('#vwrPlaceholder').html(
        '<i class="fa-solid fa-eye fa-2x text-muted mb-3 d-block"></i>' +
        '<div class="text-muted">Select a data module from the navigation tree</div>'
    ).show();
}

/* ── Word-wrap toggle ────────────────────────────────────────── */
$('#btnWrapXml').on('click', function () {
    $('#vwrXmlPre').toggleClass('wrap');
    $(this).toggleClass('active btn-outline-secondary btn-secondary');
});

/* ── Copy XML ────────────────────────────────────────────────── */
$('#btnCopyXml').on('click', function () {
    const pre = document.getElementById('vwrXmlPre');
    navigator.clipboard.writeText(pre.innerText).then(() => {
        const btn = $(this);
        btn.html('<i class="fa-solid fa-check"></i>');
        setTimeout(() => btn.html('<i class="fa-solid fa-copy"></i>'), 1500);
    });
});

/* ── Resize handle ───────────────────────────────────────────── */
(function () {
    const resizer = document.getElementById('vwrResizer');
    const nav     = document.getElementById('vwrNav');
    if (!resizer || !nav) return;

    let startX, startW;

    resizer.addEventListener('mousedown', function (e) {
        startX = e.clientX;
        startW = nav.offsetWidth;
        resizer.classList.add('dragging');
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup',   onUp);
        e.preventDefault();
    });

    function onMove(e) {
        const w = Math.min(600, Math.max(160, startW + (e.clientX - startX)));
        nav.style.width = w + 'px';
    }
    function onUp() {
        resizer.classList.remove('dragging');
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup',   onUp);
    }
})();

/* ── Sidebar active link ─────────────────────────────────────── */
$("#adminlink, #configlink, #mainlink, #icnlink, #publisherlink").removeClass("active");
$("#viewerlink").addClass("active");
</script>
}
