@using CSDBPortal.ViewModels
@model AdministrationViewModel
@{
    ViewData["Title"] = "Administration";
}

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa-solid fa-folder-open"></i></div>
        <div>
            <div class="stat-value">@Model.ProjectCompleted</div>
            <div class="stat-label">Projects Completed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple"><i class="fa-solid fa-users"></i></div>
        <div>
            <div class="stat-value">@Model.UserCount</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa-solid fa-user-check"></i></div>
        <div>
            <div class="stat-value">@Model.ActiveUsers</div>
            <div class="stat-label">Active Users</div>
        </div>
    </div>
</div>

<!-- Dashboard grid: Quick Access + Activity -->
<div class="dashboard-grid mb-4">

    <!-- Quick Access -->
    <div class="ui-card">
        <div class="ui-card-header" style="display:flex;align-items:center;justify-content:space-between;">
            <span class="ui-card-title"><i class="fa-solid fa-bolt" style="color:#d97706"></i> Quick Access</span>
            <button class="btn btn-sm btn-outline-secondary" id="btnCustomiseQA" title="Customise Quick Access" style="font-size:11px;padding:3px 8px;">
                <i class="fa-solid fa-gear"></i> Customise
            </button>
        </div>
        <div class="ui-card-body">
            <div class="quick-grid" id="quickAccessGrid">
                @foreach (var item in Model.QuickAccessItems)
                {
                    <a href="@item.Href" class="quick-item">
                        <i class="@item.IconClass" style="color:@item.IconColor"></i>
                        <span>@item.Title</span>
                    </a>
                }
                @if (!Model.QuickAccessItems.Any())
                {
                    <p class="text-muted" style="font-size:12px;grid-column:1/-1;text-align:center;padding:8px 0;">
                        No items enabled. Click <strong>Customise</strong> to add shortcuts.
                    </p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="ui-card">
        <div class="ui-card-header">
            <span class="ui-card-title"><i class="fa-solid fa-clock-rotate-left" style="color:#7c3aed"></i> Recent Activity</span>
        </div>
        <div class="ui-card-body" style="padding-top:8px;padding-bottom:8px">
            <div class="activity-item">
                <div class="activity-dot green"></div>
                <div>
                    <div class="activity-text">User management updated</div>
                    <div class="activity-time">Just now</div>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-dot blue"></div>
                <div>
                    <div class="activity-text">New ICN generated</div>
                    <div class="activity-time">1 hour ago</div>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-dot amber"></div>
                <div>
                    <div class="activity-text">Configure settings saved</div>
                    <div class="activity-time">3 hours ago</div>
                </div>
            </div>
        </div>
    </div>

</div>

@if (User.HasClaim("Permission", Features.UserAndRoleAdministration))
{
    <!-- Tab navigation -->
    <ul class="nav nav-pills tab-header mb-3" id="pills-tab" role="tablist">
        <li class="nav-item item-one" role="presentation">
            <a class="nav-link active" id="pills-tab-1" data-bs-toggle="pill" href="#pills-1">
                <i class="fa-solid fa-user-gear"></i>
                <span>Users</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="pills-tab-3" data-bs-toggle="pill" href="#pills-2">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Roles</span>
            </a>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">

        <!-- Users tab -->
        <div class="tab-pane fade show active" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
            <div class="actions mb-3 text-end">
                <a href="#" class="btn" id="btnCreateUser">
                    <i class="fas fa-plus"></i> Create User
                </a>
            </div>
            <div class="card" style="padding:0">
                <div class="table-responsive">
                    <table id="userTable" class="table table-bordered mb-0">
                        <thead class="thead text-center">
                            <tr>
                                <th style="display:none">Id</th>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>Phone Number</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Users)
                            {
                                <tr>
                                    <td style="display:none">@m.Id</td>
                                    <td><strong>@m.UserName</strong></td>
                                    <td>@m.Email</td>
                                    <td>@m.PhoneNumber</td>
                                    <td>
                                        <a class="btn edit_button editUser"><i class="fa-solid fa-pen"></i> Edit</a>
                                        <a class="btn deleteBtn deleteUser"><i class="fa-solid fa-trash"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Roles tab -->
        <div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
            <div class="actions mb-3 text-end">
                <a href="#" class="btn" id="btnCreateRole">
                    <i class="fas fa-plus"></i> Create Role
                </a>
            </div>
            <div class="card" style="padding:0">
                <div class="table-responsive">
                    <table id="roleTable" class="table table-bordered mb-0">
                        <thead class="thead text-center">
                            <tr>
                                <th style="display:none">Id</th>
                                <th>Role Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Roles)
                            {
                                <tr>
                                    <td style="display:none">@m.Id</td>
                                    <td><strong>@m.Name</strong></td>
                                    <td>
                                        <a class="btn edit_button eidtRole"><i class="fa-solid fa-pen"></i> Edit</a>
                                        <a class="btn deleteBtn deleteRole"><i class="fa-solid fa-trash"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
}

<!-- ══ Role Modal ══ -->
<div class="modal fade" id="rolemdl" data-backdrop="true" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title modelRoleTitle">Create Role</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label id="errorRoleMsg" style="color:var(--danger);font-size:12px;"></label>
                <input class="form-control" type="hidden" id="hdnRoleId" />
                <div class="form-group mb-3">
                    <label class="form-label">Role Name <span style="color:var(--danger)">*</span></label>
                    <input class="form-control" type="text" id="txtRoleName" placeholder="Enter role name" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Features</label>
                    @Html.ListBox("FeatureListBox", new SelectList(Model.Features), new { @class = "form-control" })
                    <div class="form-text text-muted" style="font-size:11px;">Hold Ctrl / Cmd to select multiple.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                <button id="btnRoleSave" class="btn btn-primary">Save Role</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ User Modal ══ -->
<div class="modal fade" id="usermdl" data-backdrop="true" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title modelUserTitle">Create User</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label id="errorUserMsg" style="color:var(--danger);font-size:12px;"></label>
                <input class="form-control" type="hidden" id="hdnUserId" />
                <div class="form-group mb-3">
                    <label class="form-label">User Name <span style="color:var(--danger)">*</span></label>
                    <input class="form-control" type="text" id="txtUserName" placeholder="Enter username" />
                </div>
                <div class="form-group mb-3" id="passwordGroup">
                    <label class="form-label" id="lblPassword">Password <span id="spnStar" style="color:var(--danger)">*</span></label>
                    <input class="form-control" type="password" id="txtPassword" placeholder="Enter password" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Email <span style="color:var(--danger)">*</span></label>
                    <input class="form-control" type="text" id="txtEmail" placeholder="user@example.com" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Phone Number</label>
                    <input class="form-control" type="text" id="txtPhoneNumber" placeholder="Optional" />
                </div>
                <div class="form-group mb-2">
                    <label class="form-label">Roles</label>
                    @Html.ListBox("RolesListBox", new SelectList(Model.Roles, "Id", "Name"), new { @class = "form-control" })
                    <div class="form-text text-muted" style="font-size:11px;">Hold Ctrl / Cmd to select multiple.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                <button id="btnUserSave" class="btn btn-primary">Save User</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Quick Access Config Modal ══ -->
<div class="modal fade" id="qaConfigModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-gear me-2"></i>Customise Quick Access</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3" style="font-size:12px;">
                    Toggle shortcuts on or off and use the arrows to reorder them.
                </p>
                <div id="qaConfigBody">
                    <div class="text-center py-3 text-muted"><i class="fa-solid fa-spinner fa-spin"></i> Loading…</div>
                </div>
                <div id="qaConfigMsg" class="mt-2 small text-danger" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveQA">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jquery.confirmModal.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {

            // Persist active tab across page loads
            var activeTab = localStorage.getItem('activeAdminTab');
            if (activeTab) {
                var tabEl = document.querySelector('#pills-tab a[href="' + activeTab + '"]');
                if (tabEl) { bootstrap.Tab.getOrCreateInstance(tabEl).show(); }
            }

            document.querySelectorAll('#pills-tab a[data-bs-toggle="pill"]').forEach(function (el) {
                el.addEventListener('shown.bs.tab', function (e) {
                    localStorage.setItem('activeAdminTab', e.target.getAttribute('href'));
                });
            });
        });

        $("#adminlink").addClass("active");
        $("#configlink").removeClass("active");
        $("#mainlink").removeClass("active");
        $("#icnlink").removeClass("active");

        $(".btn-close, .modelCancel").click(function () {
            $("#rolemdl").modal('hide');
            $("#usermdl").modal('hide');
        });

        // ── Roles ──
        $("#btnCreateRole").click(function () {
            $('#hdnRoleId').val('0');
            $('#txtRoleName').val('');
            $("#btnRoleSave").html("Save Role");
            $(".modelRoleTitle").html("Create Role");
            $("#errorRoleMsg").html('');
            var modal = new bootstrap.Modal(document.getElementById('rolemdl'));
            modal.show();
        });

        $("#btnRoleSave").click(function () {
            if ($('#txtRoleName').val() == '') {
                $('#txtRoleName').css('border-color', 'var(--danger)');
                return false;
            } else {
                $('#txtRoleName').css('border-color', '');
            }

            var role = {};
            role.Id = $('#hdnRoleId').val();
            role.Name = $('#txtRoleName').val();

            var features = [];
            $('#FeatureListBox > option:selected').each(function () {
                features.push($(this).text());
            });

            $.ajax({
                type: "POST",
                url: "Administration/CreateRole",
                data: { role: role, features: features },
                dataType: "json",
                success: function (data) {
                    if (data == 'Duplicate') {
                        $("#errorRoleMsg").html("Duplicate record.");
                        bootstrap.Modal.getInstance(document.getElementById('rolemdl')).show();
                    } else {
                        bootstrap.Modal.getInstance(document.getElementById('rolemdl')).hide();
                        location.reload();
                    }
                }
            });
        });

        $('#roleTable tbody').on('click', '.eidtRole', function () {
            var rowobj = $(this).closest("tr");
            var id   = rowobj.find("td:eq(0)").text();
            var name = rowobj.find("td:eq(1)").text();

            $("#txtRoleName").val(name);
            $("#hdnRoleId").val(id);
            $("#btnRoleSave").html("Update Role");
            $(".modelRoleTitle").html("Edit Role");

            $.ajax({
                type: "POST",
                url: "Administration/GetFeature",
                data: { roleId: id },
                dataType: "json",
                success: function (result) {
                    $('#FeatureListBox > option:selected').each(function () {
                        $(this).removeAttr("selected");
                    });
                    result.forEach(function (e) {
                        $("#FeatureListBox option:contains(" + e + ")").attr('selected', 'selected');
                    });
                }
            });

            var modal = new bootstrap.Modal(document.getElementById('rolemdl'));
            modal.show();
        });

        $('#roleTable tbody').on('click', '.deleteRole', function () {
            var Id = $(this).closest("tr").find("td:eq(0)").text();
            $.confirmModal('Are you sure you want to delete this role?', { messageHeader: 'Delete Role' }, function (el) {
                $.ajax({
                    type: "POST",
                    url: "Administration/DeleteRole",
                    data: { id: Id },
                    dataType: "json",
                    success: function () { location.reload(); }
                });
            });
        });

        // ── Users ──
        $("#btnCreateUser").click(function () {
            $('#hdnUserId').val('0');
            $('#txtUserName').val('');
            $('#txtPassword').val('');
            $('#txtEmail').val('');
            $('#txtPhoneNumber').val('');
            $('#txtPassword').show();
            $('#lblPassword').show();
            $('#spnStar').show();
            $("#btnUserSave").html("Save User");
            $(".modelUserTitle").html("Create User");
            $("#errorUserMsg").html('');
            var modal = new bootstrap.Modal(document.getElementById('usermdl'));
            modal.show();
        });

        $('#userTable tbody').on('click', '.editUser', function () {
            var rowobj     = $(this).closest("tr");
            var id          = rowobj.find("td:eq(0)").text();
            var userName    = rowobj.find("td:eq(1)").text();
            var email       = rowobj.find("td:eq(2)").text();
            var phoneNumber = rowobj.find("td:eq(3)").text();

            $('#hdnUserId').val(id);
            $('#txtUserName').val(userName);
            $('#txtPassword').val('UpdatedPassword').hide();
            $('#lblPassword').hide();
            $('#spnStar').hide();
            $('#txtEmail').val(email);
            $('#txtPhoneNumber').val(phoneNumber);
            $("#btnUserSave").html("Update User");
            $(".modelUserTitle").html("Edit User");

            $.ajax({
                type: "POST",
                url: "Administration/GetRoles",
                data: { userId: id },
                dataType: "json",
                success: function (result) {
                    $('#RolesListBox > option:selected').each(function () {
                        $(this).removeAttr("selected");
                    });
                    result.forEach(function (e) {
                        $("#RolesListBox option:contains(" + e + ")").attr('selected', 'selected');
                    });
                }
            });

            var modal = new bootstrap.Modal(document.getElementById('usermdl'));
            modal.show();
        });

        $("#btnUserSave").click(function () {
            if ($('#txtUserName').val() == '') {
                $('#txtUserName').css('border-color', 'var(--danger)'); return false;
            } else { $('#txtUserName').css('border-color', ''); }

            if ($('#txtPassword').is(':visible') && $('#txtPassword').val() == '') {
                $('#txtPassword').css('border-color', 'var(--danger)'); return false;
            } else { $('#txtPassword').css('border-color', ''); }

            if ($('#txtEmail').val() == '') {
                $('#txtEmail').css('border-color', 'var(--danger)'); return false;
            } else { $('#txtEmail').css('border-color', ''); }

            var user   = {};
            var update = false;
            if ($('#hdnUserId').val() != "0") {
                user.Id = $('#hdnUserId').val();
                update  = true;
            }

            user.UserName    = $('#txtUserName').val();
            user.Email       = $('#txtEmail').val();
            user.PhoneNumber = $('#txtPhoneNumber').val();

            var roles = [];
            $('#RolesListBox > option:selected').each(function () {
                roles.push($(this).text());
            });

            $.ajax({
                type: "POST",
                url: "Administration/CreateUser",
                data: { user: user, roles: roles, update: update },
                headers: { "Authorization": "Basic " + btoa($('#txtUserName').val() + ":" + $('#txtPassword').val()) },
                dataType: "json",
                success: function (result) {
                    if (result.succeeded == false) {
                        var msg = "<ul style='padding-left:18px;margin:0'>";
                        result.errors.forEach(function (e) {
                            msg += "<li>" + e.code + ": " + e.description + "</li>";
                        });
                        msg += "</ul>";
                        $("#errorUserMsg").html(msg);
                        bootstrap.Modal.getInstance(document.getElementById('usermdl')).show();
                    } else {
                        bootstrap.Modal.getInstance(document.getElementById('usermdl')).hide();
                        location.reload();
                    }
                }
            });
        });

        $('#userTable tbody').on('click', '.deleteUser', function () {
            var Id = $(this).closest("tr").find("td:eq(0)").text();
            $.confirmModal('Are you sure you want to delete this user?', { messageHeader: 'Delete User' }, function (el) {
                $.ajax({
                    type: "POST",
                    url: "Administration/DeleteUser",
                    data: { id: Id },
                    dataType: "json",
                    success: function (result) {
                        if (result.succeeded == false) {
                            var msg = "<ul style='padding-left:18px;margin:0'>";
                            result.errors.forEach(function (e) {
                                msg += "<li>" + e.code + ": " + e.description + "</li>";
                            });
                            msg += "</ul>";
                            $("#errorUserMsg").html(msg);
                            bootstrap.Modal.getInstance(document.getElementById('usermdl')).show();
                        } else {
                            location.reload();
                        }
                    }
                });
            });
        });

        // ── Quick Access Customise ────────────────────────────────────────
        $('#btnCustomiseQA').on('click', function () {
            $.get('/Administration/GetQuickAccessConfig', function (items) {
                var html = '<ul class="qa-config-list" id="qaConfigList">';
                $.each(items, function (i, item) {
                    html += '<li class="qa-config-item" data-id="' + item.id + '" data-sort="' + item.sortOrder + '">'
                          + '<div class="qa-config-left">'
                          + '<input type="checkbox" class="qa-toggle form-check-input" id="qaChk' + item.id + '"' + (item.isActive ? ' checked' : '') + '>'
                          + '<i class="' + item.iconClass + ' ms-2 me-1" style="color:' + item.iconColor + '"></i>'
                          + '<label class="form-check-label ms-1" for="qaChk' + item.id + '" style="font-size:13px;cursor:pointer;">' + item.title + '</label>'
                          + '</div>'
                          + '<div class="qa-config-arrows">'
                          + '<button type="button" class="btn btn-sm btn-outline-secondary qa-up py-0 px-1"><i class="fa-solid fa-chevron-up fa-xs"></i></button>'
                          + '<button type="button" class="btn btn-sm btn-outline-secondary qa-down py-0 px-1 ms-1"><i class="fa-solid fa-chevron-down fa-xs"></i></button>'
                          + '</div>'
                          + '</li>';
                });
                html += '</ul>';
                $('#qaConfigBody').html(html);
                $('#qaConfigMsg').hide();
                $('#btnSaveQA').prop('disabled', false).text('Save');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('qaConfigModal')).show();
            }, 'json');
        });

        // Up / Down reorder
        $(document).on('click', '.qa-up', function () {
            var $li = $(this).closest('.qa-config-item');
            var $prev = $li.prev('.qa-config-item');
            if ($prev.length) $li.insertBefore($prev);
            updateQaSortValues();
        });
        $(document).on('click', '.qa-down', function () {
            var $li = $(this).closest('.qa-config-item');
            var $next = $li.next('.qa-config-item');
            if ($next.length) $li.insertAfter($next);
            updateQaSortValues();
        });
        function updateQaSortValues() {
            $('#qaConfigList .qa-config-item').each(function (i) {
                $(this).attr('data-sort', i + 1);
            });
        }

        // Save
        $('#btnSaveQA').on('click', function () {
            var payload = [];
            $('#qaConfigList .qa-config-item').each(function (i) {
                payload.push({
                    id:        parseInt($(this).attr('data-id')),
                    isActive:  $(this).find('.qa-toggle').is(':checked'),
                    sortOrder: i + 1
                });
            });
            $('#btnSaveQA').prop('disabled', true).text('Saving…');
            $.ajax({
                type: 'POST',
                url: '/Administration/SaveQuickAccessConfig',
                data: JSON.stringify(payload),
                contentType: 'application/json',
                success: function (data) {
                    if (data.status) {
                        bootstrap.Modal.getInstance(document.getElementById('qaConfigModal')).hide();
                        location.reload();
                    } else {
                        $('#qaConfigMsg').show().text(data.message || 'Save failed.');
                        $('#btnSaveQA').prop('disabled', false).text('Save');
                    }
                },
                error: function () {
                    $('#qaConfigMsg').show().text('An error occurred.');
                    $('#btnSaveQA').prop('disabled', false).text('Save');
                }
            });
        });

    </script>
}
