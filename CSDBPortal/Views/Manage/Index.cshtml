            $('#btnCheckinSubmit').on('click', function () {
                var file = $('#checkinFile')[0].files[0];
                if (!file) {
                    $('#checkinMessage').show().removeClass('text-success').addClass('text-danger').text('Please select a file.');
                    return;
                }

                var formData = new FormData();
                formData.append('dmcId', checkinDmcId);
                formData.append('file', file);

                $('#btnCheckinSubmit').prop('disabled', true).text('Checking in...');

                $.ajax({
                    type: 'POST',
                    url: '/Manage/CheckinDMC',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
