                if (!res.status) { alert('Could not load stylesheet.'); return; }
                $('#ssEditName').val(res.name);
                $('#ssEditRemarks').val(res.remarks || '');

                // Init or refresh CodeMirror
                if (!ssEditor) {
                    ssEditor = CodeMirror(document.getElementById('ssCodeEditorWrapper'), {
                        value: res.content || '',
                        mode: 'xml',
                        theme: 'eclipse',
                        lineNumbers: true,
                        lineWrapping: false,
                        autoCloseTags: true,
                        matchBrackets: true,
                        foldGutter: true,
                        gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter'],
                        extraKeys: {
                            'Ctrl-F': 'findPersistent',
                            'Ctrl-H': 'replace',
                            'Ctrl-Z': 'undo',
                            'Ctrl-Y': 'redo'
                        }
                    });
                    document.getElementById('ssCodeEditor').style.display = 'none';
                    // Set height
                    ssEditor.setSize(null, '500px');
                } else {
                    ssEditor.setValue(res.content || '');
                }
                ssEditor.clearHistory();
                $('#ssEditorStatus').text('');
                $('#ssEditModal').modal('show');
                setTimeout(function () { ssEditor.refresh(); }, 300);
