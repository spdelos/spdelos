@section Scripts {

    <!-- CodeMirror for XSLT editing -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closetag.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/xml-fold.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/searchcursor.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/search.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.js"></script>
    <link  rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.css" />

    <script type="text/javascript">

        // Activate a specific tab when redirected from another page (e.g. ?tab=projects)
        (function () {
            var params = new URLSearchParams(window.location.search);
            var tab = params.get('tab');
            if (tab === 'projects') {
                var el = document.getElementById('pills-tab-5');
                if (el) bootstrap.Tab.getOrCreateInstance(el).show();
            }
        })();

        var selectedProject = 0;
        var selectedSNS;
        var currentNodeText;
        // TODO: replace "Administrator" with the specific role(s) authorised to edit Brex Rules
        var canEditBrexRules = @Json.Serialize(User.IsInRole("Administrator"));

        var data = [];
        @foreach (var d in Model.StandardNumberingSystems)
        {
            @:var obj = { "id": @d.Id, "parent_id": @d.parent_id, "title": "@d.title", "level": @d.level };
            @:data.push(obj);
        }

        function showBranchChildren($branch) {
            if ($branch.hasClass("sns-collapsed")) return;
            $branch.getChildren().each(function () {
                $(this).show();
                showBranchChildren($(this));
            });
        }

        function refreshToggleButtons(treeSelector) {
            $(treeSelector + ' .tree-branch').each(function () {
                var hasKids = $(this).getDescendants().length > 0;
                $(this).find('> .contents .toggle-branch')
                       .css('visibility', hasKids ? 'visible' : 'hidden');
            });
        }

        function loadProjectSnsTree(projectId) {
            $.ajax({
                type: "POST",
                url: "Manage/GetProjectSns",
                data: { projectId: projectId },
                dataType: "json",
                success: function (result) {
                    if (!result || result.length === 0) {
                        $("#projectSnsTree").empty();
                        $("#projectSnsEmpty").show();
                    } else {
                        $("#projectSnsEmpty").hide();
                        var sp = new TreeSortable("#projectSnsTree");
                        var cp = result.map(sp.createBranch);
                        $("#projectSnsTree").html(cp.join(''));
                        sp.run();
                        refreshToggleButtons("#projectSnsTree");
                        $("#projectSnsTree .create-dmc").hide();

                        // Auto-save parent when a node is dragged to a new position
                        $(document).off("sortCompleted.projectSns");
                        $(document).on("sortCompleted.projectSns", function (event, ui) {
                            if ($(ui.item).closest('#projectSnsTree').length === 0) return;
                            var nodeId        = parseInt($(ui.item).data('id'));
                            var newParentSnsId = parseInt($(ui.item).data('parent')) || 0;
                            $.ajax({
                                type: "POST",
                                url: "Manage/MoveProjectSns",
                                data: { snsId: nodeId, newParentSnsId: newParentSnsId, projectId: selectedProject },
                                dataType: "json",
                                error: function () { alert('Failed to save the new node position.'); }
                            });
                        });
                    }
                }
            });
        }

        var sortable = new TreeSortable("#tree");
        var content = data.map(sortable.createBranch);
        $("#tree").html(content.join(''));
        sortable.run();
        refreshToggleButtons("#tree");

        const delay = () => {
            return new Promise(resolve => {
                setTimeout(() => {
                    resolve();
                }, 1000);
            });
        };

        sortable.onSortCompleted(async (event, ui) => {
            await delay();
            console.log(ui.item);
        });

        function showAlertProjectNavigationModel(status, message) {
            $('#alertMessageProjectNavigationModel').text(message);

            if (status == true) {
                $('.alertProjectNavigationModel').removeClass("alert-warning");
                $('.alertProjectNavigationModel').addClass("alert-success");
                $('.alertProjectNavigationModel').fadeIn().fadeOut(3000);
            }
            else {
                $('.alertProjectNavigationModel').removeClass("alert-success");
                $('.alertProjectNavigationModel').addClass("alert-warning");
                $('.alertProjectNavigationModel').fadeIn().fadeOut(3000);
            }
        }

        function showAlert(status, message) {
            $('#alertMessage').text(message);

            if (status == true) {
                $('.alert').removeClass("alert-warning");
                $('.alert').addClass("alert-success");
                $('.alert').fadeIn().fadeOut(3000, function () {
                    location.reload();
                });
            }
            else {
                $('.alert').removeClass("alert-success");
                $('.alert').addClass("alert-warning");
                $('.alert').fadeIn().fadeOut(3000);
            }
        }

        function refreshProjectNavigationTree(obj) {
            $('#projectNavigationTree').tree('loadData', obj);
        }

        function BuildNavigationTree(children) {
            var jsonObj = [];
            children.forEach(function (e) {

                if ($('input[name=dmctype]:checked').val() == "dmc") {
                    jsonObj.push({ "name": e.dmc, "dmcId": e.dmcId, "dmc": e.dmc, "title": e.title, "id": e.id, "children": ((e.children === undefined) ? [] : BuildNavigationTree(e.children)) });
                }
                else {
                    jsonObj.push({ "name": e.title, "dmcId": e.dmcId, "dmc": e.dmc, "title": e.title, "id": e.id, "children": ((e.children === undefined) ? [] : BuildNavigationTree(e.children)) });
                }
            });
            return jsonObj;
        }

        function populateNavigationTree() {
            var navigationTreeDataString = $('#projectNavigationTree').tree('toJson');
            var navigationTreeData = JSON.parse(navigationTreeDataString);

            var jsonObj = BuildNavigationTree(navigationTreeData);

            refreshProjectNavigationTree(jsonObj);
        }

        function handleStop(node, e) {

            if ($('input[name=dmctype]:checked').val() == "dmc") {
                $(".editTitle").hide();
            }
            else {
                $(".editTitle").show();
            }
        }

        var responsiblePartnerCodes = [];
        $(document).ready(function () {

            // Activate first (or stored) tab on page load
            var activeMaintTab = localStorage.getItem('activeMaintTab');
            var maintTrigger = (activeMaintTab && document.querySelector('#pills-tab [href="' + activeMaintTab + '"]'))
                || document.querySelector('#pills-tab [data-bs-toggle="tab"]');
            if (maintTrigger) bootstrap.Tab.getOrCreateInstance(maintTrigger).show();

            document.querySelectorAll('#pills-tab [data-bs-toggle="tab"]').forEach(function (el) {
                el.addEventListener('shown.bs.tab', function (e) {
                    localStorage.setItem('activeMaintTab', e.target.getAttribute('href'));
                });
            });

            $(document).on("click", ".add-child", function (e) {
                var selectedParent = $(this).getSelectedBranch();
                var isProjectSns = $(this).closest('#projectSnsModel').length > 0;

                if (isProjectSns) {
                    $('#pSnsId').val('0');
                    $('#pSnsCode').val('');
                    $('#pSnsDescription').val('');
                    $('#pSnsParentId').val(selectedParent.dataset.id);
                    var parentTitle = $(selectedParent).find('.branch-title').first().text().trim();
                    $('#pSnsFormHint').text('Adding child under: ' + parentTitle);
                    $('#pSnsCodeError').hide().text('Code is required');
                    $('#pSnsFormPanel').slideDown(150, function () { $('#pSnsCode').focus(); });
                } else {
                    $("#SnsParentDropDown").val(selectedParent.dataset.id);
                    $('#hdnSnsId').val('0');
                    $('#txtSnsCode').val('');
                    $('#txtSnsDescription').val('');
                    $("#saveSns").html("Save");
                    $(".modelSnsTitle").html("Create Standard Number System");
                    $("#snsModel").modal('show');
                }
            });

            $(document).on("click", ".edit-item", function (e) {
                var selectedParent = $(this).getSelectedBranch();
                var isProjectSns = $(this).closest('#projectSnsModel').length > 0;
                var parts = $(selectedParent).find('.branch-title').first().text().trim().split(' : ');

                if (isProjectSns) {
                    $('#pSnsId').val(selectedParent.dataset.id);
                    $('#pSnsCode').val(parts[0] ? parts[0].trim() : '');
                    $('#pSnsDescription').val(parts[1] ? parts[1].trim() : '');
                    $('#pSnsParentId').val(selectedParent.dataset.parent || '');
                    $('#pSnsFormHint').text('Editing node');
                    $('#pSnsCodeError').hide().text('Code is required');
                    $('#pSnsFormPanel').slideDown(150, function () { $('#pSnsCode').focus(); });
                } else {
                    var rawTitle = $(selectedParent).find('.branch-title').first().text().trim().split(' : ');
                    $('#txtSnsCode').val(rawTitle[0] ? rawTitle[0].trim() : '');
                    $('#txtSnsDescription').val(rawTitle[1] ? rawTitle[1].trim() : '');
                    $('#hdnSnsId').val(selectedParent.attributes['data-id'].value);
                    $("#SnsParentDropDown").val(selectedParent.attributes['data-parent'].value);
                    $("#saveSns").html("Update");
                    $(".modelSnsTitle").html("Edit Standard Number System");
                    $("#snsModel").modal('show');
                }
            });

            $(document).on("click", ".create-dmc", function (e) {
                var selectedParent = $(this).getSelectedBranch();
                selectedSNS = selectedParent.dataset.id;

                $("#hdnDmcId").val('');
                $("#DMCProjectDropDown").val(selectedProject);
                $("#DMCProjectDropDown").trigger("change");

                $("#txtDMCModelIdentification").val('');
                $("#txtDMCSDC").val('');
                $("#txtDMCSnsCode").val('');
                $("#txtDMCDCV").val('A');
                $("#txtDMCICV").val('A');
                $("#DMCInformationCodeDropDown").val('');
                $("#DMCLocationCodeDropDown").val('');
                $("#DMCSchemaFileDropDown").val('');
                $("#txtDC").val('');
                $("#txtDMCTechName").val('');
                $("#txtDMCInfoName").val('');

                $(".modelDMCTitle").html("Create DMC");
                $("#btnDMCSave").html("Save");

                $("#DMCModel").modal('show');
            });

            $(document).on("click", ".remove-branch", function (e) {
                e.preventDefault();

                if (!window.confirm("Delete this node and all its children?")) return;

                var $btn = $(this);
                var selectedParent = $btn.getSelectedBranch();
                var id = selectedParent.attributes['data-id'].value;
                var isProjectSns = $btn.closest('#projectSnsModel').length > 0;

                if (isProjectSns) {
                    $.ajax({
                        type: "POST",
                        url: "Manage/DeleteProjectSns",
                        data: { snsId: id, projectId: selectedProject },
                        dataType: "json",
                        success: function () { loadProjectSnsTree(selectedProject); }
                    });
                } else {
                    $.ajax({
                        type: "POST",
                        url: "Manage/DeleteSns",
                        data: { id: id },
                        dataType: "json",
                        success: function () { location.reload(); }
                    });
                }
            });

            // ── SNS tree: collapse / expand ──────────────────────────────────────
            $(document).on("click", ".toggle-branch", function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $branch = $(this).closest(".tree-branch");
                var $icon   = $(this).find('.toggle-icon');

                if ($branch.hasClass("sns-collapsed")) {
                    $branch.removeClass("sns-collapsed");
                    $icon.removeClass('fa-chevron-right').addClass('fa-chevron-down');
                    showBranchChildren($branch);
                } else {
                    $branch.getDescendants().hide();
                    $branch.addClass("sns-collapsed");
                    $icon.removeClass('fa-chevron-down').addClass('fa-chevron-right');
                }
            });

            $('#addDMCtoTree').click(function () {

                var dmcId = parseInt($("#projectNavigationTreeDmcDropDown").val());
                var dmcText = $("#projectNavigationTreeDmcDropDown option:selected").text();
                var dmc = $("#projectNavigationTreeDmcDropDown option:selected").attr("dmc");
                var title = $("#projectNavigationTreeDmcDropDown option:selected").attr("title");

                var navigationTreeDataString = $('#projectNavigationTree').tree('toJson');
                var navigationTreeData = JSON.parse(navigationTreeDataString);

                if ($('input[name=dmctype]:checked').val() == "dmc") {
                    navigationTreeData.push({ "name": dmc, "dmcId": dmcId, "dmc": dmc, "title": title, "id": 0, "children": [] });
                }
                else {
                    navigationTreeData.push({ "name": title, "dmcId": dmcId, "dmc": dmc, "title": title, "id": 0, "children": [] });
                }

                var jsonObj = BuildNavigationTree(navigationTreeData);
                refreshProjectNavigationTree(jsonObj);
            });


            $('#saveProjectNavigationTree').click(function () {

                var navigationTreeData = $('#projectNavigationTree').tree('toJson');

                $.ajax({
                    type: "POST",
                    url: "Manage/SaveProjectNavigationTree",
                    data: { projectId: selectedProject, navigationTreeDataJson: navigationTreeData },
                    dataType: "json",
                    success: function (result) {

                        var jsonObj = BuildNavigationTree(result);

                        $('#projectNavigationTree').tree({
                            data: jsonObj,
                            autoOpen: true,
                            dragAndDrop: true,
                            onDragStop: handleStop,
                            onCreateLi: function (node, $li) {
                                // Append a link to the jqtree-element div.
                                // The link has an url '#node-[id]' and a data property 'node-id'.
                                $li.find('.jqtree-element').append(
                                    ' <a href="#" class="edit editTitle" style="display: none;" data-node-id="' + node.id + '">&nbsp;<i class="fas fa-edit"></i></a>'
                                );
                            }
                        });

                        showAlertProjectNavigationModel(true, "Navigation Saved Successfully!");
                    }
                });
            });


            $('#projectNavigationTree').on('click', '.editTitle', function (e) {
                var node = $(e.target).parent().siblings('.jqtree-title');
                currentNodeText = node[0].innerText;

                node.inlineEdit({
                    defaultText: true,
                    onUpdate: function (val) {

                        var navigationTreeDataString = $('#projectNavigationTree').tree('toJson');
                        navigationTreeDataString = navigationTreeDataString.replaceAll(currentNodeText, val);

                        var jsonObj = BuildNavigationTree(JSON.parse(navigationTreeDataString));
                        refreshProjectNavigationTree(jsonObj);
                        $(".editTitle").show();
                    }
                });
            });

            $('input[type=radio][name=dmctype]').change(function () {
                if (this.id == 'projectNavigationDMC') {
                    populateNavigationTree();
                    $(".editTitle").hide();
                }
                else if (this.id == 'projectNavigationTitle') {
                    populateNavigationTree();
                    $(".editTitle").show();
                }
            });

            $("#btnUploadDMC").on('click', function (e) {
                e.preventDefault();
                $("#upload:hidden").trigger('click');
            });

            $("#SnsParentDropDown option").remove();

            var slelectObj = $('#SnsParentDropDown');
            slelectObj.append('<option selected>Please Select Parent Node</option>');

            $.each(data, function (idx, obj) {
                slelectObj.append('<option value="' + obj.id + '">' + obj.title + '</option>');
            });

            $(".create-dmc").hide();

            $("#pills-tab-4").click(function () {

                sortable = new TreeSortable("#tree");
                content = data.map(sortable.createBranch);
                $("#tree").html(content.join(''));
                sortable.run();
                refreshToggleButtons("#tree");
                $(".create-dmc").hide();

                $("#SnsParentDropDown option").remove();

                var slelectObj = $('#SnsParentDropDown');
                slelectObj.append('<option selected>Please Select Parent Node</option>');

                $.each(data, function (idx, obj) {
                    slelectObj.append('<option value="' + obj.id + '">' + obj.title + '</option>');
                });
            });

            $('a[data-toggle="pill"]').on('show.bs.tab', function (e) {
                localStorage.setItem('activeTab', $(e.target).attr('href'));
            });

            var activeTab = localStorage.getItem('activeTab');
            if (activeTab) {
                $('#pills-tab a[href="' + activeTab + '"]').tab('show');
            }

        @foreach (var d in Model.ResponsiblePartnerCodes)
        {
            @:var obj = { "Id": '@d.Id', "Code": '@d.Code', "Rpccage": '@d.Rpccage', "OrginatorCage": '@d.OrginatorCage' };
            @:responsiblePartnerCodes.push(obj);
        }

                $('.1charonly').keypress(function (e) {
                    var charCode = (e.which) ? e.which : event.keyCode
                    if (String.fromCharCode(charCode).match(/[^A-Z, a-z]/g)) {
                        return false;
                    }
                });


            // Only initialise #tableDMC here; #tableProject is initialised below with its own call
            var tableDMC = $('#tableDMC').DataTable();

            // DMRL project dropdown filter (column 1 = ProjectId hidden col)
            $('#dmrlProjectFilter').on('change', function () {
                var pid = $(this).val();
                tableDMC.column(1).search(pid ? '^' + pid + '$' : '', true, false).draw();
                var url = '/Manage/DownloadDMRL' + (pid ? '?projectId=' + pid : '');
                $('#btnDownloadDMRL').attr('href', url);
            });
            $("#adminlink").removeClass("active");
            $("#configlink").removeClass("active");
            $("#mainlink").addClass("active");
            $("#icnlink").removeClass("active");

            //Close Model
            $(".btn-close").click(function () {
                $("#locatonCodemdl").modal('hide');
                $("#locatonCodeSetmdl").modal('hide');
                $("#rpcModel").modal('hide');
                $("#DataModuleTypeModel").modal('hide');
                $("#rpcModel").modal('hide');
                $("#projectModel").modal('hide');
                $("#projectSnsModel").modal('hide');
                $("#projectNavigationModel").modal('hide');
                $("#projectBrexRulesModel").modal('hide');
                selectedProject = 0;
            });

            $(".btn-close-sns").click(function () {
                $("#snsModel").modal('hide');
            });

            $(".btn-close-dmc").click(function () {
                $("#DMCModel").modal('hide');
            });

            //Close Model
            $(".modelCancel").click(function () {
                $("#locatonCodemdl").modal('hide');
                $("#locatonCodeSetmdl").modal('hide');
                $("#snsModel").modal('hide');
                $("#rpcModel").modal('hide');
                $("#DataModuleTypeModel").modal('hide');
                $("#rpcModel").modal('hide');
                $("#projectModel").modal('hide');
                $("#projectSnsModel").modal('hide');
                $("#projectNavigationModel").modal('hide');
                $("#projectBrexRulesModel").modal('hide');
