                + '<a class="btn btn-sm btn-outline-secondary me-1" href="/Manage/DownloadStylesheet/' + ss.id + '" title="Download"><i class="fa-solid fa-download"></i></a>'
                + '<button class="btn btn-sm btn-outline-danger btnDeleteSS" data-id="' + ss.id + '" title="Delete"><i class="fa-solid fa-trash"></i></button>'
                + '</td></tr>';
            $('#ssTableBody').prepend(row);
        }

        function ssFormatXml(xml) {
            var formatted = '';
            var indent = '';
            var tab = '  ';
            xml.split(/>\s*</).forEach(function (node) {
                if (node.match(/^\/\w/)) indent = indent.substring(tab.length);
                formatted += indent + '<' + node + '>\n';
                if (node.match(/^<?\w[^>]*[^\/]$/) && !node.startsWith('?') && !node.startsWith('!')) indent += tab;
            });
            return formatted.substring(1, formatted.length - 2);
        }

