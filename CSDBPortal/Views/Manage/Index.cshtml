                if ($.fn.DataTable.isDataTable('#tableBrexRules')) {
                    $('#tableBrexRules').DataTable().clear().destroy();
                }

                var brexColumns = [
                    { title: "Id", className: "brexRuleId" },
                    { title: "Schema", className: "editableColumn brexRuleSchema" },
                    { title: "Rule", className: "editableColumn brexRuleRule" },
                    { title: "Xml Tag", className: "editableColumn brexRuleXmlTag" },
                    { title: "Sub Xml Tag", className: "editableColumn brexRuleSubXmlTag" },
                    { title: "Constraint Type", className: "editableDropDownColumn brexRuleConstraintType" },
                    { title: "Length", className: "editableColumn brexRuleLength" },
                    { title: "Range", className: "editableColumn brexRuleRangeValue" },
                    { title: "Value", className: "editableColumn brexRuleMatchValue" },
                    { title: "Attribute Name", className: "editableColumn brexRuleAttributeName" },
                ];
                if (canEditBrexRules) {
                    brexColumns.push({ title: "Action", defaultContent: "<a href='#' class='editBrexRule'>&nbsp;<i class='fas fa-edit'></i></a>", className: "editBrexRuleColumn" });
                }

                var projectBrexRulesTable = $('#tableBrexRules').DataTable({
                    responsive: true,
                    autoWidth: true,
                    searching: true,
                    columns: brexColumns
                });

                $.ajax({
                    type: "POST",
                    url: "/Manage/GetBrexRules",
                    data: { projectId: selectedProject },
                    dataType: "json",
                    success: function (data) {
                        var rows = data.map(function (obj) {
                            return [obj.id, obj.group, obj.ruleName, obj.xmlTag,
                                obj.subXmlTag, obj.type, obj.length, obj.rangeValue, obj.matchValue, obj.attributeName];
                        });
                        projectBrexRulesTable.rows.add(rows).draw();
                    },
                    error: function (xhr, status, error) {
                        console.error('GetBrexRules failed:', status, error, xhr.responseText);
                    }
                });

                $("#projectBrexRulesModel").modal('show');
            });


