        function ssAddRowToTable(ss) {
            var updated = ss.updatedBy ? ss.updatedBy + ' @@ ' + ss.updatedOn : '-';
            var row = '<tr data-id="' + ss.id + '">'
                + '<td>' + $('<span>').text(ss.name).html() + '</td>'
