            $('#tableBrexRules').on('click', '.saveBrexRule', function () {

                var rowobj = $(this).closest("tr");

                var id = rowobj.find("td:eq(0)").text();
                var schema = rowobj.find(".brexRuleSchema")[1].value;
                var rule = rowobj.find(".brexRuleRule")[1].value;
                var xmlTag = rowobj.find(".brexRuleXmlTag")[1].value;
                var subXmlTag = rowobj.find(".brexRuleSubXmlTag")[1].value;
                var constraintType = rowobj.find(".brexRuleConstraintType")[1].value;
                var length = rowobj.find(".brexRuleLength")[1].value;
                var rangeValue = rowobj.find(".brexRuleRangeValue")[1].value;
                var matchValue = rowobj.find(".brexRuleMatchValue")[1].value;
                var attributeName = rowobj.find(".brexRuleAttributeName")[1].value;

                var brexRule = {}
                brexRule.Id = id;
                brexRule.Group = schema;
                brexRule.RuleName = rule;
                brexRule.XmlTag = xmlTag;
                brexRule.SubXmlTag = subXmlTag;
                brexRule.Type = constraintType;
                brexRule.Length = length;
                brexRule.RangeValue = rangeValue;
                brexRule.MatchValue = matchValue;
                brexRule.AttributeName = attributeName;

                $.ajax({
                    type: "POST",
                    url: "/Manage/SaveBrexRule",
                    data: { brexRule: brexRule },
                    dataType: "json",
                    success: function (data) {
                        if (data.validated) {
                            var status = data.failed === 0;
                            var msg = 'BREX rule saved. Project-wide validation complete: '
                                + data.passed + ' passed, ' + data.failed + ' failed (of ' + data.count + ' data modules).';
                            showAlert(status, msg);
                        } else {
                            showAlert(true, 'BREX rule saved. No data modules with generated XML found in this project.');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('SaveBrexRule failed:', status, error);
                    }
                });


                $('#tableBrexRules').find('.editBrexRuleInput').each(function () {
                    var content = $(this).val();
                    var tdObj = $(this).closest("td");
                    tdObj.html(content);
                });

                $('#tableBrexRules').find('.constraintTypeDropdown').each(function () {
                    var content = $(this).val();
                    var tdObj = $(this).closest("td");
                    tdObj.html(content);
                });

                $('#tableBrexRules').find('.saveBrexRule').each(function () {
                    var tdObj = $(this).closest("td");
                    tdObj.html("<a href='#' class='editBrexRule'>&nbsp;<i class='fas fa-edit'></i></a>");
                    tdObj[0].className = "editBrexRuleColumn";
                });
            });

            $('#tableProject').on('click', '.project_brex_rules_button', function () {

