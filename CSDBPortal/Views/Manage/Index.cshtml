@model CSDBPortal.ViewModels.ManageViewModel
@{
    ViewData["Title"] = "Manage";

    bool hasSNS        = User.HasClaim("Permission", Features.SNSAdministration);
    bool hasProject    = User.HasClaim("Permission", Features.ProjectAdministration);
    bool hasDMC        = User.HasClaim("Permission", Features.DMCAdministration);
    bool hasAllocation = User.HasClaim("Permission", Features.AllocationAdministration);

    bool _m = true;
    bool snsFirst        = _m && hasSNS;        if (hasSNS)        _m = false;
    bool projectFirst    = _m && hasProject;    if (hasProject)    _m = false;
    bool dmcFirst        = _m && hasDMC;        if (hasDMC)        _m = false;
    bool allocationFirst = _m && hasAllocation; if (hasAllocation) _m = false;
    bool ssFirst         = _m;                  _m = false;
}

<div class="alert" style="display:none" id="mainAlert">
    <span id="alertMessage">This alert box could indicate a successful or positive action.</span>
</div>

<div class="maint-shell">

    <!-- ── Secondary Navigation Panel ── -->
    <aside class="maint-panel">
        <div class="maint-panel-header">
            <div class="maint-panel-title">Manage</div>
            <div class="maint-panel-sub">Project data &amp; structures</div>
        </div>

        <nav class="maint-panel-nav" id="pills-tab" role="tablist">

            @if (hasSNS)
            {
                <a class="maint-nav-item @(snsFirst ? "active" : "")" id="pills-tab-4"
                   data-bs-toggle="tab" href="#pills-4" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-sitemap"></i></span>
                    <span>SNS</span>
                </a>
            }
            @if (hasProject)
            {
                <a class="maint-nav-item @(projectFirst ? "active" : "")" id="pills-tab-5"
                   data-bs-toggle="tab" href="#pills-5" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-folder-open"></i></span>
                    <span>Projects</span>
                </a>
            }
            @if (hasDMC)
            {
                <a class="maint-nav-item @(dmcFirst ? "active" : "")" id="pills-tab-7"
                   data-bs-toggle="tab" href="#pills-7" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-file-code"></i></span>
                    <span>DMRL</span>
                </a>
            }
            @if (hasAllocation)
            {
                <a class="maint-nav-item @(allocationFirst ? "active" : "")" id="pills-tab-10"
                   data-bs-toggle="tab" href="#pills-10" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-people-arrows"></i></span>
                    <span>Allocation</span>
                </a>
            }
            <a class="maint-nav-item" id="pills-tab-8"
               data-bs-toggle="tab" href="#pills-8" role="tab">
                <span class="mni-icon"><i class="fa-solid fa-palette"></i></span>
                <span>Stylesheet</span>
            </a>
            <a class="maint-nav-item" id="pills-tab-9"
               data-bs-toggle="tab" href="#pills-9" role="tab">
                <span class="mni-icon"><i class="fa-solid fa-images"></i></span>
                <span>Images</span>
            </a>
            <a class="maint-nav-item" id="pills-tab-11"
               data-bs-toggle="tab" href="#pills-11" role="tab">
                <span class="mni-icon"><i class="fa-solid fa-fingerprint"></i></span>
                <span>ID Manager</span>
            </a>
        </nav>
    </aside>

    <!-- ── Main Content ── -->
    <div class="maint-content">
        <div class="tab-content" id="pills-tabContent">
            @if (User.HasClaim("Permission", Features.SNSAdministration))
            {
                <!-- tab-4 start -->
                <div class="tab-pane fade @(snsFirst ? "show active" : "")" id="pills-4" role="tabpanel" aria-labelledby="pills-tab-4">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateSNS">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped">
                            <ul id="tree"></ul>

                            @*<table class="table table-bordered" width="100%" id="snsTable">
                        <thead class="thead">
                        <tr>
                        <th style="display:none"> </th>
                        <th>Parent</th>
                        <th>Code</th>
                        <th>Description</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.StandardNumberingSystems)
                        {
                        <tr style="background:#fff;">
                        <td style="display:none">@s.Id</td>
                        <td> @s.ParentCode</td>
                        <td> @s.Code</td>
                        <td>@s.Description</td>
                        </tr>
                        }
                        </tbody>
                        </table>*@
                        </div>
                    </div>
                </div>
                <!-- /. tab-4 end -->
            }
            @if (User.HasClaim("Permission", Features.ProjectAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade @(projectFirst ? "show active" : "")" id="pills-5" role="tabpanel" aria-labelledby="pills-tab-5">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateProject">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableProject">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th>Name</th>
                                        <th>Title</th>
                                        <th>Information Code - Variant</th>
                                        <th>ICN Format</th>
                                        <th width="25%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Projects)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.IssueNoId</td>
                                            <td style="display:none">@p.IcnformatId</td>
                                            <td style="display:none">@p.SNSSetId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.SDC</td>
                                            <td style="display:none">@p.ModelIdentification</td>
                                            <td style="display:none">@p.LocationCodeId</td>
                                            <td style="display:none">@p.RPCId</td>
                                            <td>@p.Name</td>
                                            <td>@p.Title</td>
                                            <td>@p.InformationCodeProp - @p.Variant</td>
                                            <td>@p.ICNFormatDescription</td>
                                            <td>
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="fas fa-fw fa-ellipsis-h"></i> Actions
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li><a href="#" class="dropdown-item edit_button edit_project"><i class="fas fa-fw fa-pen me-1"></i>Edit</a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a href="#" class="dropdown-item project_sns_button"><i class="fas fa-fw fa-sitemap me-1"></i>SNS</a></li>
                                                        <li><a href="#" class="dropdown-item project_dmrl_button"><i class="fas fa-fw fa-list me-1"></i>DMRL</a></li>
                                                        <li><a href="#" class="dropdown-item project_dmc_button"><i class="fas fa-fw fa-file-code me-1"></i>DMC</a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a href="#" class="dropdown-item project_dmc_generate_button"><i class="fas fa-fw fa-file-alt me-1"></i>Brex</a></li>
                                                        <li><a href="#" class="dropdown-item project_brex_rules_button"><i class="fas fa-fw fa-sliders-h me-1"></i>Brex Rules</a></li>
                                                        <li><a href="#" class="dropdown-item project_navigation_generate_button"><i class="fas fa-fw fa-compass me-1"></i>Navigation</a></li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-5 end -->
            }

            @if (User.HasClaim("Permission", Features.DMCAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade @(dmcFirst ? "show active" : "")" id="pills-7" role="tabpanel" aria-labelledby="pills-tab-7">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateDMC">
                                    <i class="fas fa-plus"></i> Create DMC
                                </a>
                                <a href="/Manage/DownloadDMRL" class="btn" id="btnDownloadDMRL">
                                    <i class="fas fa-download"></i> Download DMRL
                                </a>
                                <a href="/Manage/DownloadDMCTemplate" class="btn" id="btnDownloadDMCTemplate">
                                    DMRL Template
                                </a>
                                <form class="d-inline" asp-action="UploadDMC" asp-controller="Manage" method="post" enctype="multipart/form-data">
                                    <input id="upload" name="upload" style="display:none" type="file" onchange="this.form.submit();" />
                                    <a class="btn" id="btnUploadDMC" name="uploadbutton">Upload DMRL</a>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <label for="dmrlProjectFilter" class="col-form-label fw-semibold">Project</label>
                            </div>
                            <div class="col-sm-4">
                                <select id="dmrlProjectFilter" class="form-select form-select-sm">
                                    <option value="">— All Projects —</option>
                                    @foreach (var proj in Model.Projects)
                                    {
                                        <option value="@proj.Id">@proj.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableDMC">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th width="35%">DMC</th>
                                        <th width="10%">XML</th>
                                        <th width="6%">BREX</th>
                                        <th width="8%">Status</th>
                                        <th width="11%">Owner</th>
                                        <th width="11%">Check Out Date</th>
                                        <th width="14%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.DataModuleCodes)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.ProjectId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.LocationCodeId</td>

                                            <td width="35%">@p.DMC</td>
                                            @if (p.xml != null)
                                            {
                                                <td width="10%">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a href="#" class="btn edit_button view_dmc_xml" title="Open XML in viewer">View</a>
                                                        @if (p.CheckoutStatus == "CheckedOut")
                                                        {
                                                            <a href="#" class="btn edit_button checkin_dmc" title="Upload and check in">Check In</a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn edit_button checkout_dmc_xml" title="Download and check out">Check Out</a>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td width="10%"><a href="#" class="btn edit_button generate_DMC">Generate</a></td>
                                            }
                                            <td width="6%">
                                                @if (p.ValidationStatus == true)
                                                {
                                                    <span class="badge bg-success" title="@p.ValidationMessage">Pass</span>
                                                }
                                                else if (p.ValidationStatus == false)
                                                {
                                                    <span class="badge bg-danger brex-fail-badge" style="cursor:pointer" title="@p.ValidationMessage">Fail</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">—</span>
                                                }
                                            </td>
                                            <td width="8%">
                                                @if (p.xml == null)
                                                {
                                                    <span class="badge bg-secondary">—</span>
                                                }
                                                else if (p.CheckoutStatus == "CheckedOut")
                                                {
                                                    <span class="badge bg-warning text-dark">Checked Out</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                            </td>
                                            <td width="11%">@(p.CheckedOutBy ?? "—")</td>
                                            <td width="11%">@(p.CheckedOutOn.HasValue ? p.CheckedOutOn.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "—")</td>
                                            <td width="14%">
                                                @if (p.xml != null)
                                                {
                                                    <a href="#" class="btn edit_button validate_DMC">Validate</a>
                                                }
                                                <a href="#" class="btn edit_button delete_DMC">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Check In Modal -->
                <div class="modal fade" id="checkinModal" tabindex="-1" aria-labelledby="checkinModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="checkinModalLabel">Check In XML</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted mb-2">DMC: <strong id="checkinDmcName"></strong></p>
                                <p class="mb-3">Upload the modified XML file. The system will verify that the <code>identAndStatusSection</code> is unchanged and that the file passes BREX validation before accepting it.</p>
                                <input type="file" id="checkinFile" class="form-control" accept=".xml" />
                                <div id="checkinMessage" class="mt-3 small" style="display:none;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="btnCheckinSubmit">Check In</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- /. tab-5 end -->
            }
            @if (hasAllocation)
            {
                <!-- tab-10 Allocation start -->
                <div class="tab-pane fade @(allocationFirst ? "show active" : "")" id="pills-10" role="tabpanel" aria-labelledby="pills-tab-10">
                    <div class="card mb-3" style="padding:15px;">
                        <label class="input-title">Select Project</label>
                        <select class="form-select form-control" id="allocProjectDrop">
                            <option value="">-- Select a Project --</option>
                            @foreach (var proj in Model.Projects)
                            {
                                <option value="@proj.Id">@proj.Title</option>
                            }
                        </select>
                    </div>

                    <div id="allocContent" style="display:none;">
                        <ul class="nav nav-pills tab-header mb-3" id="allocTabs" role="tablist">
                            <li class="nav-item item-one" role="presentation">
                                <a class="nav-link active" id="alloc-tab-1" data-bs-toggle="pill" href="#alloc-1" role="tab">
                                    <i class="fa-solid fa-users"></i> Users
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="alloc-tab-2" data-bs-toggle="pill" href="#alloc-2" role="tab">
                                    <i class="fa-solid fa-file-code"></i> Authoring
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="alloc-tab-3" data-bs-toggle="pill" href="#alloc-3" role="tab">
                                    <i class="fa-solid fa-images"></i> Illustration
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content" id="allocTabContent">

                            <!-- Alloc Tab 1: Users -->
                            <div class="tab-pane fade show active" id="alloc-1" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="input-title">Filter by Role</label>
                                            <select class="form-select form-control" id="allocRoleFilter">
                                                <option value="">All Roles</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocUsersTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th style="width:40px;"></th>
                                                    <th>User Name</th>
                                                    <th>Email</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocUsersBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Alloc Tab 2: Authoring (DMCs) -->
                            <div class="tab-pane fade" id="alloc-2" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocDMCTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th width="70%">DMC</th>
                                                    <th width="30%">Assigned To</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocDMCBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Alloc Tab 3: Illustration (ICNs) -->
                            <div class="tab-pane fade" id="alloc-3" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocICNTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th width="70%">ICN</th>
                                                    <th width="30%">Assigned To</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocICNBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- /. tab-10 Allocation end -->
            }

            <!-- tab-8 Stylesheet start -->
            <div class="tab-pane fade @(ssFirst ? "show active" : "")" id="pills-8" role="tabpanel" aria-labelledby="pills-tab-8">

                <!-- Upload card -->
                <div class="card mb-3" style="padding:20px;">
                    <h6 class="mb-3"><i class="fa-solid fa-upload me-2"></i>Upload XSLT Stylesheet</h6>
                    <form id="stylesheetUploadForm" enctype="multipart/form-data">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="ssUploadName" placeholder="e.g. PDF Output Style" maxlength="256" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">File (.xsl / .xslt) <span class="text-danger">*</span></label>
                                <input type="file" class="form-control" id="ssUploadFile" accept=".xsl,.xslt" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Remarks</label>
                                <input type="text" class="form-control" id="ssUploadRemarks" placeholder="Optional description" maxlength="1000" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn w-100" id="btnUploadStylesheet">
                                    <i class="fas fa-upload me-1"></i> Upload
                                </button>
                            </div>
                        </div>
                        <div id="ssUploadMsg" class="mt-2" style="display:none;"></div>
                    </form>
                </div>

                <!-- Table card -->
                <div class="card" style="padding:20px;">
                    <h6 class="mb-3"><i class="fa-solid fa-list me-2"></i>Uploaded Stylesheets</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="ssTable" width="100%">
                            <thead class="thead">
                                <tr>
                                    <th>Name</th>
                                    <th>File</th>
                                    <th>Uploaded By</th>
                                    <th>Uploaded On</th>
                                    <th>Last Updated</th>
                                    <th>Remarks</th>
                                    <th style="width:140px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ssTableBody">
                                @if (Model?.Stylesheets != null)
                                {
                                    foreach (var ss in Model.Stylesheets)
                                    {
                                        <tr data-id="@ss.Id">
                                            <td>@ss.Name</td>
                                            <td>@ss.FileName</td>
                                            <td>@ss.UploadedBy</td>
                                            <td>@ss.UploadedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@(ss.UpdatedOn.HasValue ? $"{ss.UpdatedBy} @ {ss.UpdatedOn.Value:yyyy-MM-dd HH:mm}" : "-")</td>
                                            <td>@(ss.Remarks ?? "-")</td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-sm btn-outline-primary me-1 btnEditSS" data-id="@ss.Id" title="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                                                <a class="btn btn-sm btn-outline-secondary me-1" href="/Manage/DownloadStylesheet/@ss.Id" title="Download"><i class="fa-solid fa-download"></i></a>
                                                <button class="btn btn-sm btn-outline-danger btnDeleteSS" data-id="@ss.Id" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-8 Stylesheet end -->
            <!-- tab-9 Images start -->
            <div class="tab-pane fade" id="pills-9" role="tabpanel" aria-labelledby="pills-tab-9">

                <!-- Upload card -->
                <div class="card mb-3" style="padding:20px;">
                    <h6 class="mb-3"><i class="fa-solid fa-upload me-2"></i>Upload Image</h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="imgUploadName" placeholder="e.g. Company Logo" maxlength="256" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">File <span class="text-danger">*</span></label>
                            <input type="file" class="form-control" id="imgUploadFile" accept="image/jpeg,image/png,image/gif,image/svg+xml,image/webp,image/bmp,image/tiff" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Remarks</label>
                            <input type="text" class="form-control" id="imgUploadRemarks" placeholder="Optional description" maxlength="1000" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn w-100" id="btnUploadImage">
                                <i class="fas fa-upload me-1"></i> Upload
                            </button>
                        </div>
                    </div>
                    <div id="imgUploadMsg" class="mt-2" style="display:none;"></div>
                </div>

                <!-- Image gallery/table card -->
                <div class="card" style="padding:20px;">
                    <h6 class="mb-3"><i class="fa-solid fa-images me-2"></i>Uploaded Images</h6>

                    <!-- View toggle -->
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-sm btn-outline-secondary active" id="btnImgGrid" title="Grid view"><i class="fa-solid fa-grip"></i></button>
                        <button class="btn btn-sm btn-outline-secondary" id="btnImgList" title="List view"><i class="fa-solid fa-list"></i></button>
                    </div>

                    <!-- Grid view -->
                    <div id="imgGridView">
                        <div class="row g-3" id="imgGrid">
                            @if (Model?.ImageAssets != null)
                            {
                                foreach (var img in Model.ImageAssets)
                                {
                                    <div class="col-6 col-md-3 col-lg-2 img-card" data-id="@img.Id">
                                        <div class="card h-100 text-center" style="cursor:pointer;">
                                            <div class="card-body p-2">
                                                <img src="/Manage/ViewImageAsset/@img.Id" alt="@img.Name"
                                                     class="img-fluid img-thumbnail mb-2 imgThumb"
                                                     style="max-height:100px; object-fit:contain;"
                                                     data-id="@img.Id" />
                                                <div class="small fw-semibold text-truncate" title="@img.Name">@img.Name</div>
                                                <div class="text-muted" style="font-size:0.7rem;">@img.FileName</div>
                                                <div class="text-muted" style="font-size:0.7rem;">@img.UploadedBy · @img.UploadedOn.ToString("yyyy-MM-dd")</div>
                                                @if (!string.IsNullOrEmpty(img.Remarks))
                                                {
                                                    <div class="text-muted fst-italic" style="font-size:0.7rem;" title="@img.Remarks">@img.Remarks</div>
                                                }
                                            </div>
                                            <div class="card-footer p-1 d-flex justify-content-center gap-1">
                                                <button class="btn btn-xs btn-outline-primary btnViewImg" data-id="@img.Id" title="Preview"><i class="fa-solid fa-eye"></i></button>
                                                <a class="btn btn-xs btn-outline-secondary" href="/Manage/DownloadImageAsset/@img.Id" title="Download"><i class="fa-solid fa-download"></i></a>
                                                <button class="btn btn-xs btn-outline-danger btnDeleteImg" data-id="@img.Id" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <p class="text-muted mt-3" id="imgGridEmpty" style="@(Model?.ImageAssets?.Count > 0 ? "display:none;" : "")">No images uploaded yet.</p>
                    </div>

                    <!-- List view (hidden initially) -->
                    <div id="imgListView" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="imgTable" width="100%">
                                <thead class="thead">
                                    <tr>
                                        <th style="width:60px;">Preview</th>
                                        <th>Name</th>
                                        <th>File</th>
                                        <th>Uploaded By</th>
                                        <th>Uploaded On</th>
                                        <th>Remarks</th>
                                        <th style="width:120px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="imgTableBody">
                                    @if (Model?.ImageAssets != null)
                                    {
                                        foreach (var img in Model.ImageAssets)
                                        {
                                            <tr data-id="@img.Id">
                                                <td class="text-center">
                                                    <img src="/Manage/ViewImageAsset/@img.Id" alt="@img.Name"
                                                         style="max-height:40px; max-width:50px; object-fit:contain;" />
                                                </td>
                                                <td>@img.Name</td>
                                                <td>@img.FileName</td>
                                                <td>@img.UploadedBy</td>
                                                <td>@img.UploadedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td class="img-remarks-cell">@(img.Remarks ?? "-")</td>
                                                <td class="text-nowrap">
                                                    <button class="btn btn-sm btn-outline-primary me-1 btnViewImg" data-id="@img.Id" title="Preview"><i class="fa-solid fa-eye"></i></button>
                                                    <a class="btn btn-sm btn-outline-secondary me-1" href="/Manage/DownloadImageAsset/@img.Id" title="Download"><i class="fa-solid fa-download"></i></a>
                                                    <button class="btn btn-sm btn-outline-danger btnDeleteImg" data-id="@img.Id" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /. tab-9 Images end -->

            <!-- tab-11 ID Manager start -->
            <div class="tab-pane fade" id="pills-11" role="tabpanel" aria-labelledby="pills-tab-11">

                <div class="card mb-3" style="padding:20px;">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <label class="fw-semibold mb-0" style="white-space:nowrap;">
                            <i class="fa-solid fa-folder-open me-1 text-primary"></i>Project
                        </label>
                        <select id="idmProjectSelect" class="form-select" style="max-width:360px;">
                            <option value="">-- Select a project --</option>
                            @if (Model?.Projects != null)
                            {
                                foreach (var p in Model.Projects)
                                {
                                    <option value="@p.Id">@p.Name — @p.Title</option>
                                }
                            }
                        </select>
                        <button id="idmAnalyse" class="btn btn-primary btn-sm" disabled>
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Analyse
                        </button>
                        <span id="idmSpinner" class="spinner-border spinner-border-sm text-primary ms-1" style="display:none;" role="status"></span>
                        <span id="idmSummary" class="ms-auto small text-muted"></span>
                    </div>
                </div>

                <!-- Legend -->
                <div class="d-flex gap-3 mb-2 small ms-1" id="idmLegend" style="display:none;">
                    <span><span class="badge bg-success">&nbsp;</span> Used</span>
                    <span><span class="badge bg-secondary">&nbsp;</span> Unused</span>
                    <span><span class="badge bg-danger">&nbsp;</span> Duplicate</span>
                    <span><span class="badge bg-warning text-dark">&nbsp;</span> Broken Reference</span>
                </div>

                <div class="card" style="padding:15px;">
                    <div class="table-responsive">
                        <table id="idmTable" class="table table-sm table-hover" style="width:100%">
                            <thead class="thead">
                                <tr>
                                    <th>ID Value</th>
                                    <th style="width:180px;">Status</th>
                                    <th>DMC(s)</th>
                                </tr>
                            </thead>
                            <tbody id="idmTbody">
                                <tr><td colspan="3" class="text-center text-muted py-4">Select a project and click Analyse.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <!-- /. tab-11 ID Manager end -->

        </div>
    </div>
    <!-- /. maint-content -->
</div>
<!-- /. maint-shell -->

