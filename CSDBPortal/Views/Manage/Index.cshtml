                            <input type="radio" id="projectNavigationDMC" value="dmc" name="dmctype" checked /> DMC
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="radio" id="projectNavigationTitle" value="title" name="dmctype" /> Title
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">DMC List</label>
                            <select class="form-select form-control w-100" aria-label="Default select example" required id="projectNavigationTreeDmcDropDown"></select>
                            <button id="addDMCtoTree" class="btn btn-primary w-100 mt-2" value="AddDMC">Add to Tree</button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">Navigation Tree</label>
                            <div class="table-responsive table-striped droppable" style="min-height: 150px;">
                                <div id="projectNavigationTree" style="padding: 0"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer mt-3">
                    <button id="saveProjectNavigationTree" class="btn btn-primary" value="Save">Save</button>
                    <button type="button" class="btn btn-default modelCancelProjectNavigationTree" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

