<div class="row">
    <!-- tab-content -->
    <div class="col-12">
        <ul class="nav nav-pills tab-header mb-3" id="pills-tab" role="tablist">
            @if (User.HasClaim("Permission", Features.IssuAdministration))
            {
                <li class="nav-item item-one" role="presentation">
                    <a class="nav-link active" id="pills-tab-1" data-toggle="pill" href="#pills-1">
                        <img src="./dist/img/Icons/Configuration/Issues.png" alt="Issues icon">
                        <span class="ml-2">Issues </span>
                    </a>
                </li>
            }
            @*<li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-2" data-toggle="pill" href="#pills-2">
                    <img src="./dist/img/Icons/Configuration/Designation.png" alt="Designation icon">
                    <span class="ml-2"> Designation</span>
                </a>
            </li>*@
            @if (User.HasClaim("Permission", Features.InfoCodeSetAdministration))
            {
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-tab-5" data-toggle="pill" href="#pills-5">
                        <img src="./dist/img/Icons/Configuration/Info Code.png" alt="Info Code icon">
                        <span class="ml-2">Info Code Set</span>
                    </a>
                </li>
            }
            @if (User.HasClaim("Permission", Features.InfoCodeAdministration))
            {
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-tab-3" data-toggle="pill" href="#pills-3">
                        <img src="./dist/img/Icons/Configuration/Info Code.png" alt="Info Code icon">
                        <span class="ml-2">Info Code</span>
                    </a>
                </li>
            }
            @if (User.HasClaim("Permission", Features.IcnFormatAdministration))
            {
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="pills-tab-4" data-toggle="pill" href="#pills-4">
                        <img src="./dist/img/Icons/Configuration/ICN Format.png" alt="ICN Format icon">
                        <span class="ml-2"> ICN Format</span>
                    </a>
                </li>
            }
        </ul>
        <div class="tab-content" id="pills-tabContent">
            @if (User.HasClaim("Permission", Features.IssuAdministration))
            {
                <!-- tab-1 start -->
                <div class="tab-pane fade show active" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateNewIssue">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive">
                            <table id="issueTable" class="table table-bordered">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none">Issue No</th>
                                        <th>Issue No</th>
                                        <th>Created By</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.IssueNos)
                                    {
                                        <tr>
                                            <td style="display:none">@m.Id</td>
                                            <td>@m.Name</td>
                                            <td>@m.CreatedBy</td>
                                            <td>
                                                <a class="btn edit_button editIssue"> Edit </a>
                                                <a class="btn deleteBtn"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-1 end -->
            }

            <!-- tab-2 start -->
            @*<div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" data-toggle="modal" id="CreateDesignation">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="desigTable" width="100%">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none">id</th>
                                    <th width="75%">Name</th>
                                    <th width="25%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Designations)
                                {
                                    <tr>
                                        <td style="display:none">@d.Id</td>
                                        <td width="75%">@d.Name</td>
                                        <td width="25%">
                                            <a class="btn edit_button eidtDesig"> Edit </a>
                                            <a class="btn deleteBtn"> Delete </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>*@
            <!-- /. tab-2 end -->
            @if (User.HasClaim("Permission", Features.InfoCodeSetAdministration))
            {
                <!-- tab-3 start -->
                <div class="tab-pane fade" id="pills-3" role="tabpanel" aria-labelledby="pills-tab-3">
                    <div class="actions mb-3">
                        <div class="row">
