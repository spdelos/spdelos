@section Scripts {
<script src="~/js/jquery.confirmModal.js"></script>

<script>var displayFormatList = {};</script>
@foreach(var masterField in Model.IcnFormatMasterFields)
{
    <script>displayFormatList[@masterField.Id] = '@masterField.Template';</script>
}

<script type="text/javascript">

    // ── XSD upload state (top-level so accessible from all handlers) ──────────
    var pendingXsdFiles = {};   // { filename: File }
    var existingXsdFiles = [];  // [{ fileName, issueNoId }]

    function renderXsdItem(fileName, isPending) {
        var safeFileName = $('<span>').text(fileName).html();
        var newBadge = isPending
            ? '<span class="badge bg-success ms-1" style="font-size:.6rem;vertical-align:middle">New</span>'
            : '';
        return '<span class="xsd-chip badge rounded-pill border d-inline-flex align-items-center gap-1 py-1 px-2" ' +
            'data-filename="' + safeFileName + '" data-pending="' + isPending + '" ' +
            'style="background:#f0f4ff;color:#1a3a6b;cursor:pointer;font-size:.75rem;font-weight:500;max-width:200px" ' +
            'title="Click to view content">' +
            '<i class="fas fa-file-code" style="font-size:.7rem;opacity:.7"></i>' +
            '<span class="text-truncate" style="max-width:140px">' + safeFileName + '</span>' +
            newBadge +
            '<button type="button" class="xsd-chip-remove ms-1" aria-label="Remove" ' +
            'style="background:none;border:none;padding:0;line-height:1;color:#6c757d;font-size:.8rem">' +
            '<i class="fas fa-times"></i></button>' +
            '</span>';
    }

    function renderXsdFileList() {
        var $list = $('#xsdFileList');
        $list.empty();
        // Close viewer when list is re-rendered
        $('#xsdContentViewer').hide();
        existingXsdFiles.forEach(function (xsd) { $list.append(renderXsdItem(xsd.fileName, false)); });
        $.each(pendingXsdFiles, function (fileName) { $list.append(renderXsdItem(fileName, true)); });
        if ($list.children().length === 0) {
            $list.html('<small class="text-muted">No XSD files added.</small>');
        }
    }

    $(document).ready( function() {

        // ── XSD file upload change handler ────────────────────────────────────
        $('#xsdFilesInput').on('change', function () {
            var files = Array.from(this.files);
            var messages = [];

            var nonXsd = files.filter(function (f) { return !f.name.toLowerCase().endsWith('.xsd'); });
            var xsdFiles = files.filter(function (f) { return f.name.toLowerCase().endsWith('.xsd'); });

            if (nonXsd.length > 0) {
                messages.push('<div class="alert alert-warning py-1 mb-1 small">Ignored ' + nonXsd.length + ' non-XSD file(s): ' + nonXsd.map(function (f) { return f.name; }).join(', ') + '</div>');
            }

            var dupes = [];
            xsdFiles.forEach(function (f) {
                var lc = f.name.toLowerCase();
                var dupeInExisting = existingXsdFiles.some(function (x) { return x.fileName.toLowerCase() === lc; });
                var dupeInPending  = pendingXsdFiles.hasOwnProperty(f.name);
                if (dupeInExisting || dupeInPending) {
                    dupes.push(f.name);
                } else {
                    pendingXsdFiles[f.name] = f;
                }
            });

            if (dupes.length > 0) {
                messages.push('<div class="alert alert-info py-1 mb-1 small">Skipped ' + dupes.length + ' duplicate(s): ' + dupes.join(', ') + '</div>');
            }

            $('#xsdMessages').html(messages.join(''));
            renderXsdFileList();
            $(this).val('');
        });

        // ── Chip click → show content in shared viewer ───────────────────────
        $(document).on('click', '.xsd-chip', function (e) {
            // Remove button is handled separately — ignore here
            if ($(e.target).closest('.xsd-chip-remove').length) return;

            var $chip     = $(this);
            var fileName  = $chip.data('filename');
            var isPending = $chip.data('pending') === true;
            var $viewer   = $('#xsdContentViewer');
            var $pre      = $('#xsdViewerPre');
            var $label    = $('#xsdViewerLabel');

            // Toggle off if same chip is clicked again
            if ($viewer.is(':visible') && $label.text() === fileName) {
                $viewer.hide();
                return;
            }

            $label.text(fileName);
            $pre.text('Loading…');
            $viewer.show();

            if (isPending) {
                var file = pendingXsdFiles[fileName];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) { $pre.text(e.target.result); };
                    reader.readAsText(file);
                }
            } else {
                $.ajax({
                    url: '/Configuration/GetSchemaFileContent',
                    data: { issueNoId: $('#hdnId').val(), fileName: fileName },
                    success: function (content) { $pre.text(content || '(empty)'); }
                });
            }
        });

        // ── Close shared viewer ───────────────────────────────────────────────
        $('#btnCloseXsdViewer').click(function () { $('#xsdContentViewer').hide(); });

        // ── Chip remove button ────────────────────────────────────────────────
        $(document).on('click', '.xsd-chip-remove', function (e) {
            e.stopPropagation();
            var $chip    = $(this).closest('.xsd-chip');
            var fileName = $chip.data('filename');
            // Close viewer if it was showing this file
            if ($('#xsdViewerLabel').text() === fileName) $('#xsdContentViewer').hide();
            if ($chip.data('pending') === true) {
                delete pendingXsdFiles[fileName];
            } else {
                existingXsdFiles = existingXsdFiles.filter(function (x) { return x.fileName !== fileName; });
            }
            renderXsdFileList();
        });

        // ── Issue No save via AJAX FormData ───────────────────────────────────
        $("#btnSaveIssueNo").click(function () {
            var isValid = true;
            if ($('#txtIssueNo').val() === '') {
                $('#txtIssueNo').css('border-color', 'red');
                isValid = false;
            } else {
                $('#txtIssueNo').css('border-color', '');
            }

            var isCreate = ($('#hdnId').val() === '0' || $('#hdnId').val() === '');
            if (isCreate && $('#brexFile')[0].files.length <= 0) {
                $('#brexFile').css('border-color', 'red');
                isValid = false;
            } else {
                $('#brexFile').css('border-color', '');
            }

            if (!isValid) return;

            // Build full file name list (existing + pending)
            var allFileNames = existingXsdFiles.map(function (x) { return { FileName: x.fileName }; });
            $.each(pendingXsdFiles, function (fileName) { allFileNames.push({ FileName: fileName }); });

            var formData = new FormData();
            formData.append('hdnId',       $('#hdnId').val());
            formData.append('txtIssueNo',  $('#txtIssueNo').val());
            formData.append('schemaTypes', JSON.stringify(allFileNames));

            var brexFiles = $('#brexFile')[0].files;
            if (brexFiles.length > 0) formData.append('brexFile', brexFiles[0]);

            $.each(pendingXsdFiles, function (fileName, file) { formData.append('xsdFiles', file); });

            $.ajax({
                url: '/Configuration/CreateIssueNo',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        $('#Configurationmdl').modal('hide');
                        location.reload();
                    } else {
                        $('#errorMsg').html(result.message || 'Error saving.');
                    }
                },
                error: function () {
                    $('#errorMsg').html('An error occurred. Please try again.');
                }
            });
        });

        // Persist active tab (Bootstrap 5)
        document.querySelectorAll('#pills-tab [data-bs-toggle="tab"]').forEach(function (el) {
            el.addEventListener('shown.bs.tab', function (e) {
                localStorage.setItem('activeCfgTab', e.target.getAttribute('href'));
            });
        });
        var activeCfgTab = localStorage.getItem('activeCfgTab');
        var cfgTrigger = activeCfgTab
            ? document.querySelector('#pills-tab [href="' + activeCfgTab + '"]')
            : document.querySelector('#pills-tab [data-bs-toggle="tab"]');
        if (cfgTrigger) bootstrap.Tab.getOrCreateInstance(cfgTrigger).show();

        $('.3numbersonly').keypress(function (e) {

            var charCode = (e.which) ? e.which : event.keyCode
            if (String.fromCharCode(charCode).match(/[^0-9]/g)) {
                return false;
            }

        });

        $('.3numbersonly').blur(function (e) {

            var value = $('.3numbersonly').val().toString();
            if (value.length != 3)
            {
                $("#errorInfoCodeLengthMsg").html('Code should be a 3 digit number');
                $('.3numbersonly').focus();
                return false;
            }
            else
            {
                $("#errorInfoCodeLengthMsg").html('');
            }
        });

        updateIcnFormat();
    });

    function updateIcnFormat()
    {
        var icnformat = 'ICN-';
        for (let i = 0; i < $("#IcnFormatMasterFieldDestinationListBox").prop("options").length; i++) {
            icnformat = icnformat + displayFormatList[$("#IcnFormatMasterFieldDestinationListBox").prop("options")[i].value] + "-";
        }

        icnformat = icnformat.substr(0,icnformat.length - 1);
        $("#SampleFormat").text(icnformat);
    }

    $("#adminlink").removeClass("active");
    $("#configlink").addClass("active");
    $("#mainlink").removeClass("active");
    $("#icnlink").removeClass("active");

    /*Issue No - Start*/
    var issueTable=  $('#issueTable').DataTable();
    $("#btnCreateNewIssue").click(function () {
        $('#hdnId').val('0');
        $('#txtIssueNo').val('');
        $('#brexFile').val('');
        pendingXsdFiles  = {};
        existingXsdFiles = [];
        $('#xsdMessages').empty();
        renderXsdFileList();
        $('#brexRequired').show();
        $('#brexEditHint').hide();
        $("#errorMsg").html('');
        $(".modelIssueNoTitle").html("Create Issue");
        $("#btnSave").html("Save");
        $("#Configurationmdl").modal('show');
    });

    //Close Model
    $(".btn-close").click(function () {
        $("#Configurationmdl").modal('hide');
        $("#desigmdl").modal('hide');
        $("#nCodemdl").modal('hide');
        $("#nCodeSetmdl").modal('hide');
        $("#icnmdl").modal('hide');
    });

    //Close Model
    $(".modelCancel").click(function () {
        $("#Configurationmdl").modal('hide');
        $("#desigmdl").modal('hide');
        $("#nCodemdl").modal('hide');
        $("#nCodeSetmdl").modal('hide');
        $("#icnmdl").modal('hide');
    });

    $("#leftArrow").click(function () {
        var selectedIndex = $("#IcnFormatMasterFieldDestinationListBox").prop("selectedIndex");
        var selectedOption = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[selectedIndex];

        if (selectedIndex > -1)
        {
            $("#IcnFormatMasterFieldSourceListBox").prop("options").add(selectedOption, $("#IcnFormatMasterFieldSourceListBox").prop("options").length);
        }

        $("#IcnFormatMasterFieldDestinationListBox").prop('selectedIndex', selectedIndex % $("#IcnFormatMasterFieldDestinationListBox").prop("options").length); 
        updateIcnFormat();
    });

    $("#rightArrow").click(function () {

        var selectedIndex = $("#IcnFormatMasterFieldSourceListBox").prop("selectedIndex");
        var selectedOption = $("#IcnFormatMasterFieldSourceListBox").prop("options")[selectedIndex];

        if (selectedIndex > -1)
        {
            $("#IcnFormatMasterFieldDestinationListBox").prop("options").add(selectedOption, $("#IcnFormatMasterFieldDestinationListBox").prop("options").length);
        }
        $("#IcnFormatMasterFieldSourceListBox").prop('selectedIndex', selectedIndex % $("#IcnFormatMasterFieldSourceListBox").prop("options").length); 
        updateIcnFormat();
    });

    $("#upArrow").click(function () {

        var selectedIndex = $("#IcnFormatMasterFieldDestinationListBox").prop("selectedIndex");
        var selectedOption = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[selectedIndex];

        if (selectedIndex > 0)
        {
            var previsousOption = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[selectedIndex - 1];

            $("#IcnFormatMasterFieldDestinationListBox").prop("options").remove(selectedIndex);
            $("#IcnFormatMasterFieldDestinationListBox").prop("options").add(selectedOption, selectedIndex - 1);
        }
        updateIcnFormat();
    });

    $("#downArrow").click(function () {

        var selectedIndex = $("#IcnFormatMasterFieldDestinationListBox").prop("selectedIndex");
        var selectedOption = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[selectedIndex];

        if (selectedIndex > -1 && selectedIndex < $("#IcnFormatMasterFieldDestinationListBox").prop("options").length)
        {
            var nextOption = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[selectedIndex + 1];

            $("#IcnFormatMasterFieldDestinationListBox").prop("options").remove(selectedIndex);
            $("#IcnFormatMasterFieldDestinationListBox").prop("options").add(selectedOption, selectedIndex + 1);
        }
        updateIcnFormat();
    });

    //edit Issue
    $('#issueTable tbody').on('click', '.editIssue', function () {
        var rowobj = $(this).closest("tr");
        var id     = rowobj.find("td:eq(0)").text();
        var issue  = rowobj.find("td:eq(1)").text();
        $("#txtIssueNo").val(issue);
        $("#hdnId").val(id);
        $('#brexFile').val('');
        $('#brexRequired').hide();
        $('#brexEditHint').show();

        // Pre-populate existing XSD files from row data attribute
        var schemaTypes = rowobj.data('schema-types') || [];
        pendingXsdFiles  = {};
        existingXsdFiles = schemaTypes.map(function (st) {
            return { fileName: st.fileName, issueNoId: parseInt(id) };
        });
        $('#xsdMessages').empty();
        renderXsdFileList();

        $("#btnSave").html("Update");
        $(".modelIssueNoTitle").html("Edit Issue");
        $("#Configurationmdl").modal('show');
    });


        //Delete Issue
    $('#issueTable tbody').on('click', '.deleteBtn', function () {
        var Id =$(this).closest("tr").find("td:eq(0)").text();
        $.confirmModal('Are you sure to delete this record?', function(el) {
            $.ajax({
                type: "POST",
                url: "Configuration/DeleteIssueNo",
                data: {id: Id },
                dataType: "json",
                success: function (data) {
                    location.reload();
                }
            });
        });
    });
    /*Issue No - End*/

    /*Desigination - Start*/
    var desigTable=  $('#desigTable').DataTable();
        $("#CreateDesignation").click(function () {
        $('#hdnDesigId').val('0');
        $('#txtDesigName').val('');
        $("#btnDesigSave").html("Save");
        $(".modelDeprtTitle").html("Create Designation");
        $("#errordesMsg").html('');
            $("#desigmdl").modal('show');
    });



     $("#btnDesigSave").click(function () {
          if ($('#txtDesigName').val() == '') {
              $('#txtDesigName').css('border-color', 'red');
              return false;
          }
