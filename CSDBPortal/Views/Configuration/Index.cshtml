    var tableICNFormat =  $('#tableICNFormat').DataTable();
    $("#btnICNCreate").click(function () {
        $('#hdnICNId').val('0');
        $('#txtICNName').val('');
        $('#txtICNDescription').val('');

        for (let i = $("#IcnFormatMasterFieldDestinationListBox").prop("options").length - 1; i >= 0; i--) {

            $("#IcnFormatMasterFieldSourceListBox").prop("options").add($("#IcnFormatMasterFieldDestinationListBox").prop("options")[i], $("#IcnFormatMasterFieldSourceListBox").prop("options").length);
        }
        updateIcnFormat();

        $("#btnICNSave").html("Save");
        $(".modelicnTitle").html("Create ICN Format");
        $("#errorICNMsg").html('');
        $("#icnmdl").modal('show');
    });

    $("#btnICNSave").click(function () {

        if ($('#txtICNName').val() == '') {

            $('#txtICNName').css('border-color', 'red');
            return false;
        }
        else {
            $('#txtICNName').css('border-color', '');
        }

        var icnFormat = {}
        icnFormat.Id = $('#hdnICNId').val();
        icnFormat.Code = $('#txtICNName').val();
        icnFormat.Description =  $('#txtICNDescription').val();
        icnFormat.Fields = [];

        for (let i = 0; i < $("#IcnFormatMasterFieldDestinationListBox").prop("options").length; i++) {

            var icnFormatField = {}
            icnFormatField.ICNFormatMasterFieldId = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[i].value;
            icnFormatField.ICNFormatId = icnFormat.Id;
            icnFormatField.DisplayOrder = i;
            icnFormat.Fields.push(icnFormatField);
        }

        $.ajax({
            type: "POST",
            url: "Configuration/CreateICNFormat",
            data: {icnformat: icnFormat },
            dataType: "json",
            success: function (data) {
                if(data == 'Duplicate'){
                    $("#errorICNMsg").html("Duplicate Record.");
                    $("#icnmdl").modal('show')
                }else{
                    $("#icnmdl").modal('hide');
                    location.reload();
                }
            }
        });
    });

    $('#tableICNFormat tbody').on('click', '.icnEdited', function () {

        var rowobj =$(this).closest("tr");
