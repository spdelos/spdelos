            $("#IcnFormatMasterFieldSourceListBox").prop("options").add($("#IcnFormatMasterFieldDestinationListBox").prop("options")[i], $("#IcnFormatMasterFieldSourceListBox").prop("options").length);
        }

        for (let i = 0; i < $("#IcnFormatListBox" + id).prop("options").length; i++) {

            $("#IcnFormatMasterFieldDestinationListBox").prop("options").add($("#IcnFormatMasterFieldSourceListBox option[value='" + $("#IcnFormatListBox" + id).prop("options")[i].value + "']")[0], $("#IcnFormatMasterFieldDestinationListBox").prop("options").length);
        }

        $("#txtICNDescription").val(description);
        $("#txtICNName").val(code);
        $("#hdnICNId").val(id);
