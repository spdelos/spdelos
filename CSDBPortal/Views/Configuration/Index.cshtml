@model CSDBPortal.ViewModels.ConfigurationViewModel
@{
    ViewData["Title"] = "Configure";

    bool hasIssu        = User.HasClaim("Permission", Features.IssuAdministration);
    bool hasInfoCodeSet = User.HasClaim("Permission", Features.InfoCodeSetAdministration);
    bool hasInfoCode    = User.HasClaim("Permission", Features.InfoCodeAdministration);
    bool hasIcnFormat   = User.HasClaim("Permission", Features.IcnFormatAdministration);
    bool hasLocCodeSet  = User.HasClaim("Permission", Features.LocationCodeSetAdministration);
    bool hasLocCode     = User.HasClaim("Permission", Features.LocationCodeAdministration);
    bool hasRPC         = User.HasClaim("Permission", Features.RPCAdministration);

    bool _c = true;
    bool issuFirst        = _c && hasIssu;        if (hasIssu)        _c = false;
    bool infoCodeSetFirst = _c && hasInfoCodeSet;  if (hasInfoCodeSet) _c = false;
    bool infoCodeFirst    = _c && hasInfoCode;     if (hasInfoCode)    _c = false;
    bool icnFormatFirst   = _c && hasIcnFormat;    if (hasIcnFormat)   _c = false;
    bool locCodeSetFirst  = _c && hasLocCodeSet;   if (hasLocCodeSet)  _c = false;
    bool locCodeFirst     = _c && hasLocCode;      if (hasLocCode)     _c = false;
    bool rpcFirst         = _c && hasRPC;
}

<div class="page-body">

    <!-- ── Vertical Tab Nav ── -->
    <nav class="vtab-nav" id="pills-tab" role="tablist">
        <div class="vtab-nav-title">Configure</div>

        @if (hasIssu)
        {
            <a class="vtab-item @(issuFirst ? "active" : "")" id="pills-tab-1"
               data-bs-toggle="tab" href="#pills-1" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-tag"></i></span>
                <span class="vi-label">Issue Numbers</span>
            </a>
        }
        @if (hasInfoCodeSet)
        {
            <a class="vtab-item @(infoCodeSetFirst ? "active" : "")" id="pills-tab-5"
               data-bs-toggle="tab" href="#pills-5" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-layer-group"></i></span>
                <span class="vi-label">Info Code Sets</span>
            </a>
        }
        @if (hasInfoCode)
        {
            <a class="vtab-item @(infoCodeFirst ? "active" : "")" id="pills-tab-3"
               data-bs-toggle="tab" href="#pills-3" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-code"></i></span>
                <span class="vi-label">Info Codes</span>
            </a>
        }
        @if (hasIcnFormat)
        {
            <a class="vtab-item @(icnFormatFirst ? "active" : "")" id="pills-tab-4"
               data-bs-toggle="tab" href="#pills-4" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-puzzle-piece"></i></span>
                <span class="vi-label">ICN Formats</span>
            </a>
        }
        @if (hasLocCodeSet)
        {
            <a class="vtab-item @(locCodeSetFirst ? "active" : "")" id="pills-tab-6"
               data-bs-toggle="tab" href="#pills-6" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-map-pin"></i></span>
                <span class="vi-label">Location Code Sets</span>
            </a>
        }
        @if (hasLocCode)
        {
            <a class="vtab-item @(locCodeFirst ? "active" : "")" id="pills-tab-7"
               data-bs-toggle="tab" href="#pills-7" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-location-dot"></i></span>
                <span class="vi-label">Location Codes</span>
            </a>
        }
        @if (hasRPC)
        {
            <a class="vtab-item @(rpcFirst ? "active" : "")" id="pills-tab-8"
               data-bs-toggle="tab" href="#pills-8" role="tab">
                <span class="vi-icon"><i class="fa-solid fa-building"></i></span>
                <span class="vi-label">RPC</span>
            </a>
        }
    </nav>

    <!-- ── Tab Content ── -->
    <div class="vtab-content">
        <div class="tab-content" id="pills-tabContent">
            @if (User.HasClaim("Permission", Features.IssuAdministration))
            {
                <!-- tab-1 start -->
                <div class="tab-pane fade @(issuFirst ? "show active" : "")" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateNewIssue">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" >
                        <div class="table-responsive">
                            <table id="issueTable" class="table table-bordered">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none">Issue No</th>
                                        <th>Issue No</th>
                                        <th>Schema Types</th>
                                        <th>Created By</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.IssueNos)
                                    {
                                        var schemaTypes = Model.DataModuleTypes
                                            .Where(d => d.IssueNo == m.Id)
                                            .Select(d => new { name = d.Name, fileName = d.FileName });
                                        <tr data-schema-types="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(schemaTypes))">
                                            <td style="display:none">@m.Id</td>
                                            <td>@m.Name</td>
                                            <td>@Model.DataModuleTypes.Count(d => d.IssueNo == m.Id)</td>
                                            <td>@m.CreatedBy</td>
                                            <td>
                                                <a class="btn edit_button editIssue"> Edit </a>
                                                <a class="btn deleteBtn"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-1 end -->
            }

            <!-- tab-2 start -->
            @*<div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" data-toggle="modal" id="CreateDesignation">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" >
                    <div class="table-responsive">
                        <table class="table table-bordered" id="desigTable" width="100%">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none">id</th>
                                    <th width="75%">Name</th>
                                    <th width="25%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Designations)
                                {
                                    <tr>
                                        <td style="display:none">@d.Id</td>
                                        <td width="75%">@d.Name</td>
                                        <td width="25%">
                                            <a class="btn edit_button eidtDesig"> Edit </a>
                                            <a class="btn deleteBtn"> Delete </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>*@
            <!-- /. tab-2 end -->
            @if (User.HasClaim("Permission", Features.InfoCodeAdministration))
            {
                <!-- tab-3 start -->
                <div class="tab-pane fade @(infoCodeFirst ? "show active" : "")" id="pills-3" role="tabpanel" aria-labelledby="pills-tab-3">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="createInfoCode">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" >
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="tableInfoCode" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Code Set</th>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th>DM Type</th>
                                        <th style="display:none;"></th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.InformationCodes)
                                    {
                                        <tr>
                                            <td style="display:none">@i.Id</td>
                                            <td>@i.InformationCodeSetDescription</td>
                                            <td style="display:none">@i.InformationCodeSetId</td>
                                            <td>@i.Code</td>
                                            <td>@i.Description</td>
                                            <td>@i.DataModuleName</td>
                                            <td style="display:none">@i.DataModuleId</td>
                                            <td class="d-flex">
                                                <a class="btn edit_button editInfoCode"> Edit </a>
                                                <a class="btn deleteInfoCode"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-3 end -->
            }
            @if (User.HasClaim("Permission", Features.InfoCodeSetAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade @(infoCodeSetFirst ? "show active" : "")" id="pills-5" role="tabpanel" aria-labelledby="pills-tab-5">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="createInfoCodeSet">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" >
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="tableInfoCodeSet" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Description</th>
                                        <th>Variant</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.InformationCodesSets)
                                    {
                                        <tr>
                                            <td style="display:none">@i.Id</td>
                                            <td>@i.Description</td>
                                            <td>@i.Variant</td>
                                            <td class="d-flex">
                                                <a class="btn edit_button editInfoCodeSet"> Edit </a>
                                                <a class="btn deleteInfoCodeSet"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-5 end -->
            }
            @if (User.HasClaim("Permission", Features.IcnFormatAdministration))
            {
                <!-- tab-4 start -->
                <div class="tab-pane fade" id="pills-4" role="tabpanel" aria-labelledby="pills-tab-4">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnICNCreate">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" >
                        <div class="table-responsive">
                            <table class="table icn table-bordered" id="tableICNFormat" width="100%">
                                <thead class="thead">
                                    <tr class="text-left">
                                        <th style="display:none"></th>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var icn in Model.Icnformats)
                                    {
                                        <tr>
                                            <td style="display:none">@icn.Id</td>
                                            <td>@icn.Code</td>
                                            <td>@icn.Description</td>
                                            <td>
                                                @if (icn.CanEdit)
                                                {
                                                    <a class="btn edit_button icnEdited"> Edit </a>
                                                    <a class="btn deleteICN"> Delete </a>
                                                    @Html.ListBox("IcnFormatListBox" + @icn.Id, new SelectList(icn.IcnFormatFields, "ICNFormatMasterFieldId","Field"), new { @class="form-control", @style="display:none" })
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-4 end -->
            }
            @if (User.HasClaim("Permission", Features.LocationCodeSetAdministration))
            {
                <!-- tab-6 start -->
                <div class="tab-pane fade @(locCodeSetFirst ? "show active" : "")" id="pills-6" role="tabpanel" aria-labelledby="pills-tab-6">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateLocationCodeSet">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="tableLocationCodeSet" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Description</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.LocationCodesSets)
                                    {
                                        <tr>
                                            <td style="display:none">@i.Id</td>
                                            <td>@i.Description</td>
                                            <td class="d-flex">
                                                <a class="btn edit_button editLocationCodeSet"> Edit </a>
                                                <a class="btn deleteLocationCodeSet"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-6 end -->
            }
            @if (User.HasClaim("Permission", Features.LocationCodeAdministration))
            {
                <!-- tab-7 start -->
                <div class="tab-pane fade @(locCodeFirst ? "show active" : "")" id="pills-7" role="tabpanel" aria-labelledby="pills-tab-7">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateLocationCode">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="locationCodeTable" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Code Set</th>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th width="20%">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.LocationCodes)
                                    {
                                        <tr>
                                            <td style="display:none">@l.Id</td>
                                            <td>@l.LocationCodeSetDescription</td>
                                            <td>@l.Code</td>
                                            <td>@l.Description</td>
                                            <td width="20%">
                                                <a class="btn edit_button locationEdit"> Edit </a>
                                                <a class="btn locationDelete"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-7 end -->
            }
            @if (User.HasClaim("Permission", Features.RPCAdministration))
            {
                <!-- tab-8 start -->
                <div class="tab-pane fade @(rpcFirst ? "show active" : "")" id="pills-8" role="tabpanel" aria-labelledby="pills-tab-8">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="CreateRPCCode">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="resPartnerCodeTable" width="100%">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"> </th>
                                        <th>Code </th>
                                        <th>RPC Cage</th>
                                        <th>Orginator Cage</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.ResponsiblePartnerCodes)
                                    {
                                        <tr style="background:#fff">
                                            <td style="display:none">@r.Id</td>
                                            <td>@r.Code</td>
                                            <td>@r.Rpccage</td>
                                            <td>@r.OrginatorCage</td>
                                            <td>
                                                <a class="btn edit_button editRPC"> Edit </a>
                                                <a class="btn deleteRPC"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-8 end -->
            }
        </div>
    </div>
    <!-- /. vtab-content -->
</div>
<!-- /. page-body -->

@*  Location Code Set*@
<div class="modal fade" id="locatonCodeSetmdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header btn">
                <h4 class="modal-title modelTitle">Create Location Code Set</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCSetMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocSetId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtLocSetDescription" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="SaveLocationCodeSet" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*  Location Code*@
<div class="modal fade" id="locatonCodemdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header btn">
                <h4 class="modal-title modelTitle">Create Location Code</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code Set</label>
                                    @Html.DropDownList("LocationCodeSetDropDown", new SelectList(Model.LocationCodesSets, "Id", "Description"), "Please Select", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label>
                                    <input class="form-control 1charonly" maxlength="1" id="txtLocCode" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <input class="form-control" id="txtLocDescription" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="SaveLocationCode" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* RPC *@
<div class="modal fade" id="rpcModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header btn">
                <h4 class="modal-title modelDeprtTitle">Create RPC</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorRPCMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnRPCId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtRPCCode" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">RPC Cage</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtRpcCage" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Orginator Cage</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtOrginatorCage" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="btnRPCSave" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" style=" -moz-border-radius:10px;" id="Configurationmdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelIssueNoTitle"></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateIssueNo" asp-controller="Configuration" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="hdnId" id="hdnId" value="0" />
                    <label id="errorMsg" style="color:red"></label>
                    <div class="mb-3">
                        <label class="form-label">Issue No <span style="color:red">*</span></label>
                        <input class="form-control" type="text" name="txtIssueNo" id="txtIssueNo" />
                    </div>
                    <div class="mb-3" id="brexFileRow">
                        <label class="form-label">BREX File Template <span style="color:red" id="brexRequired">*</span></label>
                        <input class="form-control" type="file" name="brexFile" id="brexFile" accept=".xml">
                        <small class="text-muted" id="brexEditHint" style="display:none">Leave empty to keep existing template</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">XSD Schema Files</label>
                        <input type="file" class="form-control" id="xsdFilesInput" multiple accept=".xsd">
                        <div id="xsdMessages" class="mt-1"></div>
                        <!-- Chips -->
                        <div id="xsdFileList" class="d-flex flex-wrap gap-1 mt-2"></div>
                        <!-- Shared content viewer (shown when a chip is clicked) -->
