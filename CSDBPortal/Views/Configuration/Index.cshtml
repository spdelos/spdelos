        padding: 5px !important;
        vertical-align: middle;
    }


    table > tbody > tr > td {
        padding: 5px !important;
        vertical-align: middle;
    }

    .table > tbody > tr {
        padding: 5px !important;
        vertical-align: middle;
    }

    table > tbody > tr {
        padding: 5px !important;
        vertical-align: middle;
    }

    .table > tbody > tr > td {
        padding: 5px !important;
        vertical-align: middle;
    }
