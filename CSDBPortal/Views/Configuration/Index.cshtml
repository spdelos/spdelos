                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Code Set</th>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th>DM Type</th>
                                        <th style="display:none;"></th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.InformationCodes)
                                    {
                                        <tr>
                                            <td style="display:none">@i.Id</td>
                                            <td>@i.InformationCodeSetDescription</td>
                                            <td style="display:none">@i.InformationCodeSetId</td>
                                            <td>@i.Code</td>
                                            <td>@i.Description</td>
                                            <td>@i.DataModuleName</td>
                                            <td style="display:none">@i.DataModuleId</td>
                                            <td class="d-flex">
