        for (let i = 0; i < $("#IcnFormatMasterFieldDestinationListBox").prop("options").length; i++) {

            var icnFormatField = {}
            icnFormatField.ICNFormatMasterFieldId = $("#IcnFormatMasterFieldDestinationListBox").prop("options")[i].value;
            icnFormatField.ICNFormatId = icnFormat.Id;
            icnFormatField.DisplayOrder = i;
            icnFormat.Fields.push(icnFormatField);
