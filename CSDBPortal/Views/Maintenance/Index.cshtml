@model CSDBPortal.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Maintenance";

    bool hasLocCodeSet = User.HasClaim("Permission", Features.LocationCodeSetAdministration);
    bool hasLocCode    = User.HasClaim("Permission", Features.LocationCodeAdministration);
    bool hasRPC        = User.HasClaim("Permission", Features.RPCAdministration);
    bool hasDMType     = User.HasClaim("Permission", Features.DataModuleTypeAdministration);
    bool hasSNS        = User.HasClaim("Permission", Features.SNSAdministration);
    bool hasProject    = User.HasClaim("Permission", Features.ProjectAdministration);
    bool hasDMC        = User.HasClaim("Permission", Features.DMCAdministration);

    bool _m = true;
    bool locCodeSetFirst = _m && hasLocCodeSet; if (hasLocCodeSet) _m = false;
    bool locCodeFirst    = _m && hasLocCode;    if (hasLocCode)    _m = false;
    bool rpcFirst        = _m && hasRPC;        if (hasRPC)        _m = false;
    bool dmTypeFirst     = _m && hasDMType;     if (hasDMType)     _m = false;
    bool snsFirst        = _m && hasSNS;        if (hasSNS)        _m = false;
    bool projectFirst    = _m && hasProject;    if (hasProject)    _m = false;
    bool dmcFirst        = _m && hasDMC;
}

<div class="alert" style="display:none" id="mainAlert">
    <span id="alertMessage">This alert box could indicate a successful or positive action.</span>
</div>

<div class="maint-shell">

    <!-- ── Secondary Navigation Panel ── -->
    <aside class="maint-panel">
        <div class="maint-panel-header">
            <div class="maint-panel-title">Maintenance</div>
            <div class="maint-panel-sub">Project data &amp; structures</div>
        </div>

        <nav class="maint-panel-nav" id="pills-tab" role="tablist">

            @if (hasLocCodeSet)
            {
                <a class="maint-nav-item @(locCodeSetFirst ? "active" : "")" id="pills-tab-6"
                   data-bs-toggle="tab" href="#pills-6" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-map-pin"></i></span>
                    <span>Location Code Sets</span>
                </a>
            }
            @if (hasLocCode)
            {
                <a class="maint-nav-item @(locCodeFirst ? "active" : "")" id="pills-tab-1"
                   data-bs-toggle="tab" href="#pills-1" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-location-dot"></i></span>
                    <span>Location Codes</span>
                </a>
            }
            @if (hasRPC)
            {
                <a class="maint-nav-item @(rpcFirst ? "active" : "")" id="pills-tab-2"
                   data-bs-toggle="tab" href="#pills-2" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-building"></i></span>
                    <span>RPC</span>
                </a>
            }
            @if (hasDMType)
            {
                <a class="maint-nav-item @(dmTypeFirst ? "active" : "")" id="pills-tab-3"
                   data-bs-toggle="tab" href="#pills-3" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-layer-group"></i></span>
                    <span>Data Module Types</span>
                </a>
            }
            @if (hasSNS)
            {
                <a class="maint-nav-item @(snsFirst ? "active" : "")" id="pills-tab-4"
                   data-bs-toggle="tab" href="#pills-4" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-sitemap"></i></span>
                    <span>SNS</span>
                </a>
            }
            @if (hasProject)
            {
                <a class="maint-nav-item @(projectFirst ? "active" : "")" id="pills-tab-5"
                   data-bs-toggle="tab" href="#pills-5" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-folder-open"></i></span>
                    <span>Projects</span>
                </a>
            }
            @if (hasDMC)
            {
                <a class="maint-nav-item @(dmcFirst ? "active" : "")" id="pills-tab-7"
                   data-bs-toggle="tab" href="#pills-7" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-file-code"></i></span>
                    <span>DMC</span>
                </a>
            }
        </nav>
    </aside>

    <!-- ── Main Content ── -->
    <div class="maint-content">
        <div class="tab-content" id="pills-tabContent">
            @if (User.HasClaim("Permission", Features.LocationCodeSetAdministration))
            {
                <!-- tab-1 start -->
                <div class="tab-pane fade @(locCodeFirst ? "show active" : "")" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateLocationCode">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="locationCodeTable" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Code Set</th>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th width="20%">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.LocationCodes)
                                    {
                                        <tr>
                                            <td style="display:none">@l.Id</td>
                                            <td>@l.LocationCodeSetDescription</td>
                                            <td>@l.Code</td>
                                            <td>@l.Description</td>
                                            <td width="20%">
                                                <a class="btn edit_button locationEdit"> Edit </a>
                                                <a class="btn locationDelete"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-1 end -->
            }
            @if (User.HasClaim("Permission", Features.LocationCodeAdministration))
            {
                <!-- tab-6 start -->
                <div class="tab-pane fade @(locCodeSetFirst ? "show active" : "")" id="pills-6" role="tabpanel" aria-labelledby="pills-tab-6">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateLocationCodeSet">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive info_table">
                            <table class="table table-bordered" id="tableLocationCodeSet" width="100%">
                                <thead class="thead text-center">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th>Description</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.LocationCodesSets)
                                    {
                                        <tr>
                                            <td style="display:none">@i.Id</td>
                                            <td>@i.Description</td>
                                            <td class="d-flex">
                                                <a class="btn edit_button editLocationCodeSet"> Edit </a>
                                                <a class="btn deleteLocationCodeSet"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-6 end -->
            }
            @if (User.HasClaim("Permission", Features.RPCAdministration))
            {
                <!-- tab-2 start -->
                <div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" data-toggle="modal" data-target="#addPostModal" id="CreateRPCCode">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="resPartnerCodeTable" width="100%">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"> </th>
                                        <th>Code </th>
                                        <th>RPC Cage</th>
                                        <th>Orginator Cage</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.ResponsiblePartnerCodes)
                                    {
                                        <tr style="background:#fff">
                                            <td style="display:none">@r.Id</td>
                                            <td>@r.Code</td>
                                            <td>@r.Rpccage</td>
                                            <td>@r.OrginatorCage</td>
                                            <td>
                                                <a class="btn edit_button editRPC"> Edit </a>
                                                <a class="btn deleteRPC"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-2 end -->
            }
            @if (User.HasClaim("Permission", Features.DataModuleTypeAdministration))
            {
                <!-- tab-3 start -->
                <div class="tab-pane fade" id="pills-3" role="tabpanel" aria-labelledby="pills-tab-3">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="CreateDataModuleType">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped">
                            <table class="table table-bordered" width="100%" id="dataModuleTypeTable">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"> </th>
                                        <th>Name </th>
                                        <th>File Name</th>
                                        <th>Created By</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.DataModuleTypes)
                                    {
                                        <tr style="background:#fff">
                                            <td style="display:none">@d.Id</td>
                                            <td>@d.Name</td>
                                            <td>@d.FileName</td>
                                            <td>@d.CreatedBy</td>
                                            <td>
                                                <a class="btn edit_button editDataTypeModule"> Edit </a>
                                                <a class="btn deleteDataTypeModule"> Delete </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-3 end -->
            }
            @if (User.HasClaim("Permission", Features.SNSAdministration))
            {
                <!-- tab-4 start -->
                <div class="tab-pane fade" id="pills-4" role="tabpanel" aria-labelledby="pills-tab-4">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateSNS">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped">
                            <ul id="tree"></ul>

                            @*<table class="table table-bordered" width="100%" id="snsTable">
                        <thead class="thead">
                        <tr>
                        <th style="display:none"> </th>
                        <th>Parent</th>
                        <th>Code</th>
                        <th>Description</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.StandardNumberingSystems)
                        {
                        <tr style="background:#fff;">
                        <td style="display:none">@s.Id</td>
                        <td> @s.ParentCode</td>
                        <td> @s.Code</td>
                        <td>@s.Description</td>
                        </tr>
                        }
                        </tbody>
                        </table>*@
                        </div>
                    </div>
                </div>
                <!-- /. tab-4 end -->
            }
            @if (User.HasClaim("Permission", Features.ProjectAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade" id="pills-5" role="tabpanel" aria-labelledby="pills-tab-5">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateProject">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableProject">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th>Name</th>
                                        <th>Title</th>
                                        <th>Information Code - Variant</th>
                                        <th>ICN Format</th>
                                        <th width="25%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Projects)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.IssueNoId</td>
                                            <td style="display:none">@p.IcnformatId</td>
                                            <td style="display:none">@p.SNSSetId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.SDC</td>
                                            <td style="display:none">@p.ModelIdentification</td>
                                            <td style="display:none">@p.LocationCodeId</td>
                                            <td style="display:none">@p.RPCId</td>
                                            <td>@p.Name</td>
                                            <td>@p.Title</td>
                                            <td>@p.InformationCodeProp - @p.Variant</td>
                                            <td>@p.ICNFormatDescription</td>
                                            <td width="30%">
                                                <a href="#" class="btn edit_button edit_project">Edit</a>
                                                <a href="#" class="btn-sm btn-default project_sns_button">SNS</a>
                                                <a href="#" class="btn-sm btn-primary project_dmc_button">DMC</a>
                                                <a href="#" class="btn-sm btn-primary project_dmc_generate_button">Brex</a>
                                                <a href="#" class="btn-sm btn-primary project_brex_rules_button">Brex Rules</a>
                                                <a href="#" class="btn-sm btn-primary project_navigation_generate_button">Navigation</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-5 end -->
            }

            @if (User.HasClaim("Permission", Features.DMCAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade" id="pills-7" role="tabpanel" aria-labelledby="pills-tab-7">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateDMC">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                                <a href="/Maintenance/DownloadDMCTemplate" class="btn" id="btnDownloadDMCTemplate">
                                    Download Template
                                </a>
                                <form asp-action="UploadDMC" asp-controller="Maintenance" method="post" enctype="multipart/form-data">
                                    <input id="upload" name="upload" style="display:none" type="file" onchange="this.form.submit();" />
                                    <a class="btn" id="btnUploadDMC" name="uploadbutton">Upload</a>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableDMC">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th width="20%">Project Name</th>
                                        <th width="55%">DMC</th>
                                        <th width="5%">XML</th>
                                        <th width="20%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.DataModuleCodes)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.ProjectId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.LocationCodeId</td>

                                            <td width="20%">@p.ProjectName</td>
                                            <td width="55%">@p.DMC</td>
                                            @if (p.xml != null)
                                            {
                                                <td width="5%"><a href="#" class="btn edit_button view_dmc_xml">View</a></td>
                                            }
                                            else
                                            {
                                                <td width="5%"><a href="#" class="btn edit_button generate_DMC">Generate</a></td>
                                            }
                                            <td width="20%">
                                                <a href="#" class="btn edit_button delete_DMC">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-5 end -->
            }
        </div>
    </div>
    <!-- /. maint-content -->
</div>
<!-- /. maint-shell -->

@*  Location Code Set*@
<div class="modal fade"  id="locatonCodeSetmdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelTitle">Create Location Code Set</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCSetMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocSetId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtLocSetDescription" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="SaveLocationCodeSet" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*  Location Code*@
<div class="modal fade"  id="locatonCodemdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelTitle">Create Location Code</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code Set</label>
                                    @Html.DropDownList("LocationCodeSetDropDown", new SelectList(Model.LocationCodesSets, "Id","Description"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label>
                                    <input class="form-control 1charonly" maxlength="1" id="txtLocCode"> </input>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <input class="form-control" id="txtLocDescription"> </input>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button id="SaveLocationCode" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* SNS *@
<div class="modal fade"  id="snsModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelSnsTitle">Create Standard Number System</h4>
                <button type="button" class="btn-close-sns" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorSnsMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnSnsId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtSnsCode" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <textarea class="form-control" style="width:325px;height:75px;" id="txtSnsDescription"> </textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Parent</label>
                                    @*@Html.DropDownList("SnsParentDropDown", new SelectList(Model.StandardNumberingSystems, "Id","Code"), "Please Select", new { @class="form-control" })*@
                                    <select class="form-select form-control" aria-label="Default select example" required id="SnsParentDropDown"></select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="saveSns" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancelsns" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* RPC*@
<div class="modal fade"  id="rpcModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelDeprtTitle">Create RPC</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errordesMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnRPCId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label><span style="color: red;">*</span>
