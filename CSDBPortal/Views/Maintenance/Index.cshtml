@model CSDBPortal.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Manage";

    bool hasSNS        = User.HasClaim("Permission", Features.SNSAdministration);
    bool hasProject    = User.HasClaim("Permission", Features.ProjectAdministration);
    bool hasDMC        = User.HasClaim("Permission", Features.DMCAdministration);
    bool hasAllocation = User.HasClaim("Permission", Features.AllocationAdministration);

    bool _m = true;
    bool snsFirst        = _m && hasSNS;        if (hasSNS)        _m = false;
    bool projectFirst    = _m && hasProject;    if (hasProject)    _m = false;
    bool dmcFirst        = _m && hasDMC;        if (hasDMC)        _m = false;
    bool allocationFirst = _m && hasAllocation; if (hasAllocation) _m = false;
    bool ssFirst         = _m;                  _m = false;
}

<div class="alert" style="display:none" id="mainAlert">
    <span id="alertMessage">This alert box could indicate a successful or positive action.</span>
</div>

<div class="maint-shell">

    <!-- ── Secondary Navigation Panel ── -->
    <aside class="maint-panel">
        <div class="maint-panel-header">
            <div class="maint-panel-title">Manage</div>
            <div class="maint-panel-sub">Project data &amp; structures</div>
        </div>

        <nav class="maint-panel-nav" id="pills-tab" role="tablist">

            @if (hasSNS)
            {
                <a class="maint-nav-item @(snsFirst ? "active" : "")" id="pills-tab-4"
                   data-bs-toggle="tab" href="#pills-4" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-sitemap"></i></span>
                    <span>SNS</span>
                </a>
            }
            @if (hasProject)
            {
                <a class="maint-nav-item @(projectFirst ? "active" : "")" id="pills-tab-5"
                   data-bs-toggle="tab" href="#pills-5" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-folder-open"></i></span>
                    <span>Projects</span>
                </a>
            }
            @if (hasDMC)
            {
                <a class="maint-nav-item @(dmcFirst ? "active" : "")" id="pills-tab-7"
                   data-bs-toggle="tab" href="#pills-7" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-file-code"></i></span>
                    <span>DMC</span>
                </a>
            }
            @if (hasAllocation)
            {
                <a class="maint-nav-item @(allocationFirst ? "active" : "")" id="pills-tab-10"
                   data-bs-toggle="tab" href="#pills-10" role="tab">
                    <span class="mni-icon"><i class="fa-solid fa-people-arrows"></i></span>
                    <span>Allocation</span>
                </a>
            }
            <a class="maint-nav-item" id="pills-tab-8"
               data-bs-toggle="tab" href="#pills-8" role="tab">
                <span class="mni-icon"><i class="fa-solid fa-palette"></i></span>
                <span>Stylesheet</span>
            </a>
            <a class="maint-nav-item" id="pills-tab-9"
               data-bs-toggle="tab" href="#pills-9" role="tab">
                <span class="mni-icon"><i class="fa-solid fa-images"></i></span>
                <span>Images</span>
            </a>
        </nav>
    </aside>

    <!-- ── Main Content ── -->
    <div class="maint-content">
        <div class="tab-content" id="pills-tabContent">
            @if (User.HasClaim("Permission", Features.SNSAdministration))
            {
                <!-- tab-4 start -->
                <div class="tab-pane fade @(snsFirst ? "show active" : "")" id="pills-4" role="tabpanel" aria-labelledby="pills-tab-4">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateSNS">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped">
                            <ul id="tree"></ul>

                            @*<table class="table table-bordered" width="100%" id="snsTable">
                        <thead class="thead">
                        <tr>
                        <th style="display:none"> </th>
                        <th>Parent</th>
                        <th>Code</th>
                        <th>Description</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.StandardNumberingSystems)
                        {
                        <tr style="background:#fff;">
                        <td style="display:none">@s.Id</td>
                        <td> @s.ParentCode</td>
                        <td> @s.Code</td>
                        <td>@s.Description</td>
                        </tr>
                        }
                        </tbody>
                        </table>*@
                        </div>
                    </div>
                </div>
                <!-- /. tab-4 end -->
            }
            @if (User.HasClaim("Permission", Features.ProjectAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade @(projectFirst ? "show active" : "")" id="pills-5" role="tabpanel" aria-labelledby="pills-tab-5">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateProject">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableProject">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th>Name</th>
                                        <th>Title</th>
                                        <th>Information Code - Variant</th>
                                        <th>ICN Format</th>
                                        <th width="25%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Projects)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.IssueNoId</td>
                                            <td style="display:none">@p.IcnformatId</td>
                                            <td style="display:none">@p.SNSSetId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.SDC</td>
                                            <td style="display:none">@p.ModelIdentification</td>
                                            <td style="display:none">@p.LocationCodeId</td>
                                            <td style="display:none">@p.RPCId</td>
                                            <td>@p.Name</td>
                                            <td>@p.Title</td>
                                            <td>@p.InformationCodeProp - @p.Variant</td>
                                            <td>@p.ICNFormatDescription</td>
                                            <td width="30%">
                                                <a href="#" class="btn btn-sm edit_button edit_project">Edit</a>
                                                <a href="#" class="btn btn-sm btn-secondary project_sns_button">SNS</a>
                                                <a href="#" class="btn btn-sm btn-primary project_dmc_button">DMC</a>
                                                <a href="#" class="btn btn-sm btn-primary project_dmc_generate_button">Brex</a>
                                                <a href="#" class="btn btn-sm btn-primary project_brex_rules_button">Brex Rules</a>
                                                <a href="#" class="btn btn-sm btn-primary project_navigation_generate_button">Navigation</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- /. tab-5 end -->
            }

            @if (User.HasClaim("Permission", Features.DMCAdministration))
            {
                <!-- tab-5 start -->
                <div class="tab-pane fade @(dmcFirst ? "show active" : "")" id="pills-7" role="tabpanel" aria-labelledby="pills-tab-7">
                    <div class="actions mb-3">
                        <div class="row">
                            <div class="col-12 text-right">
                                <a href="#" class="btn" id="btnCreateDMC">
                                    <i class="fas fa-plus"></i> Create New
                                </a>
                                <a href="/Maintenance/DownloadDMCTemplate" class="btn" id="btnDownloadDMCTemplate">
                                    Download Template
                                </a>
                                <form class="d-inline" asp-action="UploadDMC" asp-controller="Maintenance" method="post" enctype="multipart/form-data">
                                    <input id="upload" name="upload" style="display:none" type="file" onchange="this.form.submit();" />
                                    <a class="btn" id="btnUploadDMC" name="uploadbutton">Upload</a>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="padding:15px;">
                        <div class="table-responsive table-striped tab_project-table">
                            <table class="table table-bordered" width="100%" id="tableDMC">
                                <thead class="thead">
                                    <tr>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th style="display:none"></th>
                                        <th width="13%">Project Name</th>
                                        <th width="27%">DMC</th>
                                        <th width="10%">XML</th>
                                        <th width="6%">BREX</th>
                                        <th width="8%">Status</th>
                                        <th width="11%">Owner</th>
                                        <th width="11%">Check Out Date</th>
                                        <th width="14%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.DataModuleCodes)
                                    {
                                        <tr style="background:#fff;">
                                            <td style="display:none">@p.Id</td>
                                            <td style="display:none">@p.ProjectId</td>
                                            <td style="display:none">@p.InformationCodeId</td>
                                            <td style="display:none">@p.LocationCodeId</td>

                                            <td width="13%">@p.ProjectName</td>
                                            <td width="27%">@p.DMC</td>
                                            @if (p.xml != null)
                                            {
                                                <td width="10%">
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a href="#" class="btn edit_button view_dmc_xml" title="Open XML in viewer">View</a>
                                                        @if (p.CheckoutStatus == "CheckedOut")
                                                        {
                                                            <a href="#" class="btn edit_button checkin_dmc" title="Upload and check in">Check In</a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn edit_button checkout_dmc_xml" title="Download and check out">Check Out</a>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td width="10%"><a href="#" class="btn edit_button generate_DMC">Generate</a></td>
                                            }
                                            <td width="6%">
                                                @if (p.ValidationStatus == true)
                                                {
                                                    <span class="badge bg-success" title="@p.ValidationMessage">Pass</span>
                                                }
                                                else if (p.ValidationStatus == false)
                                                {
                                                    <span class="badge bg-danger brex-fail-badge" style="cursor:pointer" title="@p.ValidationMessage">Fail</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">—</span>
                                                }
                                            </td>
                                            <td width="8%">
                                                @if (p.xml == null)
                                                {
                                                    <span class="badge bg-secondary">—</span>
                                                }
                                                else if (p.CheckoutStatus == "CheckedOut")
                                                {
                                                    <span class="badge bg-warning text-dark">Checked Out</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                            </td>
                                            <td width="11%">@(p.CheckedOutBy ?? "—")</td>
                                            <td width="11%">@(p.CheckedOutOn.HasValue ? p.CheckedOutOn.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "—")</td>
                                            <td width="14%">
                                                @if (p.xml != null)
                                                {
                                                    <a href="#" class="btn edit_button validate_DMC">Validate</a>
                                                }
                                                <a href="#" class="btn edit_button delete_DMC">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Check In Modal -->
                <div class="modal fade" id="checkinModal" tabindex="-1" aria-labelledby="checkinModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="checkinModalLabel">Check In XML</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted mb-2">DMC: <strong id="checkinDmcName"></strong></p>
                                <p class="mb-3">Upload the modified XML file. The system will verify that the <code>identAndStatusSection</code> is unchanged and that the file passes BREX validation before accepting it.</p>
                                <input type="file" id="checkinFile" class="form-control" accept=".xml" />
                                <div id="checkinMessage" class="mt-3 small" style="display:none;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="btnCheckinSubmit">Check In</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- /. tab-5 end -->
            }
            @if (hasAllocation)
            {
                <!-- tab-10 Allocation start -->
                <div class="tab-pane fade @(allocationFirst ? "show active" : "")" id="pills-10" role="tabpanel" aria-labelledby="pills-tab-10">
                    <div class="card mb-3" style="padding:15px;">
                        <label class="input-title">Select Project</label>
                        <select class="form-select form-control" id="allocProjectDrop">
                            <option value="">-- Select a Project --</option>
                            @foreach (var proj in Model.Projects)
                            {
                                <option value="@proj.Id">@proj.Title</option>
                            }
                        </select>
                    </div>

                    <div id="allocContent" style="display:none;">
                        <ul class="nav nav-pills tab-header mb-3" id="allocTabs" role="tablist">
                            <li class="nav-item item-one" role="presentation">
                                <a class="nav-link active" id="alloc-tab-1" data-bs-toggle="pill" href="#alloc-1" role="tab">
                                    <i class="fa-solid fa-users"></i> Users
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="alloc-tab-2" data-bs-toggle="pill" href="#alloc-2" role="tab">
                                    <i class="fa-solid fa-file-code"></i> Authoring
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="alloc-tab-3" data-bs-toggle="pill" href="#alloc-3" role="tab">
                                    <i class="fa-solid fa-images"></i> Illustration
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content" id="allocTabContent">

                            <!-- Alloc Tab 1: Users -->
                            <div class="tab-pane fade show active" id="alloc-1" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="row mb-3">
                                        <div class="col-md-4">
                                            <label class="input-title">Filter by Role</label>
                                            <select class="form-select form-control" id="allocRoleFilter">
                                                <option value="">All Roles</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocUsersTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th style="width:40px;"></th>
                                                    <th>User Name</th>
                                                    <th>Email</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocUsersBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Alloc Tab 2: Authoring (DMCs) -->
                            <div class="tab-pane fade" id="alloc-2" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocDMCTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th width="70%">DMC</th>
                                                    <th width="30%">Assigned To</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocDMCBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Alloc Tab 3: Illustration (ICNs) -->
                            <div class="tab-pane fade" id="alloc-3" role="tabpanel">
                                <div class="card" style="padding:15px;">
                                    <div class="table-responsive table-striped">
                                        <table class="table table-bordered" id="allocICNTable">
                                            <thead class="thead">
                                                <tr>
                                                    <th width="70%">ICN</th>
                                                    <th width="30%">Assigned To</th>
                                                </tr>
                                            </thead>
                                            <tbody id="allocICNBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- /. tab-10 Allocation end -->
            }

            <div class="tab-pane fade @(ssFirst ? "show active" : "")" id="pills-8" role="tabpanel" aria-labelledby="pills-tab-8">
                <div class="card" style="padding:20px;">
                    <p class="text-muted mb-0">Stylesheet management coming soon.</p>
                </div>
            </div>
            <div class="tab-pane fade" id="pills-9" role="tabpanel" aria-labelledby="pills-tab-9">
                <div class="card" style="padding:20px;">
                    <p class="text-muted mb-0">Images management coming soon.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- /. maint-content -->
</div>
<!-- /. maint-shell -->

@* SNS *@
<div class="modal fade"  id="snsModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelSnsTitle">Create Standard Number System</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorSnsMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnSnsId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtSnsCode" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <textarea class="form-control" style="width:325px;height:75px;" id="txtSnsDescription"> </textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Parent</label>
                                    @*@Html.DropDownList("SnsParentDropDown", new SelectList(Model.StandardNumberingSystems, "Id","Code"), "Please Select", new { @class="form-control" })*@
                                    <select class="form-select form-control" aria-label="Default select example" required id="SnsParentDropDown"></select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="saveSns" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancelsns" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Project *@
<div class="modal fade"  id="projectModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" >
            <div class="modal-header btn" >
                <h4 class="modal-title modelProjectTitle">Create Project</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorprojMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnProjectId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Project Name</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtProjectName" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Project Description</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtProjectDescription" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Issue Type</label><span style="color: red;">*</span>
                                    @Html.DropDownList("IssueTypeDropDown", new SelectList(Model.Issues, "Id","Name"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">ICN Format</label><span style="color: red;">*</span>
                                    @Html.DropDownList("ICNFormatDropDown", new SelectList(Model.Icnformats, "Id","Description"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">SNS Set</label>
                                    @Html.DropDownList("SNSSetDropDown", new SelectList(Model.StandardNumberingSystems.Where(s => s.ParentId == 0), "Id","Description"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Information Code Set</label>
                                    @Html.DropDownList("InformationCodeDropDown", new SelectList(Model.InformationCodeSets, "Id","Description"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">System Difference Code(SDC)</label>
                                    <input class="form-control" type="text" id="txtSystemDifferenceCode" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Model Identification</label>
                                    <input class="form-control" type="text" id="txtModelIdentification" />
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Location Code Set</label>
                                    @Html.DropDownList("LocationCodeDropDown", new SelectList(Model.LocationCodesSets, "Id","Description"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Responsible Partner Company (RPC) Code</label>
                                    @Html.DropDownList("RpcCodeDropDown", new SelectList(Model.ResponsiblePartnerCodes, "Id","Code"), "Please Select", new { @class="form-control" })
                                </div>
                            </div>
                            <div class="col-md-12">
