@section Scripts {

    <script type="text/javascript">

        var projectSTandardNumberingSystemDropDownData = [];
        var standardNumberingSystemDropDownData = [];
        @foreach (var s in Model.StandardNumberingSystems)
        {
            @:var obj = { "id": @s.Id, "code": '@s.Code' };
            @:standardNumberingSystemDropDownData.push(obj);
        }

        var projectSns = false;
        var sortable = new TreeSortable("#tree");

        var data = [];
        @foreach (var d in Model.StandardNumberingSystems)
        {
            @:var obj = { "id": @d.Id, "parent_id": @d.parent_id, "title": "@d.title", "level": @d.level };
            @:data.push(obj);
        }

        var tree = $("#tree");
        var content = data.map(sortable.createBranch);

        tree.html(content);
        sortable.run();

        const delay = () => {
            return new Promise(resolve => {
                setTimeout(() => {
                    resolve();
                }, 1000);
            });
        };

        sortable.onSortCompleted(async (event, ui) => {
            await delay();
            console.log(ui.item);
        });

        $(document).on("click", ".add-child", function(e) {
            var selectedParent = $(this).getSelectedBranch();
            const parent = selectedParent.innerText.split(" : ");

            
            $('#hdnSnsId').val('0');
            $('#txtSnsCode').val('');
            $('#txtSnsDescription').val('');
            $("#projectSnsModel").modal('hide');

            if (selectedParent.attributes['data-treename'].value == "#projectSnsTree") {
                projectSns = true;

                var $dropdown = $("#SnsParentDropDown");
                $dropdown.empty();
                $.each(projectSTandardNumberingSystemDropDownData, function() {
                    $dropdown.append($("<option />").val(this.id).text(this.code));
                });
            }
            else
            {
                projectSns = false;

                var $dropdown = $("#SnsParentDropDown");
                $dropdown.empty();
                $.each(standardNumberingSystemDropDownData, function() {
                    $dropdown.append($("<option />").val(this.id).text(this.code));

                });
            }

            $("#SnsParentDropDown").val(selectedParent.dataset.id);
            $("#snsModel").modal('show');
        });

        $(document).on("click", ".edit-item", function(e) {
            var selectedParent = $(this).getSelectedBranch();
            var parent = selectedParent.innerText.split(" : ");
            $('#txtSnsCode').val(parent[0]);
            $('#txtSnsDescription').val(parent[1]);
            $('#hdnSnsId').val(selectedParent.attributes['data-id'].value);
            

            $("#saveSns").html("Update");
            $(".modelSnsTitle").html("Edit Standard Number Systemt");
            $("#projectSnsModel").modal('hide');

            if (selectedParent.attributes['data-treename'].value == "#projectSnsTree") {
                projectSns = true;

                var $dropdown = $("#SnsParentDropDown");
                $.each(projectSTandardNumberingSystemDropDownData, function() {
                    $dropdown.append($("<option />").val(this.id).text(this.code));
                });
            }
            else
            {
                projectSns = false;

                var $dropdown = $("#SnsParentDropDown");
                $.each(standardNumberingSystemDropDownData, function() {
                    $dropdown.append($("<option />").val(this.id).text(this.code));

                });
            }

            $("#SnsParentDropDown").val(selectedParent.attributes['data-parent'].value);
            $("#snsModel").modal('show');
        });


        $(document).on("click", ".remove-branch", function(e) {
            e.preventDefault();

            const confirm = window.confirm("Are you sure you want to delete this branch?");
            if (!confirm) {
                return;
            }

            var selectedParent = $(this).getSelectedBranch();

            var id = selectedParent.attributes['data-id'].value;

            $.ajax({
                type: "POST",
                url: "Maintenance/DeleteSns",
                data: { id: id },
                dataType: "json",
                success: function(data) {
                    location.reload();
                }
            });
        });

        var responsiblePartnerCodes = [];
