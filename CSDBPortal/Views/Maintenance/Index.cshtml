                var brexColumns = [
                    { title: "Id", className: "brexRuleId" },
                    { title: "Schema", className: "editableColumn brexRuleSchema" },
                    { title: "Rule", className: "editableColumn brexRuleRule" },
                    { title: "Xml Tag", className: "editableColumn brexRuleXmlTag" },
