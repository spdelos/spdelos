                var issueTypeId = rowobj.find("td:eq(1)").text();
                var icnFormatId = rowobj.find("td:eq(2)").text();
                var snsSetId = rowobj.find("td:eq(3)").text();
                var informationCodeId = rowobj.find("td:eq(4)").text();
                var sdc = rowobj.find("td:eq(5)").text();
                var modelIdentification = rowobj.find("td:eq(6)").text();
                var locationCodeId = rowobj.find("td:eq(7)").text();
                var rpcId = rowobj.find("td:eq(8)").text();
                var name = rowobj.find("td:eq(9)").text();
                var projectCode = rowobj.find("td:eq(10)").text();
                var title = rowobj.find("td:eq(11)").text();

                $("#hdnProjectId").val(id);
                $("#txtProjectName").val(name);
                $("#txtProjectDescription").val(title);

                $("#IssueTypeDropDown").val(issueTypeId);
                $("#ICNFormatDropDown").val(icnFormatId);
                $("#SNSSetDropDown").val(snsSetId);
                $("#SNSSetDropDown").prop('disabled', true);
                $("#InformationCodeDropDown").val(informationCodeId);

                $("#txtSystemDifferenceCode").val(sdc);
                $("#txtModelIdentification").val(modelIdentification);

                $("#LocationCodeDropDown").val(locationCodeId);
                $("#RpcCodeDropDown").val(rpcId);
                $("#RpcCodeDropDown").change();

                $("#btnProjectSave").html("Update");
                $(".modelProjectTitle").html("Edit Project");
                $("#projectModel").modal('show');
            });

            var snsTable = $('#snsTable').DataTable();
            $("#btnCreateSNS").click(function () {
                $('#hdnSnsId').val('0');
                $('#txtSnsCode').val('');
                $('#txtSnsDescription').val('');
                $("#SnsParentDropDown").val('');
                $("#snsModel").modal('show');
            });

            $("#saveSns").click(function () {
                if ($('#txtSnsCode').val() == '') {
                    $('#txtSnsCode').css('border-color', 'red');
                    return false;
                }
                else {
                    $('#txtSnsCode').css('border-color', '');
                }

                if (selectedProject > 0) {

                    var projectSns = {}
                    projectSns.ProjectId = selectedProject;
                    projectSns.Snsid = $('#hdnSnsId').val();
                    projectSns.Code = $('#txtSnsCode').val();
                    projectSns.Description = $('#txtSnsDescription').val();
                    projectSns.ParentId = $('#SnsParentDropDown').val();

                    $.ajax({
                        type: "POST",
                        url: "Maintenance/CreateProjectSns",
                        data: { projectSns: projectSns },
                        dataType: "json",
                        success: function (data) {
                            if (data == 'Duplicate') {
                                $("#errorSnsMsg").html("Duplicate Record.");
                            } else {
                                $("#snsModel").modal('hide');
                                location.reload();
                            }
                        }
                    });

                }
                else {

                    var sns = {}
                    sns.Id = $('#hdnSnsId').val();
                    sns.Code = $('#txtSnsCode').val();
                    sns.Description = $('#txtSnsDescription').val();
                    sns.ParentId = $('#SnsParentDropDown').val();

                    $.ajax({
                        type: "POST",
                        url: "Maintenance/CreateSns",
                        data: { sns: sns },
                        dataType: "json",
                        success: function (data) {
                            if (data == 'Duplicate') {
                                $("#errorSnsMsg").html("Duplicate Record.");
                            } else {
                                $("#snsModel").modal('hide');
                                location.reload();
                            }
                        }
                    });
                }
            });

        });

        // ── Allocation tab ────────────────────────────────────────────────────

        var allocSelectedUsers = [];   // [{ id, userName }] checked in Users tab
        var allocDMCData       = [];   // raw DMC list from server
        var allocICNData       = [];   // raw ICN list from server

        function buildUserOptions(includeBlank) {
            var html = includeBlank ? '<option value="">-- Unassigned --</option>' : '';
            allocSelectedUsers.forEach(function (u) {
                html += '<option value="' + u.id + '">' + escHtml(u.userName) + '</option>';
            });
            return html;
        }

        function escHtml(s) {
            return $('<div>').text(s || '').html();
        }

        function rebuildAssignmentDropdowns() {
            var opts = buildUserOptions(true);
            $('#allocDMCBody .alloc-dmc-dd').each(function () {
                var cur = $(this).val();
                $(this).html(opts);
                $(this).val(cur);
            });
            $('#allocICNBody .alloc-icn-dd').each(function () {
                var cur = $(this).val();
                $(this).html(opts);
                $(this).val(cur);
            });
        }

        function renderUsersTable(users) {
            var tbody = $('#allocUsersBody').empty();
            users.forEach(function (u) {
                var checked = allocSelectedUsers.some(function (s) { return s.id === u.id; }) ? 'checked' : '';
                tbody.append(
                    '<tr>' +
                    '<td class="text-center"><input type="checkbox" class="alloc-user-chk" ' +
                    'data-user-id="' + u.id + '" data-user-name="' + escHtml(u.userName) + '" ' + checked + '></td>' +
                    '<td>' + escHtml(u.userName) + '</td>' +
                    '<td>' + escHtml(u.email || '') + '</td>' +
                    '</tr>'
                );
            });
        }

        function renderDMCTable(dmcs) {
            var tbody = $('#allocDMCBody').empty();
            var opts  = buildUserOptions(true);
            dmcs.forEach(function (d) {
                var dd = '<select class="form-select form-control alloc-dmc-dd" data-dmc-id="' + d.id + '">' + opts + '</select>';
                tbody.append('<tr><td>' + escHtml(d.dmc || '') + '</td><td>' + dd + '</td></tr>');
            });
            // Restore saved assignments
            dmcs.forEach(function (d) {
                if (d.assignedTo)
                    $('[data-dmc-id="' + d.id + '"]').val(d.assignedTo);
            });
        }

        function renderICNTable(icns) {
            var tbody = $('#allocICNBody').empty();
            var opts  = buildUserOptions(true);
            icns.forEach(function (i) {
                var dd = '<select class="form-select form-control alloc-icn-dd" data-icn-id="' + i.id + '">' + opts + '</select>';
                tbody.append('<tr><td>' + escHtml(i.number || '') + '</td><td>' + dd + '</td></tr>');
            });
            icns.forEach(function (i) {
                if (i.assignedTo)
                    $('[data-icn-id="' + i.id + '"]').val(i.assignedTo);
            });
        }

        $('#allocProjectDrop').change(function () {
            var projectId = $(this).val();
            if (!projectId) { $('#allocContent').hide(); return; }

            allocSelectedUsers = [];

            // Load roles for filter dropdown
            $.get('/Maintenance/GetAllocationRoles', function (roles) {
                var sel = $('#allocRoleFilter').html('<option value="">All Roles</option>');
                roles.forEach(function (r) {
                    sel.append('<option value="' + r.id + '">' + escHtml(r.name) + '</option>');
                });
            });

            // Load all users
            $.get('/Maintenance/GetAllocationUsers', function (users) {
                renderUsersTable(users);
            });

            // Load DMCs
            $.get('/Maintenance/GetDMCsForAllocation', { projectId: projectId }, function (dmcs) {
                allocDMCData = dmcs;
                renderDMCTable(dmcs);
            });

            // Load ICNs
            $.get('/Maintenance/GetICNsForAllocation', { projectId: projectId }, function (icns) {
                allocICNData = icns;
                renderICNTable(icns);
            });

            $('#allocContent').show();
        });

        $('#allocRoleFilter').change(function () {
            $.get('/Maintenance/GetAllocationUsers', { roleId: $(this).val() }, function (users) {
                renderUsersTable(users);
            });
        });

        $(document).on('change', '.alloc-user-chk', function () {
            var id   = $(this).data('user-id');
            var name = $(this).data('user-name');
            if ($(this).is(':checked')) {
                if (!allocSelectedUsers.some(function (u) { return u.id === id; }))
                    allocSelectedUsers.push({ id: id, userName: name });
            } else {
                allocSelectedUsers = allocSelectedUsers.filter(function (u) { return u.id !== id; });
            }
            rebuildAssignmentDropdowns();
        });

        $(document).on('change', '.alloc-dmc-dd', function () {
            $.post('/Maintenance/SaveDMCAssignment', { dmcId: $(this).data('dmc-id'), userId: $(this).val() });
        });

        $(document).on('change', '.alloc-icn-dd', function () {
            $.post('/Maintenance/SaveICNAssignment', { icnId: $(this).data('icn-id'), userId: $(this).val() });
        });

    </script>
}