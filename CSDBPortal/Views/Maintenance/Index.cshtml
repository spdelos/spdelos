        //Data Module Type
        var dataModuleTypeTable = $('#dataModuleTypeTable').DataTable();
        $("#CreateDataModuleType").click(function() {
            $('#hdnModuleId').val('0');
            $('#txtDataTypeModule').val('');
            $('#txtDataTypeFileName').val('');
            $("#errorDMTMsg").html('');
            $(".modelTitle").html("Create Data Module Type");
            $("#btnDMTypeSave").html("Save");
            $("#DataModuleTypeModel").modal('show');
        });

        // Save Data Module Type
        $("#btnDMTypeSave").click(function() {
            if ($('#txtDataTypeModule').val() == '') {
                $('#txtDataTypeModule').css('border-color', 'red');
                return false;
            }
            else {
                $('#txtDataTypeModule').css('border-color', '');
            }

            var dataModuleType = {}
            dataModuleType.Id = $('#hdnModuleId').val();
            dataModuleType.Name = $('#txtDataTypeModule').val();
            dataModuleType.FileName = $('#txtDataTypeFileName').val();

            $.ajax({
                type: "POST",
                url: "Maintenance/CreateDataTypeModule",
                data: { dataModuleType: dataModuleType },
                dataType: "json",
                success: function(data) {
                    if (data == 'Duplicate') {
                        $("#errorDMTMsg").html("Duplicate Record.");
                    } else {
                        $("#DataModuleTypeModel").modal('hide');
                        location.reload();
                    }
                }
            });
        });

        //edit Data Module Type
        $('#dataModuleTypeTable tbody').on('click', '.editDataTypeModule', function() {
            var rowobj = $(this).closest("tr");
            var id = rowobj.find("td:eq(0)").text();
            var name = rowobj.find("td:eq(1)").text();
            var filename = rowobj.find("td:eq(2)").text();
            $("#txtDataTypeModule").val(name);
            $("#txtDataTypeFileName").val(filename);
            $("#hdnModuleId").val(id);
            $("#btnDMTypeSave").html("Update");
            $(".modelTitle").html("Edit Data Module Type");
            $("#DataModuleTypeModel").modal('show');
        });

        //Delete Data Module Type
        $('#dataModuleTypeTable tbody').on('click', '.deleteDataTypeModule', function() {
            var Id = $(this).closest("tr").find("td:eq(0)").text();
            $.confirmModal('Are you sure to delete this record?', function(el) {
                $.ajax({
                    type: "POST",
                    url: "Maintenance/DeleteDataTypeModule",
                    data: { id: Id },
                    dataType: "json",
                    success: function(data) {
                        location.reload();
                    }
                });
            });
        });
    </script>
}