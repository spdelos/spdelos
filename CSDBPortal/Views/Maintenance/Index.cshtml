                        var rows = data.map(function (obj) {
                            return [obj.id, obj.group, obj.ruleName, obj.xmlTag,
                                obj.subXmlTag, obj.type, obj.length, obj.rangeValue, obj.matchValue, obj.attributeName];
                        });
                        projectBrexRulesTable.rows.add(rows).draw();
                    },
                    error: function (xhr, status, error) {
                        console.error('GetBrexRules failed:', status, error, xhr.responseText);
                    }
                });

                $("#projectBrexRulesModel").modal('show');
            });


