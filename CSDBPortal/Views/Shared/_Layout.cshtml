<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — CSDB" : "CSDB")</title>

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- App styles -->
    <link rel="stylesheet" href="~/dist/css/style.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <!-- Tree / Select2 -->
    <link href="~/css/treeSortable.css" rel="stylesheet" />
    <link href="~/css/jqtree.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
</head>

<body>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="app-shell">

            <!-- ═══════ SIDEBAR ═══════ -->
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-brand">
                    <img src="~/dist/img/logo-1.png" alt="NavIETM" class="sidebar-brand-navietm" />
                </div>

                <nav class="sidebar-nav">
                    <div class="sidebar-section-label">Modules</div>

                    <a href="Administration" class="sidebar-nav-link mylink" id="adminlink">
                        <span class="sidebar-nav-icon"><i class="fa-solid fa-chart-pie"></i></span>
                        <span class="sidebar-nav-label">Administration</span>
                    </a>
                    <a href="Configuration" class="sidebar-nav-link mylink" id="configlink">
                        <span class="sidebar-nav-icon"><i class="fa-solid fa-sliders"></i></span>
                        <span class="sidebar-nav-label">Configuration</span>
                    </a>
                    <a href="Maintenance" class="sidebar-nav-link mylink" id="mainlink">
                        <span class="sidebar-nav-icon"><i class="fa-solid fa-screwdriver-wrench"></i></span>
                        <span class="sidebar-nav-label">Maintenance</span>
                    </a>
                    <a href="ICN" class="sidebar-nav-link mylink" id="icnlink">
                        <span class="sidebar-nav-icon"><i class="fa-solid fa-hashtag"></i></span>
                        <span class="sidebar-nav-label">ICN Numbers</span>
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <div class="sidebar-user-avatar">
                            @(Context.User.Identity.Name?.Length > 0
                                ? Context.User.Identity.Name.Substring(0, 1).ToUpper()
                                : "U")
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">@Context.User.Identity.Name</div>
                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })"
                                  method="post"
                                  style="display:inline">
                                <button type="submit" class="sidebar-logout-btn">Sign out</button>
                            </form>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- ═══════ MAIN AREA ═══════ -->
            <div class="app-main">

                <!-- Top Bar -->
                <header class="app-topbar">
                    <button class="sidebar-toggle" id="sidebarToggle"
                            onclick="document.getElementById('appSidebar').classList.toggle('collapsed')"
                            title="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <nav class="topbar-breadcrumb">
                        <img src="~/dist/img/logo-2.png" alt="CSDB" class="topbar-csdb-logo" />
                        <span class="breadcrumb-sep"><i class="fa-solid fa-chevron-right"></i></span>
                        <span class="breadcrumb-current">@ViewData["Title"]</span>
                    </nav>

                    <div class="topbar-actions">
                        <div class="topbar-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="search" placeholder="Search…" autocomplete="off" />
                        </div>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="app-content">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer">
                    <span>Support: 1-800-258-IETM</span>
                    <span class="ms-auto">NavIETM® CSDB</span>
                </footer>
            </div>

        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/dist/js/jquery.min.js"></script>
    <script src="~/dist/js/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap 5 jQuery compatibility shim (modal + tab) -->
    <script>
    (function ($) {
        if (!$ || !window.bootstrap) return;
        // $.fn.modal — allows legacy $().modal('show'/'hide') calls
        $.fn.modal = function (action) {
            return this.each(function () {
                var m = bootstrap.Modal.getOrCreateInstance(this);
                if (action === 'show')    m.show();
                else if (action === 'hide')    m.hide();
                else if (action === 'toggle')  m.toggle();
                else if (action === 'dispose') m.dispose();
            });
        };
        // $.fn.tab — allows legacy $().tab('show') calls
        $.fn.tab = function (action) {
            return this.each(function () {
                if (action === 'show') bootstrap.Tab.getOrCreateInstance(this).show();
            });
        };
    })(window.jQuery);
    </script>

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="~/js/jquery.confirmModal.js"></script>
    <script src="~/js/treeSortable.js"></script>
    <script src="~/js/tree.jquery.js"></script>
    <script type="text/javascript" src="~/js/jquery.autoresize.js"></script>
    <script type="text/javascript" src="~/js/jquery.inline-edit.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
