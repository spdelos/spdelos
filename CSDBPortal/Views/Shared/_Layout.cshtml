<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="">
    <!-- Required meta tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>Administration</title>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/dist/fontawesome/css/all.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/bootstrap.min.css">
    <!-- main -->
    <link rel="stylesheet" href="~/dist/css/style.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <link href="~/css/treeSortable.css" rel="stylesheet" />
    <link href="~/css/jqtree.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />

    <style>
        .table > thead > tr > td, .table-sm > thead > tr > th {
            padding: 5px !important;
            vertical-align: middle;
        }


        .table > tbody > tr > td {
            padding: 5px !important;
            vertical-align: middle;
        }

        .table > tbody > tr > td {
            padding: 5px !important;
            vertical-align: middle;
        }
    </style>
</head>

<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <header>
            <nav class="main-header navbar navbar-expand navbar-white navbar-light fixed-top">
                <div class="bg-blur2"></div>
                <div class="bg-blur"></div>
                <div class="container">
                    <!-- Brand Logo -->
                    <a class="navbar-brand" href="#">
                        <img src="~/dist/img/logo-1.png" alt="Logo" class="brand-image1">
                        <img src="~/dist/img/logo-2.png" alt="Logo" class="brand-image">
                    </a>

                    <!-- Right navbar links -->
                    <!-- Notifications Dropdown Menu -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#">
                                    <img class="mr-1" src="dist/img/Ellipse 1.png" alt="">
                                    @Context.User.Identity.Name
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a href="#" class="dropdown-item">
                                        <i class="fas fa-user mr-2"></i> Admin
                                    </a>
                                    <a href="#" class="dropdown-item">
                                        <i class="fas fa-envelope mr-2"></i> Gmail
                                    </a>
                                    <a href="#" class="dropdown-item">
                                        <i class="fas fa-cog mr-2"></i> Settings
                                    </a>
                                    <a href="#" class="dropdown-item">
                                        <i class="fas fa-question-circle mr-2"></i> Help
                                    </a>
                                    <div class="dropdown-item">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })" method="post">
                                            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="collapse navbar-collapse" id="navbarSupportedContent">
                            <ul class="navbar-nav ml-auto">
                                <li class="nav-item active">
                                    <a class="btn log-in_button" asp-area="Identity" asp-page="/Account/Login">Log In</a>
                                    <a class="btn sign-up_button" asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
                                </li>
                            </ul>
                        </div>
                    }

                </div>
            </nav>
        </header>
        <!-- /.navbar -->
        @if (User.Identity.IsAuthenticated)
        {
            <!-- Main Sidebar Container -->
            <aside class="main-sidebar">
                <!-- Sidebar -->
            <div class="sidebar">
                    <!-- Sidebar Menu -->
                <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                            <li class="nav-item">
                                <a href="Administration" class="nav-link active mylink" id="adminlink">
                                    <p>Administration</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="Configuration" class="nav-link mylink" id="configlink">
                                    <p>
                                        Configuration
                                    </p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="Maintenance" class="nav-link mylink" id="mainlink">
                                    <p>
                                        Maintenance
                                    </p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="ICN" class="nav-link mylink" id="icnlink">
                                    <p>
                                        ICN
                                    </p>
                                </a>
                            </li>
                            <!-- logout area -->
                        <div class="logout-area">
                                <div class="logout-area_content">
                                    <div class="card text-center">
                                        <img src="dist/img/logo-3.png" class="card-img-top" alt="Profile image">
                                        <div class="card-body">
                                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })" method="post">
                                                <button type="submit" class="nav-link btn btn-link text-dark">Log Out</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.logout area -->
                    </ul>
                    </nav>
                    <!-- /.sidebar-menu -->
            </div>
                <!-- /.sidebar -->
        </aside>

            <div class="content-wrapper">
                <div class="content main-content">
                    @RenderBody()
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }


        <!-- /.content -->
        <!-- /.content-wrapper -->
        <!-- Main Footer -->
        <footer class="main-footer fixed-bottom">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="#">Support: 1- 800 -258 - IETM </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/dist/js/jquery.min.js"></script>
    <script src="~/dist/js/jquery-ui.min.js"></script>
    <script src="~/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="~/js/jquery.confirmModal.js"></script>
    <script src="~/js/treeSortable.js"></script>
    <script src="~/js/tree.jquery.js"></script>
    <script type="text/javascript" src="~/js/jquery.autoresize.js"></script>
    <script type="text/javascript" src="~/js/jquery.inline-edit.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>

    @* <script type="text/javascript">
        $('ul li a.mylink').click(function(){
        $("#adminlink").removeClass("active");
        $("#configlink").removeClass("active");
        $("#mainlink").removeClass("active");
        $("#icnlink").removeClass("active");
        $(this).addClass("active");
        });
        </script>*@
    @*   <script src="~/js/site.js" asp-append-version="true"></script>*@
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
