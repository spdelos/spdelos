@model CSDBPortal.ViewModels.MaintenanceViewModel
@{
    ViewData["Title"] = "Maintenance";
}

<style>
    .ml-1 {
        font-size: 12px;
        padding: 2px;
    }
</style>
<div class="row">
    <!-- tab-content -->
    <div class="col-12">
        <ul class="nav nav-pills tab-header mb-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" id="pills-tab-6" data-toggle="pill" href="#pills-6">
                    <img src="./dist/img/Icons/Maintenance/Location Code.png" alt="Location Code icon">
                    <span class="ml-1">Location Code Set</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-1" data-toggle="pill" href="#pills-1">
                    <img src="./dist/img/Icons/Maintenance/Location Code.png" alt="Location Code icon">
                    <span class="ml-1">Location Code</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-2" data-toggle="pill" href="#pills-2">
                    <img src="./dist/img/Icons/Maintenance/Responsible Partner Code.png"
                         alt="Responsible Partner Code icon">
                    <span class="ml-1"> Responsible Partner Code(RPC)</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-3" data-toggle="pill" href="#pills-3">
                    <img src="./dist/img/Icons/Maintenance/Data Module Type.png"
                         alt="Data Module Type icon">
                    <span class="ml-1">Data Module Type</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-4" data-toggle="pill" href="#pills-4">
                    <img src="./dist/img/Icons/Maintenance/Standard Numbering System.png"
                         alt="Standard Numbering System icon">
                    <span class="ml-1"> Standard Numbering System(SNS)</span>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="pills-tab-5" data-toggle="pill" href="#pills-5">
                    <img src="./dist/img/Icons/Maintenance/Project.png" alt="Project icon">
                    <span class="ml-1"> Project</span>
                </a>
            </li>
        </ul>
        <div class="tab-content" id="pills-tabContent">
            <!-- tab-1 start -->
            <div class="tab-pane fade show" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" id="btnCreateLocationCode">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px">
                    <div class="table-responsive info_table">
                        <table class="table table-bordered" id="locationCodeTable" width="100%">
                            <thead class="thead text-center">
                                <tr>
                                    <th style="display:none"></th>
                                    <th>Code Set</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th width="20%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.LocationCodes)
                                    {
                                    <tr>
                                    <td style="display:none">@l.Id</td>
                                    <td>@l.LocationCodeSetDescription</td>
                                    <td>@l.Code</td>
                                    <td>@l.Description</td>
                                    <td width="20%">
                                        <a class="btn edit_button locationEdit"> Edit </a>
                                        <a class="btn locationDelete"> Delete </a>
                                    </td>
                                    </tr>
                                    }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-1 end -->
            <!-- tab-6 start -->
            <div class="tab-pane fade show active" id="pills-6" role="tabpanel" aria-labelledby="pills-tab-6">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" id="btnCreateLocationCodeSet">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px">
                    <div class="table-responsive info_table">
                        <table class="table table-bordered" id="tableLocationCodeSet" width="100%">
                            <thead class="thead text-center">
                                <tr>
                                    <th style="display:none"></th>
                                    <th>Description</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.LocationCodesSets)
                                {
                                    <tr>
                                        <td style="display:none">@i.Id</td>
                                        <td>@i.Description</td>
                                        <td class="d-flex">
                                            <a class="btn edit_button editLocationCodeSet"> Edit </a>
                                            <a class="btn deleteLocationCodeSet"> Delete </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-6 end -->
            <!-- tab-2 start -->
            <div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" data-toggle="modal" data-target="#addPostModal" id="CreateRPCCode">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="resPartnerCodeTable" width="100%">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none"> </th>
                                    <th>Code </th>
                                    <th>RPC Cage</th>
                                    <th>Orginator Cage</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.ResponsiblePartnerCodes)
                                {
                                    <tr style="background:#fff">
                                        <td style="display:none">@r.Id</td>
                                        <td>@r.Code</td>
                                        <td>@r.Rpccage</td>
                                        <td>@r.OrginatorCage</td>
                                        <td>
                                            <a class="btn edit_button editRPC"> Edit </a>
                                            <a class="btn deleteRPC"> Delete </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-2 end -->
            <!-- tab-3 start -->
            <div class="tab-pane fade" id="pills-3" role="tabpanel" aria-labelledby="pills-tab-3">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" id="CreateDataModuleType">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px;">
                    <div class="table-responsive table-striped">
                        <table class="table table-bordered" width="100%" id="dataModuleTypeTable">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none"> </th>
                                    <th>Name </th>
                                    <th>File Name</th>
                                    <th>Created By</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.DataModuleTypes)
                                {
                                    <tr style="background:#fff">
                                        <td style="display:none">@d.Id</td>
                                        <td>@d.Name</td>
                                        <td>@d.FileName</td>
                                        <td>@d.CreatedBy</td>
                                        <td>
                                            <a class="btn edit_button editDataTypeModule"> Edit </a>
                                            <a class="btn deleteDataTypeModule"> Delete </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-3 end -->
            <!-- tab-4 start -->
            <div class="tab-pane fade" id="pills-4" role="tabpanel" aria-labelledby="pills-tab-4">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" id="btnCreateSNS">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px;">
                    <div class="table-responsive table-striped">
                        <table class="table table-bordered" width="100%" id="snsTable">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none"> </th>
                                    <th>Parent</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.StandardNumberingSystems)
                                {
                                    <tr style="background:#fff;">
                                        <td style="display:none">@s.Id</td>
                                        <td> @s.ParentCode</td>
                                        <td> @s.Code</td>
                                        <td>@s.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-4 end -->
            <!-- tab-5 start -->
            <div class="tab-pane fade" id="pills-5" role="tabpanel" aria-labelledby="pills-tab-5">
                <div class="actions mb-3">
                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="#" class="btn" id="btnCreateProject">
                                <i class="fas fa-plus"></i> Create New
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:15px;">
                    <div class="table-responsive table-striped tab_project-table">
                        <table class="table table-bordered" width="100%" id="tableProject">
                            <thead class="thead">
                                <tr>
                                    <th style="display:none"></th>
                                    <th>Name</th>
                                    <th>Project Code</th>
                                    <th>Title</th>
                                    <th>Information Code Variant</th>
                                    <th width="25%">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Projects)
                                {
                                    <tr style="background:#fff;">
                                        <td style="display:none">@p.Id</td>
                                        <td>@p.Name</td>
                                        <td>@p.ProjectCode</td>
                                        <td>@p.Title</td>
                                        <td>@p.InformationCodeProp - @p.Variant</td>
                                        <td width="25%">
                                            <a href="#" class="btn edit_button">Edit</a>
                                            <a href="#" class="btn-sm btn-default">SNS</a>
                                            <a href="#" class="btn-sm btn-primary">DMC</a>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /. tab-5 end -->
        </div>
    </div>
    <!-- /. tab-content -->
</div>

@*  Location Code Set*@
<div class="modal fade" style=" -moz-border-radius:10px;" id="locatonCodeSetmdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width: 550px;margin-top:100px; -moz-border-radius::10px;">
            <div class="modal-header btn" style="background:#8CA1FB; color:#fff">
                <h4 class="modal-title modelTitle">Create Location Code Set</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCSetMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocSetId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtLocSetDescription" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button id="SaveLocationCodeSet" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*  Location Code*@
<div class="modal fade" style=" -moz-border-radius:10px;" id="locatonCodemdl" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width: 550px;margin-top:100px; -moz-border-radius::10px;">
            <div class="modal-header btn" style="background:#8CA1FB; color:#fff">
                <h4 class="modal-title modelTitle">Create Location Code</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorlOCMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code Set</label>
                                    @Html.DropDownList("LocationCodeSetDropDown", new SelectList(Model.LocationCodesSets, "Id","Description"), "Please Select", new { @class="form-control" })                            
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label>
                                    <input class="form-control 1charonly" maxlength="1" id="txtLocCode"> </input>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnlocId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <input class="form-control" id="txtLocDescription"> </input>
                                </div>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <button id="SaveLocationCode" class="btn btn-primary" value="Save">Save</button>
                            <button type="button" class="btn btn-default modelCancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* SNS *@
<div class="modal fade" style=" -moz-border-radius:10px;" id="snsModel" data-backdrop="true" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width: 550px;margin-top:100px; -moz-border-radius::10px;">
            <div class="modal-header btn" style="background:#8CA1FB; color:#fff">
                <h4 class="modal-title modelTitle">Create Standard Number System</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <label id="errorSnsMsg" style="color:red"></label>
                            <div class="col-md-12">
                                <input class="form-control" type="hidden" id="hdnSnsId" />
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Code</label><span style="color: red;">*</span>
                                    <input class="form-control" type="text" id="txtSnsCode" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Description</label>
                                    <textarea class="form-control" style="width:325px;height:75px;" id="txtSnsDescription"> </textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="example-text-input" class="form-label">Parent</label>
