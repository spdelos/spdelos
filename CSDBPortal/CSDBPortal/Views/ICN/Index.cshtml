
@{
    ViewData["Title"] = "ICN";
}
<style>
     .generate_button {
    width: 336px;
    background: #8CA1FB;
    color: #ffffff;
    font-size: 18px;
    line-height: 27px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    margin: auto;
}
</style>

 <div class="row">
            <!-- tab-content -->
            <div class="col-12">
              <ul class="nav nav-pills tab-header mb-3" id="pills-tab" role="tablist">
                <li class="nav-item item-one" role="presentation">
                  <a class="nav-link active" id="pills-tab-1" data-toggle="pill" href="#pills-1">
                    <img src="./dist/img/Icons/ICN/Generate ICN.png" alt="Generate icon">
                    <span class="ml-2">Generate ICN</span>
                  </a>
                </li>
                <li class="nav-item" role="presentation">
                  <a class="nav-link" id="pills-tab-2" data-toggle="pill" href="#pills-2">
                    <img src="./dist/img/Icons/ICN/View-ICN.png" alt="View icon">
                    <span class="ml-2"> View ICN </span></a>
                </li>
              </ul>
              <div class="tab-content" id="pills-tabContent">
                <!-- tab-1 start -->
                <div class="tab-pane fade show active" id="pills-1" role="tabpanel" aria-labelledby="pills-tab-1">
                  <div class="card shadow-sm" style="padding:20px;" >
                    <label for="select" class="input-title">Select Project </label>
                    <select class="form-select form-control" aria-label="Default select example" required  id="project_2">
                   
                    </select>
                    <form>
                      <div class="form-group pt-4">
                        <label for="number" class="input-title">Enter Number ICN to be Generated</label>
                        <input type="number" class="form-control" id="txtICNNumberFormat" required >
                      </div>
                      <button type="submit" class="btn generate_button btn-block mt-5 mb-2" id="btnGenerate">Generate</button>
                    </form>
                  </div>
                </div>
                <!-- /. tab-1 end -->

                <!-- tab-2 start -->
                <div class="tab-pane fade" id="pills-2" role="tabpanel" aria-labelledby="pills-tab-2">
                  <div class="card shadow-sm d-flex justify-content-center"  style="padding:20px;" >
                    <label for="select" class="input-title">Select Project </label>
                    <select class="form-select form-control" aria-label="Default select example" id="project_1">
                    </select>
                    <hr />
                     <div id="divViewICNNumber" style="display:none">
                  <div class="table-responsive table-striped">
                    <table class="table table-bordered" width="100%" id="viewICNNumberTable">
                      <thead class="thead">
                        <tr>
     
                          <th>Poject</th>
                          <th>ICN Number</th>
                        </tr>
                      </thead>
                      <tbody id="icnViewBody">
                      </tbody>
                    </table>
                  </div> 

                  </div>
                  </div>
                 
                </div>
                <!-- /. tab-2 end -->
              </div>

            </div>
            <!-- /. tab-content -->
          </div>
            @section Scripts {
		        <script type="text/javascript">
                $("#adminlink").removeClass("active");
                $("#configlink").removeClass("active");
                $("#mainlink").removeClass("active");
                $("#icnlink").addClass("active");
                var ICNNumberTable = $('#viewICNNumberTable').DataTable();
                 $(document).ready(function () {
                          $.ajax({
                            type: "GET",
                            url: "ICN/GetProjects",
                            dataType: "json",
                            success: function (result) {
                                var slelectObj = $('#project_1, #project_2');
                                slelectObj.append('<option selected>Please select your project</option>');
                                $.each(result, function (k, v) {                                             
                                  slelectObj.append('<option value="' + v.projecctId + '">' + v.name + '</option>');
                               });
                             }
                   });

                    $("#project_1").change(function () {
                          $('#divViewICNNumber').show();
                         var selectedVal = $(this).find("option:selected").val();
                                $.ajax({
                                type: "GET",
                                data: {projectId: selectedVal },
                                url: "ICN/ICNNumberByProjectId",
                                dataType: "json",
                                success: function (result) {
                                    debugger;
                                    $("#icnViewBody").html('');
                                     $('#viewICNNumberTable').DataTable().clear();
                                     var tr;
                                     for (var i = 0; i < result.length; i++) {                    
                                         tr = $("<tr style='background:#fff'><td>" + result[i].projectName + "</td><td>" + result[i].icnNumber1 + "</td></tr>");  
                                        ICNNumberTable.row.add(tr[0]).draw();
                                   }
                                 }
                              });
                         });
                     });

                      $("#btnGenerate").click(function () {
                           if ($('#project_2').val() == 'Please select your project') {
                                $('#project_2').css('border-color', 'red');
                                return false;
                            }
                            else {
                                $('#project_2').css('border-color', '');
                            }
                            if ($('#txtICNNumberFormat').val() == '') {
                                $('#txtICNNumberFormat').css('border-color', 'red');
                                return false;
                            }
                            else {
                                $('#txtICNNumberFormat').css('border-color', '');
                            }
                            var _icnFormat = {}
                            _icnFormat.ProjectId = $('#project_2').val();
                            _icnFormat.IcnNumber1 = $('#txtICNNumberFormat').val();
                              $.ajax({
                                  type: "POST",
                                  url: "ICN/CreateICNNumber",
                                  data: {icnNumber: _icnFormat },
                                  dataType: "json",
                                  success: function (data) {
                                      if(data == 'Duplicate'){
                                          $("#errorICNMsg").html("Duplicate Record.");
                                          $("#icnmdl").modal('show')
                                      }else{
                                        $("#icnmdl").modal('hide');
                                         location.reload();
                                      }
                                  }
                              }); 
                      });                     
                 </script>
            }