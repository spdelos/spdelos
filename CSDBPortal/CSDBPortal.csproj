<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-SampleApp-71F0AA13-072A-4DC5-A4EB-109056568244</UserSecretsId>
    <!-- NU1902: jquery.datatables declares jQuery 1.7.0 as NuGet dep, but actual jQuery served is 3.5.1 in wwwroot -->
    <!-- NU1701: Microsoft.Xml.XMLGen has no .NET 10 build but works at runtime -->
    <!-- CS0168: catch variables declared but unused (catch (Exception ex) pattern) -->
    <!-- CS0472: int never equals null int? - harmless always-true comparisons -->
    <NoWarn>$(NoWarn);NU1902;NU1701;CS0168;CS0472</NoWarn>
  </PropertyGroup>

  <!-- Apache FOP JARs, XSLT stylesheet, and admonishment images for PDF export -->
  <ItemGroup>
    <Content Include="Resources\Jars\**\*"   CopyToOutputDirectory="Always" />
    <Content Include="Resources\Print\**\*"  CopyToOutputDirectory="Always" />
    <Content Include="Resources\Images\**\*" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="jquery.datatables" Version="1.10.15" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageReference Include="Microsoft.Xml.XMLGen" Version="1.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
  </ItemGroup>

</Project>
